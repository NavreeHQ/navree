# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Generated by scripts/prebuild.ts on every dev, build and typecheck
/src/generated/
/public/data/
# The UI previews (content/ui/previews) and navree-ui's files they load
/public/ui-preview/

# The launch film and its poster, copied by scripts/media.ts from NAVREE_MEDIA_DIR
# (content/media.json lists them; the live site serves them from shared/media/)
/public/media/

# Generated by scripts/agent-files.ts on every dev and build: the docs as
# Markdown, llms.txt, llms-full.txt, the served agent skills and Navigator's
# docs bundle (public/v/<version>/docs.json)
/public/docs/
/public/skills/
/public/llms.txt
/public/llms-full.txt
/public/llms-full/
/public/v/

# Visual checks (scripts/screenshots.ts)
/screenshots/

# The daily check's logs and Lighthouse reports (scripts/site-daily.ts)
/report/
