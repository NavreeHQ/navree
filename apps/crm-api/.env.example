# Navree CRM API: local secrets and overrides. Copy to `.env` (git-ignored)
# in apps/crm-api. Every key maps onto config/app.toml with the APP_ prefix
# and `__` between levels: APP_DATABASE__URL -> database.url.

# The application key: encrypts secrets (2FA) and derives the JWT signing
# key. Without it, tokens stop working at every restart.
# Generate one with: cargo run -p crm-api -- key:generate
APP_KEY=

# A dedicated JWT secret (at least 32 bytes) instead of one derived from APP_KEY.
# APP_AUTH__JWT__SECRET=

# Database (default: SQLite in storage/crm.db).
# APP_DATABASE__URL=sqlite://storage/crm.db?mode=rwc

# HTTP listener.
# APP_HTTP__ADDR=127.0.0.1:8080

# Real mail delivery instead of the log, e.g. a local Mailpit.
# APP_MAIL__TRANSPORT=smtp://localhost:1025

# Signs private channel subscriptions (default: random per process).
# APP_REALTIME__SECRET=

# Protects GET /metrics with `Authorization: Bearer <token>`.
# APP_OBSERVE__METRICS_TOKEN=
