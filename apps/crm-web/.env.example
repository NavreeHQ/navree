# Navree CRM web. Copy to .env.local and adjust. Everything is optional.

# --- Server side (the BFF route handlers under src/app/api and src/app/broadcasting) ---
# Where the BFF forwards /api/* and /broadcasting/* (read at request time, no rebuild needed).
NAVREE_API_URL=http://127.0.0.1:8080
# Secure flag on the navree_at / navree_rt cookies. Default: on in production builds, off in dev.
# Set to 0 to serve a production build over plain http on a host other than localhost.
# NAVREE_COOKIE_SECURE=1
# Public origin(s) allowed to send non-GET requests when a proxy rewrites the Host header.
# APP_ORIGINS=https://crm.example.com
# How many reverse proxies in front of this server append the client address to X-Forwarded-For
# (default 0). The BFF never passes the browser's own X-Forwarded-For on; with N trusted proxies it sends
# Navree the address the outermost one saw, so crm-api can throttle logins and rate-limit per client. crm-api
# believes X-Forwarded-For only from peers in APP_HTTP__TRUSTED_PROXIES (default "127.0.0.1,::1", which covers
# a BFF on the same host); in production list this server's address there. Only set this when Next.js is
# reachable through those proxies alone.
# NAVREE_TRUSTED_PROXY_HOPS=1

# --- Browser (inlined at build time) ---
# 1 = serve the API from the in-browser MSW mock (demo data, no crm-api needed).
# Default (unset/0) talks to the real API through the BFF.
NEXT_PUBLIC_API_MOCKS=0
# Real-time (Pusher protocol served by crm-api; the socket connects to Navree directly).
# Set NEXT_PUBLIC_REALTIME=0 to turn the socket off.
NEXT_PUBLIC_REALTIME=1
NEXT_PUBLIC_PUSHER_KEY=navree-crm-key
NEXT_PUBLIC_WS_HOST=127.0.0.1
NEXT_PUBLIC_WS_PORT=8080
