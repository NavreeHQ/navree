# The system app against the e2e compose services on this machine
# (`e2e/run.sh up` or `docker compose -f e2e/docker/compose.yml --profile search --profile storage --profile nats up -d`).
# Copy to `.env` (git-ignored) in apps/system-app.
APP_KEY=base64:ZXZpZGVuY2UtYXBwLWtleS0zMi1ieXRlcy1sb25nISE=
APP_AUTH__JWT__SECRET=system-jwt-secret-at-least-32-bytes-long
APP_APP__URL=http://localhost:8080
APP_DATABASE__URL=postgres://navree:navree@127.0.0.1:47432/system
APP_REDIS__URL=redis://127.0.0.1:47379
APP_MAIL__TRANSPORT=smtp://127.0.0.1:47025
APP_SEARCH__URL=http://127.0.0.1:47700
APP_SEARCH__KEY=system-meili-master-key
APP_STORAGE__DISKS__S3__ENDPOINT=http://127.0.0.1:47900
APP_STORAGE__DISKS__S3__ACCESS_KEY=navree
APP_STORAGE__DISKS__S3__SECRET_KEY=navree-minio-secret
APP_REALTIME__SECRET=system-realtime-secret-32-bytes-long
APP_MICRO__URL=nats://127.0.0.1:47222
#
# config/app.toml names the compose services for the demo routes, the alert
# channels and the webhook endpoints. Outside the compose network, export
# these as environment variables (a `.env` file does not override app.toml):
#   APP_DEMO__MAIL_INFO_URL=http://127.0.0.1:47825/api/v1/info
#   APP_DEMO__SEARCH_HEALTH_URL=http://127.0.0.1:47700/health
#   APP_DEMO__SINK_BASE_URL=http://127.0.0.1:8080
#   APP_LIGHTHOUSE__ALERTS__WEBHOOK__URL=http://127.0.0.1:8080/api/demo/sink/alerts
#   APP_LIGHTHOUSE__ALERTS__SLACK__WEBHOOK_URL=http://127.0.0.1:8080/api/demo/sink/slack
