{
  "name": "crm-nuxt",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3102",
    "dev:mock": "cross-env NUXT_PUBLIC_API_MOCKS=1 nuxt dev --port 3102",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview --port 3102",
    "packages": "pnpm --dir ../../packages/js install && pnpm --dir ../../packages/js build",
    "postinstall": "node scripts/prepare.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "api": "node scripts/start-api.mjs",
    "api:fresh": "node scripts/start-api.mjs --fresh",
    "e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "gen:api": "navree openapi:client --input ./openapi.json --out app/lib/api"
  },
  "packageManager": "pnpm@11.25.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@casl/ability": "7.0.2",
    "@casl/vue": "3.0.1",
    "@lucide/vue": "1.61.0",
    "@navree/client": "link:../../packages/js/client",
    "@navree/nuxt": "link:../../packages/js/nuxt",
    "@pinia/nuxt": "1.0.3",
    "@tanstack/vue-query": "5.105.0",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "nuxt": "4.6.3",
    "pinia": "4.1.0",
    "pusher-js": "8.6.0",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "vee-validate": "4.15.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-sonner": "2.0.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource/monaspace-neon": "5.3.0",
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@vue/test-utils": "2.5.1",
    "cross-env": "10.1.0",
    "happy-dom": "21.0.4",
    "msw": "2.15.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
