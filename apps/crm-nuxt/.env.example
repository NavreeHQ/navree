# Navree CRM on Nuxt: every setting, with its default. Copy to .env to change one.
# Server-side settings are read when the server starts; NUXT_PUBLIC_* ones override the
# public runtime config at runtime too (no rebuild needed).

# ---- The BFF (the @navree/nuxt module, Nitro, server only) ----
# Where the BFF forwards /api/* and /broadcasting/auth (NUXT_NAVREE_API_URL works too).
NAVREE_API_URL=http://127.0.0.1:8092
# The Secure flag on the token cookies. Default: on in production builds, off in dev.
# Set 0 to serve a production build over plain http (local E2E runs do).
# NAVREE_COOKIE_SECURE=0
# Extra origins allowed to send non-GET requests (the public URL when a proxy rewrites Host).
# APP_ORIGINS=https://crm.example.com
# Reverse proxies in front of Nuxt that append the client to X-Forwarded-For (0: never trust it).
# NAVREE_TRUSTED_PROXY_HOPS=1

# ---- The browser (public runtime config) ----
# 1 serves the API from MSW in the browser: demo data, no crm-api needed. Read when Nuxt starts
# (use `pnpm dev:mock`): it also turns off the session gate and the socket, which need a server session.
NUXT_PUBLIC_API_MOCKS=0
# false turns the WebSocket off (lists still refetch on focus).
# NUXT_PUBLIC_NAVREE_REALTIME=false
# The API's Pusher-protocol WebSocket listener, and its realtime.key.
NUXT_PUBLIC_NAVREE_REALTIME_KEY=navree-crm-key
NUXT_PUBLIC_NAVREE_REALTIME_WS_HOST=127.0.0.1
NUXT_PUBLIC_NAVREE_REALTIME_WS_PORT=8092
# 1 lists the crm-demo accounts on the login page (always on with the mock API).
NUXT_PUBLIC_DEMO_ACCOUNTS=0
