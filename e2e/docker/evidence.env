# The evidence app's settings inside the compose network (service names as
# hosts). compose.yml adds APP_KEY, the JWT secret and the database URL.
APP_APP__URL=http://web:8080
APP_REDIS__URL=redis://redis:6379
APP_MAIL__TRANSPORT=smtp://mailpit:1025
APP_SEARCH__URL=http://meilisearch:7700
APP_SEARCH__KEY=evidence-meili-master-key
APP_STORAGE__DISKS__S3__ENDPOINT=http://minio:9000
APP_STORAGE__DISKS__S3__ACCESS_KEY=navree
APP_STORAGE__DISKS__S3__SECRET_KEY=navree-minio-secret
APP_REALTIME__SECRET=evidence-realtime-secret-32-bytes-long
APP_MICRO__URL=nats://nats:4222
APP_UI__GALLERY=true
APP_GRAPHQL__GRAPHIQL=true
