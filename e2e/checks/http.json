  { "name": "lighthouse sign-in page", "package": "navree-lighthouse", "method": "GET", "path": "/_lighthouse", "headers": { "Accept": "text/html" }, "expect": [200, 302, 303] },
  { "name": "fleet page", "package": "navree-fleet", "method": "GET", "path": "/_fleet", "expect": 200 },
