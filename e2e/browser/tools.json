      "scope": [
        "/graphql"
      ],
      "roots": [
        "/graphql"
      ],
      "variants": [],
      "settle_ms": 2500,
      "max_pages": 3,
      "states": [],
      "custom": [
        "graphiql-run"
      ]
    },
    {
      "name": "graphiql-dev",
      "title": "GraphiQL (introspection on)",
      "package": "navree-graphql",
      "service": "web-dev",
      "scope": [
        "/graphql"
      ],
      "roots": [
        "/graphql"
      ],
      "variants": [],
      "settle_ms": 2500,
      "max_pages": 3,
      "states": [],
      "custom": [
        "graphiql-run"
      ]
    },
    {
      "name": "ui-gallery",
      "title": "Component gallery",
      "package": "navree-ui",
      "service": "web",
      "scope": [
        "/_navree/ui/gallery"
      ],
      "roots": [
        "/_navree/ui/gallery"
      ],
      "variants": [
        "/_navree/ui/gallery/dashboard",
        "/_navree/ui/gallery/sign-in"
      ],
      "avoid": [
        "[?&](sort|page)="
      ],
      "max_pages": 6,
      "states": [],
      "custom": [],
      "sign_in_pages": [
        "/gallery/sign-in"
      ]
    },
    {
      "name": "oauth",
      "title": "OAuth authorize error page",
      "package": "navree-oauth",
      "service": "web",
      "scope": [
        "/oauth"
      ],
      "roots": [
        "/oauth/authorize?client_id=unknown&response_type=code&redirect_uri=https%3A%2F%2Fexample.test%2Fcb"
      ],
      "expect_status": 400,
      "max_pages": 1,
      "states": [],
      "custom": []
