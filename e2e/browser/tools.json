    {
      "name": "mailpit",
      "title": "Mailpit (the mail catcher the app sends through)",
      "package": "navree-mail",
      "service": "mailpit",
      "scope": [
        "/"
      ],
      "roots": [
        "/"
      ],
      "variants": [],
      "avoid": [
        "/api/",
        "/view/",
        "/dist/"
      ],
      "per_template": 2,
      "max_pages": 6,
      "states": [],
