  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Repository.cs" Link="Repository.cs" />
    <Compile Include="..\Shared\Expect.cs" Link="Expect.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="Navree.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestCulture.cs" Link="TestCulture.cs" />
  </ItemGroup>

