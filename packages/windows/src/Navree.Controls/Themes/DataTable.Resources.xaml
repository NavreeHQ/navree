            <SolidColorBrush x:Key="DataTableHeaderBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DataTableHeaderBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DataTableHeaderForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="DataTableHeaderForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DataTableHeaderForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DataTableDivider" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DataTableFrozenEdge" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DataTableBorder" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DataTableResizeLine" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DataTableDropMark" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DataTableSelectionPill" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DataTableCheckBoxBorder" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="DataTableCheckBoxFill" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="DataTableCheckBoxFillChecked" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DataTableCheckBoxGlyph" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DataTableDetailBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DataTableBulkBarBackground" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
