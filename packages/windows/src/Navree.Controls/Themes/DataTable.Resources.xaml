            <SolidColorBrush x:Key="DataTableCheckBoxFill" Color="{StaticResource ControlAltFillColorSecondary}" />
            <SolidColorBrush x:Key="DataTableCheckBoxFillChecked" Color="{StaticResource AccentFillColorDefault}" />
            <SolidColorBrush x:Key="DataTableCheckBoxGlyph" Color="{StaticResource TextOnAccentFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableDetailBackground" Color="{StaticResource CardBackgroundFillColorSecondary}" />
            <SolidColorBrush x:Key="DataTableBulkBarBackground" Color="{StaticResource CardBackgroundFillColorDefault}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="DataTableRowBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DataTableRowForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="DataTableRowForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DataTableRowForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DataTableRowForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DataTableRowForegroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DataTableRowForegroundSelectedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DataTableRowForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
