<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The brushes of the table, each an alias of a colour the framework defines, in the three
         theme dictionaries the framework asks for. Nothing in the table is a colour of its own. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DataTableRowBackground" Color="{StaticResource SubtleFillColorTransparent}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundPointerOver" Color="{StaticResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundPressed" Color="{StaticResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundSelected" Color="{StaticResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundSelectedPointerOver" Color="{StaticResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundSelectedPressed" Color="{StaticResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="DataTableRowForeground" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableRowForegroundPointerOver" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableRowForegroundPressed" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableRowForegroundSelected" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableRowForegroundSelectedPointerOver" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableRowForegroundSelectedPressed" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableRowForegroundDisabled" Color="{StaticResource TextFillColorDisabled}" />
            <SolidColorBrush x:Key="DataTableSecondaryForeground" Color="{StaticResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="DataTableHeaderBackground" Color="{StaticResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="DataTableHeaderBackgroundPointerOver" Color="{StaticResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="DataTableHeaderBackgroundPressed" Color="{StaticResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="DataTableHeaderForeground" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableHeaderForegroundPointerOver" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableHeaderForegroundPressed" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableDivider" Color="{StaticResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="DataTableFrozenEdge" Color="{StaticResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="DataTableBorder" Color="{StaticResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="DataTableResizeLine" Color="{StaticResource ControlStrongStrokeColorDefault}" />
            <SolidColorBrush x:Key="DataTableDropMark" Color="{StaticResource AccentFillColorDefault}" />
            <SolidColorBrush x:Key="DataTableSelectionPill" Color="{StaticResource AccentFillColorDefault}" />
            <SolidColorBrush x:Key="DataTableCheckBoxBorder" Color="{StaticResource ControlStrongStrokeColorDefault}" />
            <SolidColorBrush x:Key="DataTableCheckBoxFill" Color="{StaticResource ControlAltFillColorSecondary}" />
            <SolidColorBrush x:Key="DataTableCheckBoxFillChecked" Color="{StaticResource AccentFillColorDefault}" />
            <SolidColorBrush x:Key="DataTableCheckBoxGlyph" Color="{StaticResource TextOnAccentFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableDetailBackground" Color="{StaticResource CardBackgroundFillColorSecondary}" />
            <SolidColorBrush x:Key="DataTableBulkBarBackground" Color="{StaticResource CardBackgroundFillColorDefault}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="DataTableRowBackground" Color="{StaticResource SubtleFillColorTransparent}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundPointerOver" Color="{StaticResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundPressed" Color="{StaticResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundSelected" Color="{StaticResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundSelectedPointerOver" Color="{StaticResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="DataTableRowBackgroundSelectedPressed" Color="{StaticResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="DataTableRowForeground" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableRowForegroundPointerOver" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableRowForegroundPressed" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableRowForegroundSelected" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableRowForegroundSelectedPointerOver" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableRowForegroundSelectedPressed" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableRowForegroundDisabled" Color="{StaticResource TextFillColorDisabled}" />
            <SolidColorBrush x:Key="DataTableSecondaryForeground" Color="{StaticResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="DataTableHeaderBackground" Color="{StaticResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="DataTableHeaderBackgroundPointerOver" Color="{StaticResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="DataTableHeaderBackgroundPressed" Color="{StaticResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="DataTableHeaderForeground" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="DataTableHeaderForegroundPointerOver" Color="{StaticResource TextFillColorPrimary}" />
