<Project Sdk="Microsoft.NET.Sdk">

  <!-- The gallery of the controls. The project is here so the solution holds it. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Navree.Gallery</RootNamespace>
    <AssemblyName>Navree.Gallery</AssemblyName>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Navree.Controls\Navree.Controls.csproj" />
  </ItemGroup>

</Project>
