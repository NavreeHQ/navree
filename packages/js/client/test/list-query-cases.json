{
  "about": "The list-query grammar as both parsers must read it. Each case gives a query string (no leading ?), the canonical query string the parsed query writes back (the parameters a list query owns, in the order filter, sort, search, page, per_page, cursor, before, limit; encoded the way URLSearchParams does), and the parameters the parser reports as problems. The Rust parser (navree_http::list) and the JavaScript parser (@navree/client) read this one file, so they cannot drift.",
  "cases": [
    { "name": "a plain filter is equality", "input": "filter[status]=active", "canonical": "filter%5Bstatus%5D=active", "problems": [] },
    { "name": "an explicit eq is the same as a plain filter", "input": "filter[status][eq]=active", "canonical": "filter%5Bstatus%5D=active", "problems": [] },
    { "name": "an operator", "input": "filter[created_at][gte]=2026-10-01", "canonical": "filter%5Bcreated_at%5D%5Bgte%5D=2026-10-01", "problems": [] },
    { "name": "two operators on one field stay together", "input": "filter[amount][gte]=100&filter[stage]=won&filter[amount][lte]=900", "canonical": "filter%5Bamount%5D%5Bgte%5D=100&filter%5Bamount%5D%5Blte%5D=900&filter%5Bstage%5D=won", "problems": [] },
    { "name": "every operator", "input": "filter[a][ne]=1&filter[b][gt]=2&filter[c][lt]=3&filter[d][lte]=4&filter[e][contains]=x&filter[f][starts_with]=y&filter[g][not_in]=1,2", "canonical": "filter%5Ba%5D%5Bne%5D=1&filter%5Bb%5D%5Bgt%5D=2&filter%5Bc%5D%5Blt%5D=3&filter%5Bd%5D%5Blte%5D=4&filter%5Be%5D%5Bcontains%5D=x&filter%5Bf%5D%5Bstarts_with%5D=y&filter%5Bg%5D%5Bnot_in%5D=1%2C2", "problems": [] },
    { "name": "in takes a comma list", "input": "filter[stage][in]=lead,won", "canonical": "filter%5Bstage%5D%5Bin%5D=lead%2Cwon", "problems": [] },
    { "name": "in adds up across repeated keys", "input": "filter[stage][in]=lead&filter[stage][in]=won,lost", "canonical": "filter%5Bstage%5D%5Bin%5D=lead%2Cwon%2Clost", "problems": [] },
    { "name": "in drops empty parts", "input": "filter[stage][in]=a,,b,", "canonical": "filter%5Bstage%5D%5Bin%5D=a%2Cb", "problems": [] },
    { "name": "null true", "input": "filter[owner_id][null]=true", "canonical": "filter%5Bowner_id%5D%5Bnull%5D=true", "problems": [] },
    { "name": "null 1 is true", "input": "filter[owner_id][null]=1", "canonical": "filter%5Bowner_id%5D%5Bnull%5D=true", "problems": [] },
    { "name": "null 0 is false", "input": "filter[owner_id][null]=0", "canonical": "filter%5Bowner_id%5D%5Bnull%5D=false", "problems": [] },
    { "name": "null false", "input": "filter[owner_id][null]=false", "canonical": "filter%5Bowner_id%5D%5Bnull%5D=false", "problems": [] },
    { "name": "null with another word is a problem", "input": "filter[owner_id][null]=maybe", "canonical": "", "problems": ["filter[owner_id][null]"] },
    { "name": "percent-encoded brackets read the same", "input": "filter%5Bstatus%5D=active&filter%5Bstage%5D%5Bin%5D=a%2Cb", "canonical": "filter%5Bstatus%5D=active&filter%5Bstage%5D%5Bin%5D=a%2Cb", "problems": [] },
    { "name": "a comma in an equality value stays", "input": "filter[name]=a%2Cb", "canonical": "filter%5Bname%5D=a%2Cb", "problems": [] },
    { "name": "empty values are left out", "input": "filter[a]=&search=&sort=&page=&cursor=", "canonical": "", "problems": [] },
    { "name": "sort", "input": "sort=-created_at,name", "canonical": "sort=-created_at%2Cname", "problems": [] },
    { "name": "a field sorted twice keeps the first", "input": "sort=name,-name", "canonical": "sort=name", "problems": ["sort"] },
    { "name": "more than four sort fields keep four", "input": "sort=a,b,c,d,e", "canonical": "sort=a%2Cb%2Cc%2Cd", "problems": ["sort"] },
    { "name": "a bare minus is not a sort field", "input": "sort=-", "canonical": "", "problems": ["sort"] },
    { "name": "a sort field with a space is a problem", "input": "sort=a%20b,c", "canonical": "sort=c", "problems": ["sort"] },
    { "name": "a sort field with a semicolon is a problem", "input": "sort=a;b", "canonical": "", "problems": ["sort"] },
    { "name": "search", "input": "search=agra+corp", "canonical": "search=agra+corp", "problems": [] },
    { "name": "search is trimmed", "input": "search=%20%20agra%20", "canonical": "search=agra", "problems": [] },
    { "name": "a blank search is left out", "input": "search=%20%20", "canonical": "", "problems": [] },
    { "name": "search in Gurmukhi", "input": "search=%E0%A8%AA%E0%A9%B0%E0%A8%9C%E0%A8%BE%E0%A8%AC", "canonical": "search=%E0%A8%AA%E0%A9%B0%E0%A8%9C%E0%A8%BE%E0%A8%AC", "problems": [] },
    { "name": "bytes that are not UTF-8 become the replacement character", "input": "search=%FF", "canonical": "search=%EF%BF%BD", "problems": [] },
    { "name": "numbered pages", "input": "page=2&per_page=25", "canonical": "page=2&per_page=25", "problems": [] },
    { "name": "page zero is a problem", "input": "page=0", "canonical": "", "problems": ["page"] },
    { "name": "page must be digits", "input": "page=abc&per_page=-5", "canonical": "", "problems": ["page", "per_page"] },
    { "name": "page with a sign or a fraction is a problem", "input": "page=%2B2&per_page=2.5", "canonical": "", "problems": ["page", "per_page"] },
    { "name": "page past the largest is a problem", "input": "page=99999999999999999999", "canonical": "", "problems": ["page"] },
    { "name": "per_page zero is a problem", "input": "per_page=0", "canonical": "", "problems": ["per_page"] },
    { "name": "per_page past the largest is a problem", "input": "per_page=10001", "canonical": "", "problems": ["per_page"] },
    { "name": "cursor pages", "input": "cursor=eyJpZCI6NDJ9&limit=50", "canonical": "cursor=eyJpZCI6NDJ9&limit=50", "problems": [] },
    { "name": "before is the page before a cursor", "input": "before=eyJpZCI6NDJ9", "canonical": "before=eyJpZCI6NDJ9", "problems": [] },
    { "name": "limit zero is a problem", "input": "limit=0", "canonical": "", "problems": ["limit"] },
    { "name": "page and cursor together is a problem", "input": "page=2&cursor=abc", "canonical": "page=2&cursor=abc", "problems": ["cursor"] },
    { "name": "per_page and limit together is a problem", "input": "per_page=10&limit=10", "canonical": "per_page=10&limit=10", "problems": ["limit"] },
    { "name": "other parameters are not the list query's", "input": "owner_id=3&range=30d&filter[a]=1&x[y]=z", "canonical": "filter%5Ba%5D=1", "problems": [] },
    { "name": "an empty filter name is a problem", "input": "filter[]=x", "canonical": "", "problems": ["filter[]"] },
    { "name": "an unclosed filter name is a problem", "input": "filter[a=1", "canonical": "", "problems": ["filter[a"] },
    { "name": "a filter nested two deep is a problem", "input": "filter[a][b][c]=1", "canonical": "", "problems": ["filter[a][b][c]"] },
    { "name": "an empty operator is a problem", "input": "filter[a][]=1", "canonical": "", "problems": ["filter[a][]"] },
    { "name": "a stray bracket is a problem", "input": "filter[a]]=1", "canonical": "", "problems": ["filter[a]]"] },
    { "name": "a bare filter is a problem", "input": "filter=1", "canonical": "", "problems": ["filter"] },
    { "name": "an unknown operator is a problem", "input": "filter[a][regex]=x", "canonical": "", "problems": ["filter[a][regex]"] },
    { "name": "an operator in capitals is a problem", "input": "filter[a][GTE]=1", "canonical": "", "problems": ["filter[a][GTE]"] },
    { "name": "a repeated operator keeps the first", "input": "filter[a][gte]=1&filter[a][gte]=2", "canonical": "filter%5Ba%5D%5Bgte%5D=1", "problems": ["filter[a][gte]"] },
    { "name": "a repeated plain filter keeps the first", "input": "filter[a]=1&filter[a]=2", "canonical": "filter%5Ba%5D=1", "problems": ["filter[a]"] },
    { "name": "a field name with a dot", "input": "filter[company.name][contains]=x", "canonical": "filter%5Bcompany.name%5D%5Bcontains%5D=x", "problems": [] },
    { "name": "a field name with a space is a problem", "input": "filter[a%20b]=x", "canonical": "", "problems": ["filter[a b]"] },
    { "name": "a field name with a hyphen is a problem", "input": "filter[a-b]=x", "canonical": "", "problems": ["filter[a-b]"] },
    { "name": "a field name that starts with a digit is a problem", "input": "filter[1a]=x", "canonical": "", "problems": ["filter[1a]"] },
    { "name": "a field name of 64 characters", "input": "filter[aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa]=x", "canonical": "filter%5Baaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa%5D=x", "problems": [] },
    { "name": "a field name of 65 characters is a problem", "input": "filter[aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa]=x", "canonical": "", "problems": ["filter[aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa]"] },
    { "name": "a field named __proto__ is only a name", "input": "filter[__proto__]=x", "canonical": "filter%5B__proto__%5D=x", "problems": [] },
    { "name": "a field named constructor is only a name", "input": "filter[constructor][in]=a,b", "canonical": "filter%5Bconstructor%5D%5Bin%5D=a%2Cb", "problems": [] },
    { "name": "a field named toString is only a name", "input": "filter[toString]=x&filter[hasOwnProperty][null]=true", "canonical": "filter%5BtoString%5D=x&filter%5BhasOwnProperty%5D%5Bnull%5D=true", "problems": [] },
    { "name": "sort by __proto__ is only a name", "input": "sort=__proto__,-constructor", "canonical": "sort=__proto__%2C-constructor", "problems": [] },
    { "name": "a NUL byte in a value is a problem", "input": "filter[a]=x%00y", "canonical": "", "problems": ["filter[a]"] },
    { "name": "a NUL byte in a search is a problem", "input": "search=x%00y", "canonical": "", "problems": ["search"] },
    { "name": "a NUL byte in a cursor is a problem", "input": "cursor=x%00y", "canonical": "", "problems": ["cursor"] }
  ]
}
