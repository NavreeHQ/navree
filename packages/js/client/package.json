{
  "name": "@navree/client",
  "version": "1.0.0",
  "description": "A typed client for Navree APIs: openapi-fetch on the app's OpenAPI document, Navree's error shape with codes, list queries, pagination, operations and real time.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./abilities": {
      "types": "./dist/abilities.d.ts",
      "import": "./dist/abilities.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "peerDependencies": {
    "@casl/ability": "^6.0.0 || ^7.0.0",
    "pusher-js": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@casl/ability": {
      "optional": true
    },
    "pusher-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@casl/ability": "7.0.2",
    "@types/node": "^24.19.2",
    "openapi-typescript": "7.13.0",
    "pusher-js": "8.6.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
