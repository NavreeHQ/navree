{
  "name": "@navree/nuxt",
  "version": "0.1.0",
  "description": "Nuxt on a Navree API: a module with the backend-for-frontend as Nitro routes (httpOnly token cookies, refresh rotation, CSRF, channel authorization), a session gate, and composables for auth, workspaces, abilities, real-time channels, operations, list queries and a DataTable.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./abilities": {
      "types": "./dist/vue/abilities.d.ts",
      "import": "./dist/vue/abilities.js"
    },
    "./realtime": {
      "types": "./dist/vue/realtime.d.ts",
      "import": "./dist/vue/realtime.js"
    },
    "./server": {
      "types": "./dist/server/handlers.d.ts",
      "import": "./dist/server/handlers.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@navree/bff": "workspace:*",
    "@navree/client": "workspace:*",
    "@nuxt/kit": "^4.6.2",
    "@nuxt/schema": "^4.6.2",
    "@tanstack/vue-table": "^8.21.3",
    "defu": "^6.1.7",
    "h3": "^1.15.11"
  },
  "peerDependencies": {
    "@casl/ability": "^6.0.0 || ^7.0.0",
    "@casl/vue": "^2.2.0 || ^3.0.0",
    "nuxt": "^3.13.0 || ^4.0.0",
    "pusher-js": "^8.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@casl/ability": {
      "optional": true
    },
    "@casl/vue": {
      "optional": true
    },
    "pusher-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@casl/ability": "7.0.2",
    "@casl/vue": "3.0.1",
    "@types/node": "^24.19.2",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.4",
    "pusher-js": "8.6.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  }
}
