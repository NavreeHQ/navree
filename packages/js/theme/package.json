{
  "name": "@navree/theme",
  "version": "0.1.0",
  "description": "navree.com's dark theme: Tailwind CSS 4 tokens, shadcn/ui and shadcn-vue colors, self-hosted fonts, and the tokens as data.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "css",
    "registry",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": {
      "style": "./css/theme.css",
      "default": "./css/theme.css"
    },
    "./tokens.css": {
      "style": "./css/tokens.css",
      "default": "./css/tokens.css"
    },
    "./fonts.css": {
      "style": "./css/fonts.css",
      "default": "./css/fonts.css"
    },
    "./registry/navree.json": "./registry/navree.json",
    "./package.json": "./package.json"
  },
  "style": "./css/theme.css",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource/monaspace-neon": "^5.3.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@types/node": "^24.19.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
