{
  "name": "@navree/next",
  "version": "1.0.2",
  "description": "Next.js on a Navree API: the backend-for-frontend route handlers, auth() for server components, the proxy (middleware), abilities, real-time channels, operations, a DataTable driven by list queries, and locale helpers.",
  "license": "MIT OR Apache-2.0",
  "author": "Amritpal Singh",
  "homepage": "https://navree.com/docs/frontend/nextjs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NavreeHQ/navree.git",
    "directory": "packages/js/next"
  },
  "bugs": {
    "url": "https://github.com/NavreeHQ/navree/issues"
  },
  "keywords": [
    "navree",
    "nextjs",
    "app-router",
    "auth",
    "data-table"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./abilities": {
      "types": "./dist/client/abilities.d.ts",
      "import": "./dist/client/abilities.js"
    },
    "./realtime": {
      "types": "./dist/client/realtime.d.ts",
      "import": "./dist/client/realtime.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@navree/bff": "workspace:*",
    "@navree/client": "workspace:*",
    "@tanstack/react-table": "^9.3.1"
  },
  "peerDependencies": {
    "@casl/ability": "^6.0.0 || ^7.0.0",
    "@casl/react": "^7.0.0",
    "next": ">=15.0.0",
    "pusher-js": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@casl/ability": {
      "optional": true
    },
    "@casl/react": {
      "optional": true
    },
    "pusher-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@casl/ability": "7.1.1",
    "@casl/react": "7.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "30.1.3",
    "next": "16.4.5",
    "pusher-js": "8.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
