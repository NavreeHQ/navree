    <!-- The app's Firebase project. An app sets these in its own res/values; empty means no push. -->
    <string name="navree_fcm_project_id" translatable="false"></string>
    <string name="navree_fcm_application_id" translatable="false"></string>
    <string name="navree_fcm_api_key" translatable="false"></string>
    <string name="navree_fcm_sender_id" translatable="false"></string>
