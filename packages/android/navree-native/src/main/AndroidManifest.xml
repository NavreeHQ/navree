<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <!-- Links that leave the app's origin open in the user's browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- The browser that opens sign-in sessions, asked what it supports. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!-- What the client keeps for a person stays out of backups and transfers to a new device.
         An app that says nothing has these rules; one with rules of its own adds their lines. -->
    <application
        android:dataExtractionRules="@xml/navree_data_extraction_rules"
        android:fullBackupContent="@xml/navree_backup_rules" />

</manifest>
