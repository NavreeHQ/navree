{
  "navree": 1,
  "build": "3f9a1c07b2de",
  "vocab": 1,
  "screen": {
    "id": "sign-in",
    "title": "Sign in",
    "body": {
      "t": "stack",
      "gap": 6,
      "align": "stretch",
      "children": [
        {
          "t": "text",
          "value": "Sandhu Stores",
          "style": "large_title"
        },
        {
          "t": "text",
          "value": "Sign in to manage your orders.",
          "style": "body"
        },
        {
          "t": "form",
          "id": "sign-in-form",
          "method": "post",
          "action": "/sign-in",
          "hidden": [
            {
              "name": "_token",
              "value": "k3J9sQ"
            }
          ],
          "children": [
            {
              "t": "field",
              "name": "email",
              "label": "Email",
              "required": true,
              "input": {
                "t": "text",
                "kind": "email",
                "autofill": "username"
              }
            },
            {
              "t": "field",
              "name": "password",
              "label": "Password",
              "required": true,
              "input": {
                "t": "text",
                "kind": "password",
                "autofill": "current-password"
              }
            },
            {
              "t": "field",
              "name": "remember",
              "label": "Keep me signed in",
              "input": {
                "t": "toggle",
                "kind": "checkbox",
                "on": true,
                "value": "1"
              }
            },
            {
              "t": "button",
              "label": "Sign in",
              "role": "primary",
              "action": {
                "t": "submit"
              }
            }
          ]
        },
        {
          "t": "link",
          "label": "Forgot your password?",
          "action": {
            "t": "navigate",
            "href": "/forgot-password"
          }
        }
      ]
    }
  }
}
