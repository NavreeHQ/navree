{
  "navree": 1,
  "build": "3f9a1c07b2de",
  "vocab": 1,
  "screen": {
    "id": "order-edit",
    "title": "Edit order",
    "back": {
      "title": "Order #1042",
      "href": "/orders/1042"
    },
    "body": {
      "t": "form",
      "id": "order-form",
      "method": "post",
      "action": "/orders/1042",
      "hidden": [
        {
          "name": "_token",
          "value": "k3J9sQ"
        },
        {
          "name": "_method",
          "value": "patch"
        }
      ],
      "children": [
        {
          "t": "section",
          "children": [
            {
              "t": "field",
              "id": "order-name",
              "name": "name",
              "label": "Full name",
              "required": true,
              "input": {
                "t": "text",
                "kind": "plain",
                "value": "Harpreet Kaur",
                "autofill": "name",
                "max_length": 80
              }
            },
            {
              "t": "field",
              "name": "phone",
              "label": "Mobile number",
              "required": true,
              "help": "Ten digits, without the country code",
              "error": "Enter a 10-digit mobile number",
              "input": {
                "t": "text",
                "kind": "phone",
                "value": "98140 1234",
                "autofill": "tel-national"
              }
            },
            {
              "t": "field",
              "name": "email",
              "label": "Email",
              "input": {
                "t": "text",
                "kind": "email",
                "value": "harpreet.kaur@example.in",
                "autofill": "email"
              }
            }
          ],
          "title": "Customer"
        },
        {
          "t": "section",
          "children": [
            {
              "t": "field",
              "name": "address",
              "label": "Address",
              "required": true,
              "input": {
                "t": "text",
                "kind": "multiline",
                "value": "House 214, Sarabha Nagar",
                "autofill": "street-address"
              }
            },
            {
              "t": "field",
              "name": "city",
              "label": "City",
              "required": true,
              "input": {
                "t": "choice",
                "kind": "menu",
                "value": "ludhiana",
                "options": [
                  {
                    "value": "ludhiana",
                    "label": "Ludhiana"
                  },
                  {
                    "value": "amritsar",
                    "label": "Amritsar"
                  },
                  {
                    "value": "chandigarh",
                    "label": "Chandigarh"
                  },
                  {
                    "value": "jalandhar",
                    "label": "Jalandhar"
                  },
                  {
                    "value": "patiala",
                    "label": "Patiala"
                  },
                  {
                    "value": "delhi",
                    "label": "Delhi"
                  },
                  {
                    "value": "jaipur",
                    "label": "Jaipur"
                  }
                ]
              }
            },
            {
              "t": "field",
              "name": "deliver_on",
              "label": "Deliver on",
              "input": {
                "t": "date",
                "kind": "date",
                "value": "2026-11-14",
                "min": "2026-11-12",
                "max": "2026-12-31"
              }
            },
            {
              "t": "field",
              "name": "deliver_at",
              "label": "Not before",
              "help": "Indian Standard Time",
              "input": {
                "t": "date",
                "kind": "time",
                "value": "10:30"
              }
            }
          ],
          "title": "Delivery"
        },
        {
          "t": "section",
          "children": [
            {
              "t": "field",
              "name": "payment",
              "label": "Paid by",
              "input": {
                "t": "choice",
                "kind": "segmented",
                "value": "upi",
                "options": [
                  {
                    "value": "upi",
                    "label": "UPI"
                  },
                  {
                    "value": "card",
                    "label": "Card"
                  },
                  {
                    "value": "cod",
                    "label": "Cash"
                  }
                ]
              }
            },
            {
              "t": "field",
              "name": "quantity",
              "label": "Boxes",
              "input": {
                "t": "text",
                "kind": "number",
                "value": "2",
                "min": "1",
                "max": "12",
                "step": "1"
              }
            },
            {
              "t": "field",
              "name": "discount",
              "label": "Discount",
              "help": "Percent off the order total",
              "input": {
                "t": "slider",
                "min": "0",
                "max": "30",
                "step": "5",
                "value": "10"
              }
            },
            {
              "t": "field",
              "name": "gift",
              "label": "Gift wrap",
              "help": "Adds ₹99 to the order",
              "input": {
                "t": "toggle",
                "kind": "switch",
                "on": true,
                "value": "1"
              }
            },
            {
              "t": "field",
              "name": "invoice",
              "label": "Email the GST invoice",
              "input": {
                "t": "toggle",
                "kind": "checkbox",
                "on": false,
                "value": "1"
              }
            }
          ],
          "title": "Payment"
        },
        {
          "t": "section",
          "children": [
            {
              "t": "field",
              "name": "notes",
              "label": "Notes for the courier",
              "input": {
                "t": "text",
                "kind": "multiline",
                "placeholder": "Landmark, gate code, a good time to call",
                "max_length": 280
              }
            }
          ],
          "title": "Notes"
        },
        {
          "t": "button",
          "label": "Save",
          "role": "primary",
          "action": {
            "t": "submit"
          }
        }
      ]
    }
  }
}
