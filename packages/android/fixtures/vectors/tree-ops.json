          {
            "t": "row",
            "id": "o2",
            "title": "Second"
          }
        ]
      }
    },
    "ops": [
      {
        "op": "append",
        "target": "orders",
        "nodes": [
          {
            "t": "row",
            "id": "o3",
            "title": "Third"
          },
          {
            "t": "row",
            "id": "o4",
            "title": "Fourth"
          }
        ],
        "more": "/orders?after=4"
      }
    ],
    "after": {
      "title": "Orders",
      "body": {
        "t": "list",
        "id": "orders",
        "more": "/orders?after=4",
        "children": [
          {
            "t": "row",
            "id": "o1",
            "title": "First"
          },
          {
            "t": "row",
            "id": "o2",
            "title": "Second"
          },
          {
            "t": "row",
            "id": "o3",
            "title": "Third"
          },
          {
            "t": "row",
            "id": "o4",
            "title": "Fourth"
          }
        ]
      }
    }
  },
