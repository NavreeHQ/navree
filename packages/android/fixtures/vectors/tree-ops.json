  {
    "name": "an op whose target is not in the tree changes nothing",
    "before": {
      "title": "Order",
      "body": {
        "t": "text",
        "id": "a",
        "value": "Same"
      }
    },
    "ops": [
      {
        "op": "morph",
        "target": "missing",
        "node": {
          "t": "text",
          "value": "Never shown"
        }
      },
      {
        "op": "remove",
        "target": "missing"
      },
      {
        "op": "append",
        "target": "a",
        "nodes": [
          {
            "t": "text",
            "value": "A text has no children"
          }
        ]
      }
    ],
    "after": {
      "title": "Order",
      "body": {
        "t": "text",
        "id": "a",
        "value": "Same"
      }
    }
  },
  {
    "name": "ops that are not about the tree leave it alone",
    "before": {
      "title": "Order",
      "body": {
        "t": "text",
        "id": "a",
        "value": "Same"
      }
    },
    "ops": [
      {
        "op": "toast",
        "tone": "success",
        "text": "Saved"
      },
      {
        "op": "open",
        "target": "a"
      },
      {
        "op": "focus",
        "target": "a"
      },
      {
        "op": "url",
        "href": "/orders/2",
        "mode": "replace"
      },
      {
        "op": "errors",
        "form": "f",
        "fields": {
          "name": [
            "Required"
          ]
        }
      }
    ],
    "after": {
      "title": "Order",
      "body": {
        "t": "text",
        "id": "a",
        "value": "Same"
      }
    }
  }
