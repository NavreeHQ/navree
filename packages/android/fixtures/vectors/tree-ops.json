[
  {
    "name": "morph puts the new node where the old one was",
    "before": {
      "title": "Order",
      "body": {
        "t": "stack",
        "children": [
          {
            "t": "text",
            "id": "a",
            "value": "First"
          },
          {
            "t": "badge",
            "id": "status",
            "text": "Paid",
            "tone": "success"
          },
          {
            "t": "text",
            "id": "c",
            "value": "Last"
          }
        ]
      }
    },
    "ops": [
      {
        "op": "morph",
        "target": "status",
        "node": {
          "t": "badge",
          "id": "status",
          "text": "Shipped",
          "tone": "info"
        }
      }
    ],
    "after": {
      "title": "Order",
      "body": {
        "t": "stack",
        "children": [
          {
            "t": "text",
            "id": "a",
            "value": "First"
          },
          {
            "t": "badge",
            "id": "status",
            "text": "Shipped",
            "tone": "info"
          },
          {
            "t": "text",
            "id": "c",
            "value": "Last"
          }
        ]
      }
    }
  },
  {
    "name": "replace may put a node of another kind in the old one's place",
    "before": {
      "title": "Order",
      "body": {
        "t": "stack",
        "children": [
          {
            "t": "progress",
            "id": "wait"
          }
        ]
      }
    },
    "ops": [
      {
        "op": "replace",
        "target": "wait",
        "node": {
          "t": "text",
          "id": "done",
          "value": "Packed"
        }
      }
    ],
    "after": {
      "title": "Order",
      "body": {
        "t": "stack",
        "children": [
          {
            "t": "text",
            "id": "done",
            "value": "Packed"
          }
        ]
      }
    }
  },
  {
    "name": "a node deep in the tree is found: a value of a fact inside a section",
    "before": {
      "title": "Order",
      "body": {
        "t": "section",
        "style": "card",
        "children": [
          {
            "t": "facts",
            "items": [
              {
                "label": "Status",
                "value": [
                  {
                    "t": "badge",
                    "id": "status",
                    "text": "Paid"
                  }
                ]
              },
              {
                "label": "Total",
                "value": [
                  {
                    "t": "text",
                    "value": "₹12,499"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "ops": [
      {
        "op": "morph",
        "target": "status",
        "node": {
          "t": "badge",
          "id": "status",
          "text": "Refunded",
          "tone": "warning"
        }
      }
    ],
    "after": {
      "title": "Order",
      "body": {
        "t": "section",
        "style": "card",
        "children": [
          {
            "t": "facts",
            "items": [
              {
                "label": "Status",
                "value": [
                  {
                    "t": "badge",
                    "id": "status",
                    "text": "Refunded",
                    "tone": "warning"
                  }
                ]
              },
              {
                "label": "Total",
                "value": [
                  {
                    "t": "text",
                    "value": "₹12,499"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },
  {
    "name": "the body itself can be the target",
    "before": {
      "title": "Customers",
      "body": {
        "t": "list",
        "id": "customers",
        "children": [
          {
            "t": "row",
            "title": "Harpreet Kaur"
          }
        ]
      }
    },
    "ops": [
      {
        "op": "replace",
        "target": "customers",
        "node": {
          "t": "empty",
          "id": "customers",
          "title": "No customers yet"
        }
      }
    ],
    "after": {
      "title": "Customers",
      "body": {
        "t": "empty",
        "id": "customers",
        "title": "No customers yet"
      }
    }
  },
  {
