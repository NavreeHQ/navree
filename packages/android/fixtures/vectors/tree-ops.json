  {
    "name": "append adds after the last child and prepend before the first",
    "before": {
      "title": "Orders",
      "body": {
        "t": "list",
        "id": "orders",
        "children": [
          {
            "t": "row",
            "id": "o2",
            "title": "Second"
          }
        ]
      }
    },
    "ops": [
      {
        "op": "append",
        "target": "orders",
        "nodes": [
          {
            "t": "row",
            "id": "o3",
            "title": "Third"
          }
        ]
      },
      {
        "op": "prepend",
        "target": "orders",
        "nodes": [
          {
            "t": "row",
            "id": "o1",
            "title": "First"
          }
        ]
      }
    ],
    "after": {
      "title": "Orders",
      "body": {
        "t": "list",
        "id": "orders",
        "children": [
          {
            "t": "row",
            "id": "o1",
            "title": "First"
          },
          {
            "t": "row",
            "id": "o2",
            "title": "Second"
          },
          {
            "t": "row",
            "id": "o3",
            "title": "Third"
          }
        ]
      }
    }
  },
  {
