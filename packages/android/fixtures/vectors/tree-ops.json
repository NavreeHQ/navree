      "body": {
        "t": "text",
        "value": "x"
      }
    },
    "ops": [
      {
        "op": "morph",
        "target": "ship",
        "node": {
          "t": "button",
          "id": "ship",
          "label": "Shipped",
          "role": "primary",
          "disabled": true
        }
      }
    ],
    "after": {
      "title": "Order",
      "actions": [
        {
          "t": "button",
          "id": "ship",
          "label": "Shipped",
          "role": "primary",
          "disabled": true
        }
      ],
      "body": {
        "t": "text",
        "value": "x"
      }
    }
