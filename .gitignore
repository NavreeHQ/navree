# Rust build output (each agent builds into target/agents/<label>)
target/
# trybuild writes failing UI test output next to the crate (accept reviewed
# snapshots with TRYBUILD=overwrite)
/crates/*/wip/

# Node / Next.js
node_modules/
.next/

# Runtime data written by Navree apps (storage/framework/down, storage/*.db, uploads)
/storage/
/apps/*/storage/

# Databases and local secrets
*.db
*.db-shm
*.db-wal
.env

# insta pending snapshots
*.snap.new
*.pending-snap

# Benchmark: smoke runs and per-language build output
/bench/results/smoke/
/bench/frameworks/*/vendor/
/bench/frameworks/*/dist/
/bench/frameworks/aspnet/bin/
/bench/frameworks/aspnet/obj/
/bench/frameworks/*/.venv/
__pycache__/

# Browser-automation scratch files
.playwright-mcp/
/bench/results/logs/*.build.log
