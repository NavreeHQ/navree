# Production settings. The Dockerfiles copy this to .env and generate APP_KEY.
# DATABASE_URL / DB_*, JWT_SECRET and JWT_ISSUER come from the container
# environment (bench/SPEC.md §5); real environment variables win over .env.
APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
# Plain TCP on the benchmark's private network (the server has no TLS).
DB_SSLMODE=disable

# A stateless JSON API: nothing reads or writes the cache, sessions or queue.
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

JWT_ALGO=HS256
# Logout/blacklisting isn't part of the API (SPEC.md §3.4 checks signature,
# exp and iss), so tokens aren't looked up in the cache.
JWT_BLACKLIST_ENABLED=false

OCTANE_SERVER=frankenphp
