# Skip notices that are allowed in a test run made with
# NAVREE_TEST_REQUIRE_SERVICES=1 (scripts/ci-services.sh check-skips).
# One extended regular expression per line, then an optional ` # reason`.
# A service test that skips itself because its server is missing never goes
# here: with NAVREE_TEST_REQUIRE_SERVICES=1 it fails instead.

# A test written for one database, run on another (NAVREE_TEST_DATABASE).
SKIPPED .*: not on [A-Za-z]+
skipped: needs NAVREE_TEST_DATABASE=postgres

# MySQL 8.4 has no VECTOR type; MySQL 9 and later do.
skipped: MySql has no vector type

# Dock starts containers itself: it needs the Docker command in the same
# environment as the tests (not in WSL on this machine). Run it with
# NAVREE_TEST_DOCKER=1 on Windows or Linux with Docker.
SKIPPED: set NAVREE_TEST_DOCKER=1

# Opt-in builds of generated apps (tests marked #[ignore]).
SKIPPED: set NAVREE_TEST_KIT_WEB=1

# Opt-in runs on paid providers' own test environments, which need keys
# kept in CI secrets (the Stripe test mode, the Paddle sandbox).
SKIPPED [a-z_]+: set (STRIPE_TEST_SECRET|PADDLE_SANDBOX_KEY)

# The docs and skills are not next to a crate that is built from a package.
SKIPPED: the (docs page|skill)

# The skip rule's own test (navree-orm testing::database) prints a notice for a
# variable no suite reads.
skipped: NAVREE_TEST_EXAMPLE_URL is not set

# navree-search's import command reports documents its filter left out; it is
# not a test skipping itself.
Imported [0-9]+ documents \([0-9]+ skipped by the document filter\)
