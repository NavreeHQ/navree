# The directory the OpenLDAP suite reads (base DN dc=acme,dc=test; the
# organisation entry exists already). scripts/integration-services.sh adds
# 600 more people under ou=bulk, to pass the server's size limit of 500.

dn: ou=people,dc=acme,dc=test
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=acme,dc=test
objectClass: organizationalUnit
ou: groups

dn: ou=bulk,dc=acme,dc=test
objectClass: organizationalUnit
ou: bulk

