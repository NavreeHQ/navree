---
source: crates/navree-mongo/tests/mongo/commands.rs
expression: "show(&Deal::query().where_(Filter::document(doc!\n{\n    \"tags\": { \"$elemMatch\": { \"$eq\": \"vip\" } }\n})).or_where(Deal::AMOUNT.gt(1_000_000)))"
---
db.deals.find({"$or": [{"tags": {"$elemMatch": {"$eq": "vip"}}}, {"amount": {"$gt": 1000000}}], "deleted_at": null}, {"_id": 1, "title": 1, "company_id": 1, "amount": 1, "price": 1, "stage": 1, "meta": 1, "tags": 1, "closes_on": 1, "created_at": 1, "updated_at": 1, "deleted_at": 1})
