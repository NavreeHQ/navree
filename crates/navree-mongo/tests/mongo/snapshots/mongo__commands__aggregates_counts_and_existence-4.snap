---
source: crates/navree-mongo/tests/mongo/commands.rs
expression: "format!(\"{top:#}\")"
---
db.deals.aggregate([
  {"$match": {"deleted_at": null}},
  {"$sort": {"amount": -1}},
  {"$limit": 3},
  {"$project": {"_id": 1, "title": 1, "company_id": 1, "amount": 1, "price": 1, "stage": 1, "meta": 1, "tags": 1, "closes_on": 1, "created_at": 1, "updated_at": 1, "deleted_at": 1}},
  {"$group": {"_id": null, "aggregate": {"$avg": "$amount"}}},
  {"$project": {"_id": 0, "aggregate": "$aggregate"}}
])
