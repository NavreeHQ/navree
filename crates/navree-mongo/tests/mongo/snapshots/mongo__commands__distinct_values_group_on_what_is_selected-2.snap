---
source: crates/navree-mongo/tests/mongo/commands.rs
expression: "show(&Deal::query().distinct_on([Deal::COMPANY_ID]).order_by(Deal::COMPANY_ID).order_by_desc(Deal::AMOUNT))"
---
db.deals.aggregate([
  {"$match": {"deleted_at": null}},
  {"$sort": {"company_id": 1, "amount": -1}},
  {"$group": {"_id": {"k0": "$company_id"}, "__navree_first0": {"$first": "$$ROOT"}}},
  {"$replaceWith": "$__navree_first0"},
  {"$sort": {"company_id": 1, "amount": -1}},
  {"$project": {"_id": 1, "title": 1, "company_id": 1, "amount": 1, "price": 1, "stage": 1, "meta": 1, "tags": 1, "closes_on": 1, "created_at": 1, "updated_at": 1, "deleted_at": 1}}
])
