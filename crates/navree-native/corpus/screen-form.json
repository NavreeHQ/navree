{
  "navree": 1,
  "build": "3f9a1c07b2de",
  "vocab": 0,
  "screen": {
    "title": "New customer",
    "subtitle": "Charkha Supply Co.",
    "back": {
      "title": "Customers",
      "href": "/customers"
    },
    "body": {
      "t": "form",
      "id": "customer",
      "method": "post",
      "action": "/customers",
      "hidden": [
        {
          "name": "_csrf",
          "value": "tok"
        },
        {
          "name": "plan",
          "value": "free",
          "id": "plan"
        }
      ],
      "children": [
        {
          "t": "field",
          "id": "f-name",
          "name": "name",
          "label": "Name",
          "help": "As it is written on their invoices.",
          "error": "Enter a name.",
          "required": true,
          "input": {
            "t": "text",
            "placeholder": "Gurpreet Kaur",
            "max_length": 80,
            "autofill": "name"
          }
        },
        {
          "t": "field",
          "id": "f-email",
          "name": "email",
          "label": "Email",
          "input": {
            "t": "text",
            "kind": "email"
          }
        },
        {
          "t": "field",
          "id": "f-password",
          "name": "password",
          "label": "Password",
          "input": {
            "t": "text",
            "kind": "password"
          }
        },
        {
          "t": "field",
          "id": "f-phone",
          "name": "phone",
          "label": "Phone",
          "input": {
            "t": "text",
            "kind": "phone",
            "value": "+919814012345"
          }
        },
        {
          "t": "field",
          "id": "f-site",
          "name": "site",
          "label": "Website",
          "input": {
            "t": "text",
            "kind": "url"
          }
        },
        {
          "t": "field",
          "id": "f-q",
          "name": "q",
          "label": "Search",
          "input": {
            "t": "text",
            "kind": "search"
          }
        },
        {
          "t": "field",
          "id": "f-code",
          "name": "code",
          "label": "Code",
          "input": {
            "t": "text",
            "kind": "one_time_code"
          }
        },
        {
          "t": "field",
          "id": "f-seats",
          "name": "seats",
          "label": "Seats",
          "input": {
            "t": "text",
            "kind": "number",
            "value": "5",
            "min": "1",
            "max": "500",
            "step": "1"
          }
        },
        {
          "t": "field",
          "id": "f-credit",
          "name": "credit",
          "label": "Credit limit",
          "input": {
            "t": "text",
            "kind": "decimal"
          }
        },
        {
          "t": "field",
          "id": "f-notes",
          "name": "notes",
          "label": "Notes",
          "input": {
            "t": "text",
            "kind": "multiline",
            "value": "Prefers delivery before noon.",
            "readonly": true
          }
        },
        {
          "t": "field",
          "id": "f-newsletter",
          "name": "newsletter",
          "label": "Send the newsletter",
          "input": {
            "t": "toggle",
            "on": true
          }
        },
        {
          "t": "field",
          "id": "f-terms",
          "name": "terms",
          "label": "Agrees to the terms",
          "input": {
            "t": "toggle",
            "kind": "checkbox",
            "value": "yes"
          }
        },
        {
          "t": "field",
          "id": "f-city",
          "name": "city",
          "label": "City",
          "input": {
            "t": "choice",
            "kind": "list",
            "options": [
              {
                "value": "ludhiana",
                "label": "Ludhiana"
              },
              {
                "value": "amritsar",
                "label": "Amritsar"
              },
              {
                "value": "chandigarh",
                "label": "Chandigarh"
              },
              {
                "value": "shimla",
                "label": "Shimla",
                "disabled": true
              }
            ],
            "placeholder": "Choose a city"
          }
        },
        {
          "t": "field",
          "id": "f-tier",
          "name": "tier",
          "label": "Tier",
          "input": {
            "t": "choice",
            "kind": "segmented",
            "options": [
              {
                "value": "retail",
                "label": "Retail"
              },
              {
                "value": "trade",
                "label": "Trade"
              }
            ],
            "value": "retail"
          }
        },
        {
          "t": "field",
          "id": "f-pays",
          "name": "pays",
          "label": "Pays by",
          "input": {
            "t": "choice",
            "kind": "radio",
            "options": [
              {
                "value": "upi",
                "label": "UPI"
              },
              {
                "value": "card",
                "label": "Card"
              },
              {
                "value": "cod",
                "label": "Cash on delivery"
              }
            ],
            "value": "upi"
          }
        },
        {
          "t": "field",
          "id": "f-tags",
          "name": "tags",
          "label": "Tags",
          "input": {
            "t": "choices",
            "options": [
              {
                "value": "festive",
                "label": "Festive"
              },
              {
                "value": "bulk",
                "label": "Bulk"
              },
              {
                "value": "gift",
                "label": "Gift"
              }
            ],
            "values": [
              "festive",
              "gift"
            ]
          }
        },
        {
          "t": "field",
          "id": "f-since",
          "name": "since",
          "label": "Customer since",
          "input": {
            "t": "date",
            "value": "2024-03-18",
            "min": "2020-01-01",
            "max": "2026-11-12"
          }
        },
        {
          "t": "field",
          "id": "f-call_at",
          "name": "call_at",
          "label": "Call at",
          "input": {
            "t": "date",
            "kind": "time",
            "value": "09:41"
          }
        },
        {
          "t": "field",
          "id": "f-visit",
          "name": "visit",
          "label": "Next visit",
          "input": {
            "t": "date",
            "kind": "datetime",
            "value": "2026-11-14T16:30"
          }
        },
        {
          "t": "field",
          "id": "f-discount",
          "name": "discount",
          "label": "Discount",
          "input": {
            "t": "slider",
            "min": "0",
            "max": "30",
            "step": "2.5",
            "value": "7.5"
          }
        },
        {
          "t": "field",
          "id": "f-label",
          "name": "label",
          "label": "Label colour",
          "input": {
            "t": "colour",
            "value": "#16a34a"
          }
        },
        {
          "t": "field",
          "id": "f-papers",
          "name": "papers",
          "label": "Papers",
          "input": {
            "t": "file",
            "accept": "image/*,.pdf",
            "multiple": true,
            "capture": "environment"
          }
        },
        {
          "t": "stack",
          "axis": "horizontal",
          "gap": 2,
          "justify": "end",
          "children": [
            {
              "t": "button",
              "label": "Cancel",
              "role": "cancel",
              "action": {
                "t": "back"
              }
            },
            {
              "t": "button",
              "label": "Save and add another",
              "role": "secondary",
              "action": {
                "t": "submit",
                "form": "customer",
                "href": "/customers?again=1",
                "with": {
                  "name": "then",
                  "value": "again"
                }
              }
            },
            {
              "t": "button",
              "label": "Save",
              "role": "primary",
              "prominence": "high",
              "action": {
                "t": "submit"
              }
            }
          ]
        }
      ]
    }
  }
}
