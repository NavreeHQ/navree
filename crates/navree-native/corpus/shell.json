  "user": {
    "name": "Ravneet Kaur",
    "email": "ravneet.kaur@example.com",
    "menu": [
      {
        "t": "link",
        "label": "Profile",
        "action": {
          "t": "navigate",
          "href": "/profile"
        }
      },
      {
        "t": "button",
        "label": "Sign out",
        "action": {
          "t": "request",
          "method": "post",
          "href": "/sign-out",
          "fields": [
            {
              "name": "_csrf",
              "value": "tok"
            }
          ]
        }
      }
    ]
  },
  "routes": [
    {
      "match": "/orders/new",
      "present": "sheet"
    },
    {
      "match": "/sign-in",
      "present": "full",
      "chrome": false
    }
  ],
  "device": {
    "caps": [
      "confirm",
      "push",
      "share",
      "scan_code"
    ],
    "push": {
      "register": "/api/notifications/push-devices"
    },
    "lock": {
      "after_secs": 300
    }
  },
  "sign_in": {
    "start": "/auth/app/sign-in",
    "exchange": "/api/auth/app/exchange",
    "callback": "https://charkha.example/app/signed-in",
    "second_step": "/sign-in/two-factor"
  }
}
