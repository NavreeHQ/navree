PostgreSQL: SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE (("deals"."tags")::jsonb <@ $1) AND (COALESCE(("meta")::jsonb ? $2, false)) AND (EXISTS (SELECT 1 FROM jsonb_array_elements($3) AS "navree_candidate" WHERE ("deals"."tags")::jsonb @> jsonb_build_array("navree_candidate"."value"))) AND "deals"."deleted_at" IS NULL
  values: [Json(Some(Array [String("vip"), String("q1"), String("q2")])), String(Some("owner")), Json(Some(Array [String("vip")]))]
MySQL: SELECT `deals`.`id`, `deals`.`company_id`, `deals`.`title`, `deals`.`amount_cents`, `deals`.`stage`, `deals`.`tags`, `deals`.`closed_at`, `deals`.`created_at`, `deals`.`updated_at`, `deals`.`deleted_at` FROM `deals` WHERE (json_contains(CAST(? AS JSON), `deals`.`tags`)) AND (IFNULL(json_contains_path(`meta`, 'one', '$."owner"'), 0)) AND (json_overlaps(`deals`.`tags`, CAST(? AS JSON))) AND `deals`.`deleted_at` IS NULL
