---
source: crates/navree-orm/tests/sql/text.rs
expression: "query(Company::query().where_(Company::ID.gt(3_i64)).where_(Company::NAME.contains_ignore_case(\"agra\").or(Company::COUNTRY.contains_ignore_case(\"agra\"))).where_not(Company::NAME.eq_ignore_case(\"AGRA Holdings\")))"
---
PostgreSQL: SELECT "companies"."id", "companies"."name", "companies"."country" FROM "companies" WHERE "companies"."id" > $1 AND (LOWER("companies"."name") LIKE $2 ESCAPE E'\\' OR LOWER("companies"."country") LIKE $3 ESCAPE E'\\') AND NOT (LOWER("companies"."name") = $4)
  values: [I64(3), String("%agra%"), String("%agra%"), String("agra holdings")]
MySQL: SELECT `companies`.`id`, `companies`.`name`, `companies`.`country` FROM `companies` WHERE `companies`.`id` > ? AND (INSTR(CAST(LOWER(`companies`.`name`) AS BINARY), CAST(? AS BINARY)) > 0 OR INSTR(CAST(LOWER(`companies`.`country`) AS BINARY), CAST(? AS BINARY)) > 0) AND NOT (CAST(LOWER(`companies`.`name`) AS BINARY) = CAST(? AS BINARY))
  values: [I64(3), String("agra"), String("agra"), String("agra holdings")]
SQLite: SELECT "companies"."id", "companies"."name", "companies"."country" FROM "companies" WHERE "companies"."id" > ? AND ("companies"."name" GLOB ? OR "companies"."country" GLOB ?) AND NOT ("companies"."name" GLOB ?)
  values: [I64(3), String("*[aA][gG][rR][aA]*"), String("*[aA][gG][rR][aA]*"), String("[Aa][Gg][Rr][Aa] [Hh][oO][lL][dD][iI][nN][gG][sS]")]
