  values: [Int(Some(1))]
MySQL: SELECT COUNT(*) AS `aggregate` FROM (SELECT `stage` FROM `deals` GROUP BY `stage` HAVING COUNT(*) > ?) AS `aggregate_table`
  values: [Int(Some(1))]
SQLite: SELECT COUNT(*) AS "aggregate" FROM (SELECT "stage" FROM "deals" GROUP BY "stage" HAVING COUNT(*) > ?) AS "aggregate_table"
  values: [Int(Some(1))]
