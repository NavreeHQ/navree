---
source: crates/navree-orm/tests/sql/main.rs
expression: "query(Deal::query().where_like(Deal::TITLE,\n\"%renewal%\").where_not_like(Deal::TITLE,\n\"draft%\").where_like_case_sensitive(Deal::TITLE,\n\"Q_ 50%*\").where_(Company::COUNTRY.like(\"u%\")))"
---
PostgreSQL: SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE (("deals"."title"::text) ILIKE $1) AND (("deals"."title"::text) NOT ILIKE $2) AND ("deals"."title"::text) LIKE $3 AND (("companies"."country"::text) ILIKE $4) AND "deals"."deleted_at" IS NULL
  values: [String(Some("%renewal%")), String(Some("draft%")), String(Some("Q_ 50%*")), String(Some("u%"))]
MySQL: SELECT `deals`.`id`, `deals`.`company_id`, `deals`.`title`, `deals`.`amount_cents`, `deals`.`stage`, `deals`.`tags`, `deals`.`closed_at`, `deals`.`created_at`, `deals`.`updated_at`, `deals`.`deleted_at` FROM `deals` WHERE `deals`.`title` LIKE ? AND `deals`.`title` NOT LIKE ? AND (`deals`.`title` LIKE BINARY ?) AND `companies`.`country` LIKE ? AND `deals`.`deleted_at` IS NULL
  values: [String(Some("%renewal%")), String(Some("draft%")), String(Some("Q_ 50%*")), String(Some("u%"))]
SQLite: SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE "deals"."title" LIKE ? AND "deals"."title" NOT LIKE ? AND ("deals"."title" GLOB ?) AND "companies"."country" LIKE ? AND "deals"."deleted_at" IS NULL
  values: [String(Some("%renewal%")), String(Some("draft%")), String(Some("Q? 50*[*]")), String(Some("u%"))]
