source: crates/navree-orm/tests/sql/main.rs
expression: "query(Deal::query().where_(Deal::AMOUNT_CENTS.gt(1)).where_raw(\"lower(title) = ? OR amount_cents = ?\",\n[Value::from(\"agra\"),\nValue::from(5_i64)]).where_raw(\"meta ?? 'k' AND title <> '?'\",\nVec::<Value>::new()).where_(Deal::TITLE.null_safe_eq(\"x\")).where_(Deal::TITLE.op(\"regexp\",\n\"^A\")).where_(Deal::AMOUNT_CENTS.op(\"&\", 4)))"
