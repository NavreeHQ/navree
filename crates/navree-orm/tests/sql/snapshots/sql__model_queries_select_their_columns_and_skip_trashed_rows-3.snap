PostgreSQL: SELECT "companies"."id", "companies"."name", "companies"."country" FROM "companies" WHERE "companies"."id" IN ($1, $2, $3)
  values: [I64(1), I64(2), I64(3)]
MySQL: SELECT `companies`.`id`, `companies`.`name`, `companies`.`country` FROM `companies` WHERE `companies`.`id` IN (?, ?, ?)
  values: [I64(1), I64(2), I64(3)]
SQLite: SELECT "companies"."id", "companies"."name", "companies"."country" FROM "companies" WHERE "companies"."id" IN (?, ?, ?)
  values: [I64(1), I64(2), I64(3)]
