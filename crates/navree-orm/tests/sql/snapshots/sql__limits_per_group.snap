PostgreSQL: SELECT "navree_table"."id", "navree_table"."company_id", "navree_table"."title", "navree_table"."amount_cents", "navree_table"."stage", "navree_table"."tags", "navree_table"."closed_at", "navree_table"."created_at", "navree_table"."updated_at", "navree_table"."deleted_at" FROM (SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at", ROW_NUMBER() OVER (PARTITION BY "deals"."company_id" ORDER BY "deals"."created_at" DESC) AS "navree_row" FROM "deals" WHERE "deals"."deleted_at" IS NULL) AS "navree_table" WHERE "navree_table"."navree_row" <= $1 ORDER BY "navree_table"."navree_row" ASC
