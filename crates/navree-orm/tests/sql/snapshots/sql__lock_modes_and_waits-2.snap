PostgreSQL: SELECT "companies"."id", "companies"."name", "companies"."country" FROM "companies" WHERE "companies"."id" = $1 FOR SHARE NOWAIT
  values: [I64(1)]
MySQL: SELECT `companies`.`id`, `companies`.`name`, `companies`.`country` FROM `companies` WHERE `companies`.`id` = ? FOR SHARE NOWAIT
  values: [I64(1)]
SQLite: SELECT "companies"."id", "companies"."name", "companies"."country" FROM "companies" WHERE "companies"."id" = ?
  values: [I64(1)]
