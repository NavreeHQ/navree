PostgreSQL: SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE to_tsvector('english', "deals"."title") @@ plainto_tsquery('english', $1) AND "deals"."deleted_at" IS NULL
  values: [String("renewal pricing")]
MySQL: SELECT `deals`.`id`, `deals`.`company_id`, `deals`.`title`, `deals`.`amount_cents`, `deals`.`stage`, `deals`.`tags`, `deals`.`closed_at`, `deals`.`created_at`, `deals`.`updated_at`, `deals`.`deleted_at` FROM `deals` WHERE (MATCH (`deals`.`title`) AGAINST (? IN NATURAL LANGUAGE MODE)) AND `deals`.`deleted_at` IS NULL
