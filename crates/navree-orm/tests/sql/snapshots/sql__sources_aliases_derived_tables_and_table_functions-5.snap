expression: "query(Deal::query().from_sub(Deal::query().where_(Deal::STAGE.eq(Stage::Won)).union_all(Deal::query().where_(Deal::AMOUNT_CENTS.gt(100)))).order_by(Deal::TITLE))"
---
PostgreSQL: SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM (SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE "deals"."stage" = $1 AND "deals"."deleted_at" IS NULL UNION ALL SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE "deals"."amount_cents" > $2 AND "deals"."deleted_at" IS NULL) AS "deals" WHERE "deals"."deleted_at" IS NULL ORDER BY "deals"."title" ASC
  values: [String(Some("won")), BigInt(Some(100))]
