---
source: crates/navree-orm/tests/sql/main.rs
assertion_line: 519
expression: "query(Deal::query().where_json_contains_key(\"meta->owner->email\").where_json_doesnt_contain_key(\"meta->tags[2]\").or_where_json_contains_key(\"meta->tags[-1]\"))"
---
PostgreSQL: SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE ((COALESCE(CAST("meta"->'owner' AS JSONB) ? $1, FALSE) AND NOT CASE WHEN jsonb_typeof(CAST("meta"->'tags' AS JSONB)) = 'array' THEN jsonb_array_length(CAST("meta"->'tags' AS JSONB)) >= $2 ELSE FALSE END) OR CASE WHEN jsonb_typeof(CAST("meta"->'tags' AS JSONB)) = 'array' THEN jsonb_array_length(CAST("meta"->'tags' AS JSONB)) >= $3 ELSE FALSE END) AND "deals"."deleted_at" IS NULL
  values: [String(Some("email")), BigInt(Some(3)), BigInt(Some(1))]
MySQL: SELECT `deals`.`id`, `deals`.`company_id`, `deals`.`title`, `deals`.`amount_cents`, `deals`.`stage`, `deals`.`tags`, `deals`.`closed_at`, `deals`.`created_at`, `deals`.`updated_at`, `deals`.`deleted_at` FROM `deals` WHERE ((IFNULL(json_contains_path(`meta`, 'one', '$."owner"."email"'), 0) AND NOT IFNULL(json_contains_path(`meta`, 'one', '$."tags"[2]'), 0)) OR IFNULL(json_contains_path(`meta`, 'one', '$."tags"[last]'), 0)) AND `deals`.`deleted_at` IS NULL
SQLite: SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE ((json_type("meta", '$."owner"."email"') IS NOT NULL AND NOT (json_type("meta", '$."tags"[2]') IS NOT NULL)) OR json_type("meta", '$."tags"[#-1]') IS NOT NULL) AND "deals"."deleted_at" IS NULL
