expression: "query(Ledger::query().where_(Ledger::BALANCE.eq(\"12.345\".parse::<Decimal>().unwrap())).where_(Ledger::OPENED_ON.gte(at())).where_(Ledger::SYNCED_AT.lt(at())).where_(Ledger::REFERENCE.eq(reference)).where_(Ledger::BATCH.eq(batch)).where_(Ledger::CODE.eq(\"abc\")))"
