---
source: crates/navree-orm/tests/sql/main.rs
expression: "query(Deal::query().where_null(Deal::CLOSED_AT).or_where_not_null(Deal::COMPANY_ID).where_in(Deal::STAGE,\n[Stage::Lead,\nStage::Lost]).where_not_in(Deal::COMPANY_ID,\n[1_i64]).where_between(Deal::AMOUNT_CENTS, 100,\n200).where_not_between(Deal::CLOSED_AT, at(),\nat()).where_(Deal::CLOSED_AT.eq(None)))"
---
PostgreSQL: SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE ("deals"."closed_at" IS NULL OR ("deals"."company_id" IS NOT NULL AND "deals"."stage" IN ($1, $2) AND "deals"."company_id" NOT IN ($3) AND "deals"."amount_cents" BETWEEN $4 AND $5 AND "deals"."closed_at" NOT BETWEEN $6 AND $7 AND "deals"."closed_at" IS NULL)) AND "deals"."deleted_at" IS NULL
  values: [String("lead"), String("lost"), I64(1), I64(100), I64(200), Timestamp(2026-10-27T08:30:00Z), Timestamp(2026-10-27T08:30:00Z)]
