---
source: crates/navree-orm/tests/sql/main.rs
expression: "query(Company::query().join_sub(Deal::query().select([Deal::COMPANY_ID]).select_expr(Expr::max(Deal::AMOUNT_CENTS),\n\"top\").group_by([Deal::COMPANY_ID]), \"best\", \"best.company_id\", \"=\",\nCompany::ID,))"
---
PostgreSQL: SELECT "companies"."id", "companies"."name", "companies"."country" FROM "companies" INNER JOIN (SELECT "deals"."company_id", MAX("deals"."amount_cents") AS "top" FROM "deals" WHERE "deals"."deleted_at" IS NULL GROUP BY "deals"."company_id") AS "best" ON "best"."company_id" = "companies"."id"
MySQL: SELECT `companies`.`id`, `companies`.`name`, `companies`.`country` FROM `companies` INNER JOIN (SELECT `deals`.`company_id`, MAX(`deals`.`amount_cents`) AS `top` FROM `deals` WHERE `deals`.`deleted_at` IS NULL GROUP BY `deals`.`company_id`) AS `best` ON `best`.`company_id` = `companies`.`id`
SQLite: SELECT "companies"."id", "companies"."name", "companies"."country" FROM "companies" INNER JOIN (SELECT "deals"."company_id", MAX("deals"."amount_cents") AS "top" FROM "deals" WHERE "deals"."deleted_at" IS NULL GROUP BY "deals"."company_id") AS "best" ON "best"."company_id" = "companies"."id"
