PostgreSQL: SELECT "navree_table"."id", "navree_table"."deal_id" FROM (SELECT "id", "deal_id", ROW_NUMBER() OVER ( PARTITION BY "deal_id" ORDER BY "due_at" DESC ) AS "navree_row" FROM "activities") AS "navree_table" WHERE "navree_table"."navree_row" <= $1 AND "navree_table"."navree_row" > $2 ORDER BY "navree_table"."navree_row" ASC LIMIT $3
  values: [BigInt(Some(4)), BigInt(Some(1)), BigUnsigned(Some(50))]
