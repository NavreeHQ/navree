---
source: crates/navree-orm/tests/sql/main.rs
assertion_line: 514
expression: "query(Deal::query().where_json_overlaps(Deal::TAGS,\n[\"vip\", \"q1\"]).or_where_json_doesnt_overlap(\"meta->labels\", \"spam\"))"
---
PostgreSQL: SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE (EXISTS (SELECT 1 FROM jsonb_array_elements($1) AS "navree_candidate" WHERE CAST("deals"."tags" AS JSONB) @> jsonb_build_array("navree_candidate"."value")) OR NOT EXISTS (SELECT 1 FROM jsonb_array_elements($2) AS "navree_candidate" WHERE CAST("meta"->'labels' AS JSONB) @> jsonb_build_array("navree_candidate"."value"))) AND "deals"."deleted_at" IS NULL
  values: [Json(Some(Array [String("vip"), String("q1")])), Json(Some(Array [String("spam")]))]
MySQL: SELECT `deals`.`id`, `deals`.`company_id`, `deals`.`title`, `deals`.`amount_cents`, `deals`.`stage`, `deals`.`tags`, `deals`.`closed_at`, `deals`.`created_at`, `deals`.`updated_at`, `deals`.`deleted_at` FROM `deals` WHERE (json_overlaps(`deals`.`tags`, CAST(? AS JSON)) OR NOT json_overlaps(json_extract(`meta`, '$."labels"'), CAST(? AS JSON))) AND `deals`.`deleted_at` IS NULL
  values: [String(Some("[\"vip\",\"q1\"]")), String(Some("[\"spam\"]"))]
SQLite: SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE (EXISTS (SELECT 1 FROM json_each("deals"."tags") AS "navree_left", json_each(?) AS "navree_right" WHERE "navree_left"."value" = "navree_right"."value") OR NOT EXISTS (SELECT 1 FROM json_each("meta", '$."labels"') AS "navree_left", json_each(?) AS "navree_right" WHERE "navree_left"."value" = "navree_right"."value")) AND "deals"."deleted_at" IS NULL
  values: [String(Some("[\"vip\",\"q1\"]")), String(Some("[\"spam\"]"))]
