PostgreSQL: SELECT EXISTS (SELECT 1 FROM "deals" WHERE "deals"."stage" = $1 AND "deals"."deleted_at" IS NULL) AS "exists"
  values: [String("won")]
MySQL: SELECT EXISTS (SELECT 1 FROM `deals` WHERE `deals`.`stage` = ? AND `deals`.`deleted_at` IS NULL) AS `exists`
  values: [String("won")]
SQLite: SELECT EXISTS (SELECT 1 FROM "deals" WHERE "deals"."stage" = ? AND "deals"."deleted_at" IS NULL) AS "exists"
  values: [String("won")]
