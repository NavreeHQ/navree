---
source: crates/navree-orm/tests/sql/main.rs
expression: "query(Deal::query().where_(Deal::TITLE.ilike(\"%renewal%\")).where_(Deal::TITLE.regex(\"^[A-Z]\")).where_(Deal::TITLE.not_regex(\"draft$\")).where_(Deal::TITLE.regex_case_insensitive(\"^agra\")).where_(Deal::TITLE.not_regex_case_insensitive(\"test\")).where_(Company::COUNTRY.is_distinct_from(\"US\")))"
---
PostgreSQL: SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE CAST("deals"."title" AS TEXT) ILIKE $1 AND "deals"."title" ~ $2 AND "deals"."title" !~ $3 AND "deals"."title" ~* $4 AND "deals"."title" !~* $5 AND "companies"."country" IS DISTINCT FROM $6 AND "deals"."deleted_at" IS NULL
  values: [String("%renewal%"), String("^[A-Z]"), String("draft$"), String("^agra"), String("test"), String("US")]
MySQL: SELECT `deals`.`id`, `deals`.`company_id`, `deals`.`title`, `deals`.`amount_cents`, `deals`.`stage`, `deals`.`tags`, `deals`.`closed_at`, `deals`.`created_at`, `deals`.`updated_at`, `deals`.`deleted_at` FROM `deals` WHERE `deals`.`title` LIKE ? AND REGEXP_LIKE(`deals`.`title`, ?, 'c') AND NOT REGEXP_LIKE(`deals`.`title`, ?, 'c') AND REGEXP_LIKE(`deals`.`title`, ?, 'i') AND NOT REGEXP_LIKE(`deals`.`title`, ?, 'i') AND NOT (`companies`.`country` <=> ?) AND `deals`.`deleted_at` IS NULL
  values: [String("%renewal%"), String("^[A-Z]"), String("draft$"), String("^agra"), String("test"), String("US")]
SQLite: SELECT "deals"."id", "deals"."company_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."tags", "deals"."closed_at", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE "deals"."title" LIKE ? AND "deals"."title" REGEXP ? AND "deals"."title" NOT REGEXP ? AND "deals"."title" REGEXP ('(?i)' || ?) AND "deals"."title" NOT REGEXP ('(?i)' || ?) AND "companies"."country" IS NOT ? AND "deals"."deleted_at" IS NULL
  values: [String("%renewal%"), String("^[A-Z]"), String("draft$"), String("^agra"), String("test"), String("US")]
