PostgreSQL: SELECT COUNT(*) AS "aggregate" FROM "deals" WHERE "deals"."stage" = $1 AND "deals"."deleted_at" IS NULL
  values: [String("won")]
MySQL: SELECT COUNT(*) AS `aggregate` FROM `deals` WHERE `deals`.`stage` = ? AND `deals`.`deleted_at` IS NULL
  values: [String("won")]
SQLite: SELECT COUNT(*) AS "aggregate" FROM "deals" WHERE "deals"."stage" = ? AND "deals"."deleted_at" IS NULL
  values: [String("won")]
