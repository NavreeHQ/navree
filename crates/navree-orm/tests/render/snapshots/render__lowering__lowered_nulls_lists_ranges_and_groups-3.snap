expression: "query(Deal::query().where_(Deal::AMOUNT_CENTS.gt(0)).where_group(|g|\n{\n    g.where_(Deal::STAGE.eq(Stage::Won)).or_where_group(|inner|\n    { inner.where_(Deal::STAGE.eq(Stage::Lost)).where_null(Deal::CLOSED_AT) })\n}).where_not(Deal::TITLE.eq(\"x\").or(Deal::TITLE.eq(\"y\"))).or_where_not(Deal::AMOUNT_CENTS.lt(5)))"
