source: crates/navree-orm/tests/render/main.rs
expression: "statement(Insert\n{\n    on_conflict:\n    Some(OnConflict\n    {\n        target: vec![Ident::new(\"name\")], action: ConflictAction::Update\n        {\n            sets:\n            vec![Assignment::new(\"color\",\n            Expr::Excluded(Ident::new(\"color\"))),\n            Assignment::new(\"hits\",\n            col(\"tags.hits\").add(Expr::Excluded(Ident::new(\"hits\")))),\n            Assignment::new(\"note\", val(\"merged\")),], filter: None,\n        },\n    }), ..tag()\n})"
---
PostgreSQL: INSERT INTO "tags" ("name", "color") VALUES ($1, $2) ON CONFLICT ("name") DO UPDATE SET "color" = "excluded"."color", "hits" = "tags"."hits" + "excluded"."hits", "note" = $3
  values: [String("vip"), String("gold"), String("merged")]
MySQL: INSERT INTO `tags` (`name`, `color`) VALUES (?, ?) ON DUPLICATE KEY UPDATE `color` = VALUES(`color`), `hits` = `tags`.`hits` + VALUES(`hits`), `note` = ?
  values: [String("vip"), String("gold"), String("merged")]
SQLite: INSERT INTO "tags" ("name", "color") VALUES (?, ?) ON CONFLICT ("name") DO UPDATE SET "color" = "excluded"."color", "hits" = "tags"."hits" + "excluded"."hits", "note" = ?
  values: [String("vip"), String("gold"), String("merged")]
