source: crates/navree-orm/tests/render/lowering.rs
expression: "query(Deal::query().add_select([(Deal::TITLE,\n\"label\")]).select_raw(\"amount_cents * ? AS doubled\",\n[2]).select_sub(Company::query().select([Company::NAME]).where_column(Company::ID,\n\"=\", Deal::COMPANY_ID),\n\"company\").select_expr(Expr::coalesce([col(\"closed_at\"), col(\"created_at\")]),\n\"settled_at\"))"
---
