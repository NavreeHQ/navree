---
source: crates/navree-orm/tests/render/main.rs
expression: "query(Query::from(deals().column(Expr::Wildcard(Some(ObjectName::parse(\"deals\")))).join(Join::inner(Source::table(\"companies\"),\ncol(\"companies.id\").eq(col(\"deals.company_id\")))).join(Join::left(Source::aliased(\"users\",\n\"owner\"),\ncol(\"owner.id\").eq(col(\"deals.owner_id\")))).join(Join\n{\n    kind: JoinKind::Right, source: Source::table(\"regions\"), on:\n    Some(col(\"regions.id\").eq(col(\"companies.region_id\")).or(col(\"regions.code\").eq(col(\"companies.code\")))),\n}).join(Join::cross(Source::table(\"currencies\"))).join(Join\n{ kind: JoinKind::Inner, source: Source::table(\"tags\"), on: None, })))"
---
PostgreSQL: SELECT "deals".* FROM "deals" INNER JOIN "companies" ON "companies"."id" = "deals"."company_id" LEFT JOIN "users" AS "owner" ON "owner"."id" = "deals"."owner_id" RIGHT JOIN "regions" ON "regions"."id" = "companies"."region_id" OR "regions"."code" = "companies"."code" CROSS JOIN "currencies" INNER JOIN "tags" ON TRUE
MySQL: SELECT `deals`.* FROM `deals` INNER JOIN `companies` ON `companies`.`id` = `deals`.`company_id` LEFT JOIN `users` AS `owner` ON `owner`.`id` = `deals`.`owner_id` RIGHT JOIN `regions` ON `regions`.`id` = `companies`.`region_id` OR `regions`.`code` = `companies`.`code` CROSS JOIN `currencies` INNER JOIN `tags` ON TRUE
SQLite: SELECT "deals".* FROM "deals" INNER JOIN "companies" ON "companies"."id" = "deals"."company_id" LEFT JOIN "users" AS "owner" ON "owner"."id" = "deals"."owner_id" RIGHT JOIN "regions" ON "regions"."id" = "companies"."region_id" OR "regions"."code" = "companies"."code" CROSS JOIN "currencies" INNER JOIN "tags" ON TRUE
