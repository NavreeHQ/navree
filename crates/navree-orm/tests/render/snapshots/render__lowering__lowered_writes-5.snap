---
source: crates/navree-orm/tests/render/lowering.rs
expression: "per_dialect(|d| render_update(&update, d))"
---
PostgreSQL: UPDATE "deals" SET "meta" = jsonb_set(jsonb_set(COALESCE(CAST("meta" AS JSONB), jsonb_build_object()), '{"status"}', $1), '{"owner","name"}', $2), "title" = $3, "amount_cents" = "amount_cents" + $4 WHERE "deals"."id" = $5
  values: [Json(String("won")), Json(String("ada")), String("Renewal"), I64(5), Uuid(00000000-0000-0000-0000-000000000000)]
MySQL: UPDATE `deals` SET `meta` = json_set(COALESCE(`meta`, JSON_OBJECT()), '$."status"', CAST(? AS JSON), '$."owner"."name"', CAST(? AS JSON)), `title` = ?, `amount_cents` = `amount_cents` + ? WHERE `deals`.`id` = ?
  values: [String("\"won\""), String("\"ada\""), String("Renewal"), I64(5), Uuid(00000000-0000-0000-0000-000000000000)]
SQLite: UPDATE "deals" SET "meta" = json_set(ifnull("meta", json_object()), '$."status"', json(?), '$."owner"."name"', json(?)), "title" = ?, "amount_cents" = "amount_cents" + ? WHERE "deals"."id" = ?
  values: [String("\"won\""), String("\"ada\""), String("Renewal"), I64(5), Uuid(00000000-0000-0000-0000-000000000000)]
