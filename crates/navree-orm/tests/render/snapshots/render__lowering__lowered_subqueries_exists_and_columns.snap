---
source: crates/navree-orm/tests/render/lowering.rs
expression: "query(Company::query().where_exists(Deal::query().where_column(Deal::COMPANY_ID,\n\"=\",\nCompany::ID)).where_not_exists(Deal::query().where_column(Deal::COMPANY_ID,\n\"=\",\nCompany::ID).where_(Deal::STAGE.eq(Stage::Lost))).where_in_sub(Company::ID,\nDeal::query().select([Deal::COMPANY_ID]).where_(Deal::STAGE.eq(Stage::Won))).where_sub(Company::ID,\n\">\", table(\"deals\").select([Expr::max(col(\"company_id\"))])))"
---
PostgreSQL: SELECT "companies"."id", "companies"."name", "companies"."country" FROM "companies" WHERE EXISTS (SELECT 1 FROM "deals" WHERE "deals"."company_id" = "companies"."id" AND "deals"."deleted_at" IS NULL) AND NOT EXISTS (SELECT 1 FROM "deals" WHERE "deals"."company_id" = "companies"."id" AND "deals"."stage" = $1 AND "deals"."deleted_at" IS NULL) AND "companies"."id" IN (SELECT "deals"."company_id" FROM "deals" WHERE "deals"."stage" = $2 AND "deals"."deleted_at" IS NULL) AND "companies"."id" > (SELECT MAX("company_id") FROM "deals")
  values: [String(Some("lost")), String(Some("won"))]
