PostgreSQL: SELECT "deals"."id", "deals"."company_id", "deals"."owner_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at", (SELECT COUNT(*) FROM "activities" WHERE "deals"."id" = "activities"."deal_id") AS "activities_count", (SELECT SUM("activities"."minutes") FROM "activities" WHERE "deals"."id" = "activities"."deal_id") AS "minutes", (SELECT MAX("activities"."minutes") FROM "activities" WHERE "deals"."id" = "activities"."deal_id") AS "activities_max_minutes", EXISTS(SELECT 1 FROM "tags" INNER JOIN "deal_tag" ON "tags"."id" = "deal_tag"."tag_id" WHERE "deals"."id" = "deal_tag"."deal_id") AS "tags_exists", (SELECT COUNT(*) FROM "contacts" INNER JOIN "companies" ON "companies"."id" = "contacts"."company_id" WHERE "deals"."company_id" = "companies"."id" AND (("contacts"."email"::text) NOT ILIKE $1)) AS "contacts_count" FROM "deals" WHERE "deals"."deleted_at" IS NULL
  values: [String(Some("%@hidden.test"))]
