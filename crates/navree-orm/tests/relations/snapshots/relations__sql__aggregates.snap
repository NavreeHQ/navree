source: crates/navree-orm/tests/relations/sql.rs
expression: "query(Deal::query().with_count(\"activities\").with_sum(\"activities as minutes\",\nActivity::MINUTES).with_aggregate(\"activities\", Activity::MINUTES,\nAggregateFunction::Max).with_exists(\"tags\").with_count(\"contacts\"))"
