---
source: crates/navree-orm/tests/relations/sql.rs
expression: "query(Deal::query().has_count(\"activities\", \">=\", 3))"
---
PostgreSQL: SELECT "deals"."id", "deals"."company_id", "deals"."owner_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE (SELECT COUNT(*) FROM "activities" WHERE "deals"."id" = "activities"."deal_id") >= $1 AND "deals"."deleted_at" IS NULL
  values: [I64(3)]
MySQL: SELECT `deals`.`id`, `deals`.`company_id`, `deals`.`owner_id`, `deals`.`title`, `deals`.`amount_cents`, `deals`.`stage`, `deals`.`created_at`, `deals`.`updated_at`, `deals`.`deleted_at` FROM `deals` WHERE (SELECT COUNT(*) FROM `activities` WHERE `deals`.`id` = `activities`.`deal_id`) >= ? AND `deals`.`deleted_at` IS NULL
  values: [I64(3)]
SQLite: SELECT "deals"."id", "deals"."company_id", "deals"."owner_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at" FROM "deals" WHERE (SELECT COUNT(*) FROM "activities" WHERE "deals"."id" = "activities"."deal_id") >= ? AND "deals"."deleted_at" IS NULL
  values: [I64(3)]
