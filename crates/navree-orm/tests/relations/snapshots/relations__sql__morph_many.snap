PostgreSQL: SELECT "notes"."id", "notes"."notable_type", "notes"."notable_id", "notes"."body" FROM "notes" WHERE "notes"."notable_id" = $1 AND "notes"."notable_id" IS NOT NULL AND "notes"."notable_type" = $2
  values: [BigInt(Some(7)), String(Some("deal"))]
MySQL: SELECT `notes`.`id`, `notes`.`notable_type`, `notes`.`notable_id`, `notes`.`body` FROM `notes` WHERE `notes`.`notable_id` = ? AND `notes`.`notable_id` IS NOT NULL AND `notes`.`notable_type` = ?
  values: [BigInt(Some(7)), String(Some("deal"))]
SQLite: SELECT "notes"."id", "notes"."notable_type", "notes"."notable_id", "notes"."body" FROM "notes" WHERE "notes"."notable_id" = ? AND "notes"."notable_id" IS NOT NULL AND "notes"."notable_type" = ?
  values: [BigInt(Some(7)), String(Some("deal"))]
