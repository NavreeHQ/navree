PostgreSQL: SELECT "contacts"."id", "contacts"."company_id", "contacts"."company_code", "contacts"."name", "contacts"."email", "companies"."id" AS "navree_through_key" FROM "contacts" INNER JOIN "companies" ON "companies"."id" = "contacts"."company_id" WHERE "companies"."id" = $1 AND CAST("contacts"."email" AS TEXT) NOT ILIKE $2
  values: [I64(3), String("%@hidden.test")]
MySQL: SELECT `contacts`.`id`, `contacts`.`company_id`, `contacts`.`company_code`, `contacts`.`name`, `contacts`.`email`, `companies`.`id` AS `navree_through_key` FROM `contacts` INNER JOIN `companies` ON `companies`.`id` = `contacts`.`company_id` WHERE `companies`.`id` = ? AND `contacts`.`email` NOT LIKE ?
  values: [I64(3), String("%@hidden.test")]
SQLite: SELECT "contacts"."id", "contacts"."company_id", "contacts"."company_code", "contacts"."name", "contacts"."email", "companies"."id" AS "navree_through_key" FROM "contacts" INNER JOIN "companies" ON "companies"."id" = "contacts"."company_id" WHERE "companies"."id" = ? AND "contacts"."email" NOT LIKE ?
  values: [I64(3), String("%@hidden.test")]
