PostgreSQL: SELECT "deals"."id", "deals"."company_id", "deals"."owner_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at", "users"."team_id" AS "navree_through_key" FROM "deals" INNER JOIN "users" ON "users"."id" = "deals"."owner_id" WHERE "users"."team_id" = $1 AND "users"."deleted_at" IS NULL AND "deals"."deleted_at" IS NULL
  values: [I64(1)]
