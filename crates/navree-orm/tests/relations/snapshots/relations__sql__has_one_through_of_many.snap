PostgreSQL: SELECT "deals"."id", "deals"."company_id", "deals"."owner_id", "deals"."title", "deals"."amount_cents", "deals"."stage", "deals"."created_at", "deals"."updated_at", "deals"."deleted_at", "users"."team_id" AS "navree_through_key" FROM "deals" INNER JOIN "users" ON "users"."id" = "deals"."owner_id" INNER JOIN (SELECT "users"."team_id", MAX("deals"."id") AS "id_aggregate", MIN("deals"."amount_cents") AS "amount_cents_aggregate" FROM "deals" INNER JOIN "users" ON "users"."id" = "deals"."owner_id" INNER JOIN (SELECT "users"."team_id", MAX("deals"."amount_cents") AS "amount_cents_aggregate" FROM "deals" INNER JOIN "users" ON "users"."id" = "deals"."owner_id" WHERE "users"."team_id" = $1 AND "users"."deleted_at" IS NULL AND "deals"."deleted_at" IS NULL GROUP BY "users"."team_id") AS "biggest_deal" ON "biggest_deal"."amount_cents_aggregate" = "deals"."amount_cents" AND "biggest_deal"."team_id" = "users"."team_id" WHERE "users"."deleted_at" IS NULL AND "deals"."deleted_at" IS NULL GROUP BY "users"."team_id") AS "biggest_deal" ON "biggest_deal"."id_aggregate" = "deals"."id" AND "biggest_deal"."amount_cents_aggregate" = "deals"."amount_cents" AND "biggest_deal"."team_id" = "users"."team_id" WHERE "users"."deleted_at" IS NULL AND "deals"."deleted_at" IS NULL
  values: [I64(1)]
MySQL: SELECT `deals`.`id`, `deals`.`company_id`, `deals`.`owner_id`, `deals`.`title`, `deals`.`amount_cents`, `deals`.`stage`, `deals`.`created_at`, `deals`.`updated_at`, `deals`.`deleted_at`, `users`.`team_id` AS `navree_through_key` FROM `deals` INNER JOIN `users` ON `users`.`id` = `deals`.`owner_id` INNER JOIN (SELECT `users`.`team_id`, MAX(`deals`.`id`) AS `id_aggregate`, MIN(`deals`.`amount_cents`) AS `amount_cents_aggregate` FROM `deals` INNER JOIN `users` ON `users`.`id` = `deals`.`owner_id` INNER JOIN (SELECT `users`.`team_id`, MAX(`deals`.`amount_cents`) AS `amount_cents_aggregate` FROM `deals` INNER JOIN `users` ON `users`.`id` = `deals`.`owner_id` WHERE `users`.`team_id` = ? AND `users`.`deleted_at` IS NULL AND `deals`.`deleted_at` IS NULL GROUP BY `users`.`team_id`) AS `biggest_deal` ON `biggest_deal`.`amount_cents_aggregate` = `deals`.`amount_cents` AND `biggest_deal`.`team_id` = `users`.`team_id` WHERE `users`.`deleted_at` IS NULL AND `deals`.`deleted_at` IS NULL GROUP BY `users`.`team_id`) AS `biggest_deal` ON `biggest_deal`.`id_aggregate` = `deals`.`id` AND `biggest_deal`.`amount_cents_aggregate` = `deals`.`amount_cents` AND `biggest_deal`.`team_id` = `users`.`team_id` WHERE `users`.`deleted_at` IS NULL AND `deals`.`deleted_at` IS NULL
  values: [I64(1)]
