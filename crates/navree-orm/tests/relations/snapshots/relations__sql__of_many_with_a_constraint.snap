---
source: crates/navree-orm/tests/relations/sql.rs
expression: per_dialect(|dialect| deal().longest_call().to_sql(dialect))
---
PostgreSQL: SELECT "activities"."id", "activities"."deal_id", "activities"."kind", "activities"."minutes", "activities"."created_at", "activities"."updated_at" FROM "activities" INNER JOIN (SELECT "activities"."deal_id", MAX("activities"."id") AS "id_aggregate", MIN("activities"."minutes") AS "minutes_aggregate" FROM "activities" INNER JOIN (SELECT "activities"."deal_id", MAX("activities"."minutes") AS "minutes_aggregate" FROM "activities" WHERE "activities"."deal_id" = $1 AND "activities"."deal_id" IS NOT NULL AND "activities"."kind" = $2 GROUP BY "activities"."deal_id") AS "longest_call" ON "longest_call"."minutes_aggregate" = "activities"."minutes" AND "longest_call"."deal_id" = "activities"."deal_id" WHERE "activities"."kind" = $3 GROUP BY "activities"."deal_id") AS "longest_call" ON "longest_call"."id_aggregate" = "activities"."id" AND "longest_call"."minutes_aggregate" = "activities"."minutes" AND "longest_call"."deal_id" = "activities"."deal_id"
  values: [BigInt(Some(7)), String(Some("call")), String(Some("call"))]
MySQL: SELECT `activities`.`id`, `activities`.`deal_id`, `activities`.`kind`, `activities`.`minutes`, `activities`.`created_at`, `activities`.`updated_at` FROM `activities` INNER JOIN (SELECT `activities`.`deal_id`, MAX(`activities`.`id`) AS `id_aggregate`, MIN(`activities`.`minutes`) AS `minutes_aggregate` FROM `activities` INNER JOIN (SELECT `activities`.`deal_id`, MAX(`activities`.`minutes`) AS `minutes_aggregate` FROM `activities` WHERE `activities`.`deal_id` = ? AND `activities`.`deal_id` IS NOT NULL AND `activities`.`kind` = ? GROUP BY `activities`.`deal_id`) AS `longest_call` ON `longest_call`.`minutes_aggregate` = `activities`.`minutes` AND `longest_call`.`deal_id` = `activities`.`deal_id` WHERE `activities`.`kind` = ? GROUP BY `activities`.`deal_id`) AS `longest_call` ON `longest_call`.`id_aggregate` = `activities`.`id` AND `longest_call`.`minutes_aggregate` = `activities`.`minutes` AND `longest_call`.`deal_id` = `activities`.`deal_id`
  values: [BigInt(Some(7)), String(Some("call")), String(Some("call"))]
SQLite: SELECT "activities"."id", "activities"."deal_id", "activities"."kind", "activities"."minutes", "activities"."created_at", "activities"."updated_at" FROM "activities" INNER JOIN (SELECT "activities"."deal_id", MAX("activities"."id") AS "id_aggregate", MIN("activities"."minutes") AS "minutes_aggregate" FROM "activities" INNER JOIN (SELECT "activities"."deal_id", MAX("activities"."minutes") AS "minutes_aggregate" FROM "activities" WHERE "activities"."deal_id" = ? AND "activities"."deal_id" IS NOT NULL AND "activities"."kind" = ? GROUP BY "activities"."deal_id") AS "longest_call" ON "longest_call"."minutes_aggregate" = "activities"."minutes" AND "longest_call"."deal_id" = "activities"."deal_id" WHERE "activities"."kind" = ? GROUP BY "activities"."deal_id") AS "longest_call" ON "longest_call"."id_aggregate" = "activities"."id" AND "longest_call"."minutes_aggregate" = "activities"."minutes" AND "longest_call"."deal_id" = "activities"."deal_id"
  values: [BigInt(Some(7)), String(Some("call")), String(Some("call"))]
