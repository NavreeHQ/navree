---
source: crates/navree-orm/tests/relations/sql.rs
expression: per_dialect(|dialect| deal().latest_activity().to_sql(dialect))
---
PostgreSQL: SELECT "activities"."id", "activities"."deal_id", "activities"."kind", "activities"."minutes", "activities"."created_at", "activities"."updated_at" FROM "activities" INNER JOIN (SELECT "activities"."deal_id", MAX("activities"."id") AS "id_aggregate" FROM "activities" WHERE "activities"."deal_id" = $1 AND "activities"."deal_id" IS NOT NULL GROUP BY "activities"."deal_id") AS "latest_activity" ON "latest_activity"."id_aggregate" = "activities"."id" AND "latest_activity"."deal_id" = "activities"."deal_id"
  values: [BigInt(Some(7))]
MySQL: SELECT `activities`.`id`, `activities`.`deal_id`, `activities`.`kind`, `activities`.`minutes`, `activities`.`created_at`, `activities`.`updated_at` FROM `activities` INNER JOIN (SELECT `activities`.`deal_id`, MAX(`activities`.`id`) AS `id_aggregate` FROM `activities` WHERE `activities`.`deal_id` = ? AND `activities`.`deal_id` IS NOT NULL GROUP BY `activities`.`deal_id`) AS `latest_activity` ON `latest_activity`.`id_aggregate` = `activities`.`id` AND `latest_activity`.`deal_id` = `activities`.`deal_id`
  values: [BigInt(Some(7))]
SQLite: SELECT "activities"."id", "activities"."deal_id", "activities"."kind", "activities"."minutes", "activities"."created_at", "activities"."updated_at" FROM "activities" INNER JOIN (SELECT "activities"."deal_id", MAX("activities"."id") AS "id_aggregate" FROM "activities" WHERE "activities"."deal_id" = ? AND "activities"."deal_id" IS NOT NULL GROUP BY "activities"."deal_id") AS "latest_activity" ON "latest_activity"."id_aggregate" = "activities"."id" AND "latest_activity"."deal_id" = "activities"."deal_id"
  values: [BigInt(Some(7))]
