---
source: crates/navree-orm/tests/relations/sql.rs
expression: "query(Note::query().doesnt_have_morph(\"notable\",\nnavree_orm::relations::MorphTypes::named([\"deal\"])))"
---
PostgreSQL: SELECT "notes"."id", "notes"."notable_type", "notes"."notable_id", "notes"."body" FROM "notes" WHERE "notes"."notable_type" = $1 AND NOT EXISTS (SELECT 1 FROM "deals" WHERE "notes"."notable_id" = "deals"."id" AND "deals"."deleted_at" IS NULL)
  values: [String("deal")]
MySQL: SELECT `notes`.`id`, `notes`.`notable_type`, `notes`.`notable_id`, `notes`.`body` FROM `notes` WHERE `notes`.`notable_type` = ? AND NOT EXISTS (SELECT 1 FROM `deals` WHERE `notes`.`notable_id` = `deals`.`id` AND `deals`.`deleted_at` IS NULL)
  values: [String("deal")]
SQLite: SELECT "notes"."id", "notes"."notable_type", "notes"."notable_id", "notes"."body" FROM "notes" WHERE "notes"."notable_type" = ? AND NOT EXISTS (SELECT 1 FROM "deals" WHERE "notes"."notable_id" = "deals"."id" AND "deals"."deleted_at" IS NULL)
  values: [String("deal")]
