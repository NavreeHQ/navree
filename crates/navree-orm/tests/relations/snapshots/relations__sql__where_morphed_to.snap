PostgreSQL: SELECT "notes"."id", "notes"."notable_type", "notes"."notable_id", "notes"."body" FROM "notes" WHERE "notes"."notable_type" = $1 AND "notes"."notable_id" IN ($2)
  values: [String(Some("deal")), BigInt(Some(7))]
