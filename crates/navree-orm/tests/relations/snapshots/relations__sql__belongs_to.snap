PostgreSQL: SELECT "companies"."id", "companies"."parent_id", "companies"."owner_id", "companies"."name", "companies"."active", "companies"."created_at", "companies"."updated_at" FROM "companies" WHERE "companies"."id" = $1
  values: [BigInt(Some(3))]
MySQL: SELECT `companies`.`id`, `companies`.`parent_id`, `companies`.`owner_id`, `companies`.`name`, `companies`.`active`, `companies`.`created_at`, `companies`.`updated_at` FROM `companies` WHERE `companies`.`id` = ?
  values: [BigInt(Some(3))]
SQLite: SELECT "companies"."id", "companies"."parent_id", "companies"."owner_id", "companies"."name", "companies"."active", "companies"."created_at", "companies"."updated_at" FROM "companies" WHERE "companies"."id" = ?
  values: [BigInt(Some(3))]
