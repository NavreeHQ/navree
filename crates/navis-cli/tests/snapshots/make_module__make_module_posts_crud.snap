==> posts/mod.rs <==
//! The posts module: the `posts` table, its service and its JSON
//! API under `/api/v1/posts`.
//!
//! ```text
//! posts/
//! ├── mod.rs           # PostsModule: what the module provides and imports
//! ├── controller.rs    # PostController: the HTTP routes
//! ├── service.rs       # PostService: the business logic
//! ├── entity.rs        # the `posts` table (SeaORM entity)
//! ├── dto.rs           # request bodies and their validation rules
//! ├── migrations/      # migrations owned by this module
//! └── tests/           # tests on a fresh database
//! ```

mod controller;
pub mod dto;
pub mod entity;
mod migrations;
mod service;
#[cfg(test)]
mod tests;

use navis::access::AccessModule;
use navis::db::ModuleBuilderDbExt;
use navis::kernel::ModuleBuilder;
use navis::module;

pub use controller::PostController;
pub use entity::Post;
pub use service::PostService;

/// Posts: CRUD under `/api/v1/posts`.
///
/// Every route checks the caller's abilities on `Post`. Grant them
/// with permissions (`posts.read`, `.create`, `.update`, `.delete`, or
/// `posts.manage` for all) or with rules in the app's abilities function.
#[module(
    imports = [AccessModule::for_feature::<entity::Entity>()],
    providers = [PostService],
    controllers = [PostController],
    exports = [PostService],
    register = Self::wire,
)]
pub struct PostsModule;

impl PostsModule {
    /// Registrations `#[module]` has no key for (migrations, jobs,
    /// listeners, commands, templates). `navis make:*` adds its lines above
    /// the `navis:wire` marker.
    fn wire(&self, m: &mut ModuleBuilder) {
        m.migrations(migrations::migrations());
        // navis:wire
    }
}

==> posts/controller.rs <==
//! The posts JSON API: `/api/v1/posts`.

use std::sync::Arc;

use navis::access::{Accessible, Authorized, Create, Delete, Read, Update};
use navis::db::{Page, PageQuery, Uow};
use navis::http::{Created, Json, NoContent, Result};
use navis::validation::Valid;
use navis::{controller, injectable};

use super::dto::{CreatePost, UpdatePost};
use super::entity::{Model, Post};
use super::service::PostService;

/// The routes of the posts resource. Each one checks the
/// caller's abilities on `Post` before the handler runs; routes with
/// `from = "id"` load the record first (404 when it does not exist).
#[injectable]
pub struct PostController {
    posts: Arc<PostService>,
}

#[controller("/posts", version = "1")]
impl PostController {
    /// Lists the posts the user may read, newest first
    /// (`?page=2&per_page=50`).
    #[get("/")]
    #[can(Read, Post)]
    async fn index(
        &self,
        uow: Uow,
        scope: Accessible<Post, Read>,
        page: PageQuery,
    ) -> Result<Page<Model>> {
        Ok(self.posts.list(&uow, scope, page).await?)
    }

    /// Shows one post.
    #[get("/{id}")]
    #[can(Read, Post, from = "id")]
    async fn show(&self, post: Authorized<Post, Read>) -> Json<Model> {
        Json(post.into_inner())
    }

    /// Creates a post owned by the caller.
    #[post("/")]
    #[can(Create, Post)]
    async fn store(
        &self,
        uow: Uow,
        Valid(Json(input)): Valid<Json<CreatePost>>,
    ) -> Result<Created<Model>> {
        let post = self.posts.create(&uow, input).await?;
        Ok(Created(format!("/api/v1/posts/{}", post.id), post))
    }

    /// Updates the fields present in the body.
    #[patch("/{id}")]
    #[can(Update, Post, from = "id")]
    async fn update(
        &self,
        uow: Uow,
        post: Authorized<Post, Update>,
        Valid(Json(input)): Valid<Json<UpdatePost>>,
    ) -> Result<Json<Model>> {
        post.check_fields(&input.changed_fields())?;
        let post = self.posts.update(&uow, post.into_inner(), input).await?;
        Ok(Json(post))
    }

    /// Deletes a post.
    #[delete("/{id}")]
    #[can(Delete, Post, from = "id")]
    async fn destroy(&self, uow: Uow, post: Authorized<Post, Delete>) -> Result<NoContent> {
        self.posts.delete(&uow, post.into_inner()).await?;
        Ok(NoContent)
    }
}

==> posts/service.rs <==
//! The business logic of the posts module.

use chrono::Utc;
use navis::access::{Accessible, Read};
use navis::db::{Page, PageQuery, Repo, Uow, paginate};
use navis::injectable;
use sea_orm::{ActiveValue::Set, DbErr, EntityTrait, QueryOrder};
use uuid::Uuid;

use super::dto::{CreatePost, UpdatePost};
use super::entity::{ActiveModel, Column, Entity, Model};

/// Lists, creates, updates and deletes posts.
///
/// Writes go through `Repo` inside the caller's unit of work: they commit
/// with the request (or roll back with it) and record change events for the
/// audit log and change observers.
#[injectable]
pub struct PostService;

impl PostService {
    /// One page of the posts `scope` lets the user read, newest first.
    pub async fn list(
        &self,
        uow: &Uow,
        scope: Accessible<Entity, Read>,
        page: PageQuery,
    ) -> Result<Page<Model>, DbErr> {
        let select = scope.apply(Entity::find().order_by_desc(Column::CreatedAt));
        paginate(select, &*uow.tx().await?, page).await
    }

    /// Creates a post owned by the acting user.
    pub async fn create(&self, uow: &Uow, input: CreatePost) -> Result<Model, DbErr> {
        let now = Utc::now();
        let post = ActiveModel {
            id: Set(Uuid::now_v7()),
            owner_id: Set(uow.actor()),
            name: Set(input.name),
            created_at: Set(now),
            updated_at: Set(now),
        };
        Repo::<Entity>::insert(uow, post).await
    }

    /// Applies the fields present in `input`.
    pub async fn update(&self, uow: &Uow, post: Model, input: UpdatePost) -> Result<Model, DbErr> {
        let mut active: ActiveModel = post.into();
        if let Some(name) = input.name {
            active.name = Set(name);
        }
        active.updated_at = Set(Utc::now());
        Repo::<Entity>::update(uow, active).await
    }

    /// Deletes `post`.
    pub async fn delete(&self, uow: &Uow, post: Model) -> Result<(), DbErr> {
        Repo::<Entity>::delete(uow, post).await
    }
}

==> posts/entity.rs <==
//! The `posts` table.

use navis::access::Subject;
use sea_orm::entity::prelude::*;
use serde::Serialize;

/// A post. Serialized as is in API responses: keep secrets out
/// of it (or skip them with `#[serde(skip)]`).
#[derive(Clone, Debug, PartialEq, Eq, DeriveEntityModel, Serialize)]
#[sea_orm(table_name = "posts")]
pub struct Model {
    /// A UUID v7, so ids sort by creation time.
    #[sea_orm(primary_key, auto_increment = false)]
    pub id: Uuid,
    /// The user who created it (abilities can test `owner_id`).
    pub owner_id: Option<Uuid>,
    pub name: String,
    pub created_at: DateTimeUtc,
    pub updated_at: DateTimeUtc,
}

#[derive(Copy, Clone, Debug, EnumIter, DeriveRelation)]
pub enum Relation {}

impl ActiveModelBehavior for ActiveModel {}

/// The access subject: rules name it `Post`, permissions
/// `posts.<action>` (`posts.update`, `posts.manage`, ...).
impl Subject for Entity {
    const SUBJECT: &'static str = "Post";
    const PERMISSION_PREFIX: &'static str = "posts";
}

/// The subject in route attributes and extractors: `#[can(Read, Post)]`,
/// `Authorized<Post, Update>`.
pub type Post = Entity;

==> posts/dto.rs <==
//! Request bodies of the posts API, with their validation rules
//! (checked by the `Valid` extractor before the handler runs).

use garde::Validate;
use serde::Deserialize;

/// The body of `POST /api/v1/posts`.
#[derive(Debug, Deserialize, Validate)]
pub struct CreatePost {
    /// 1 to 255 characters.
    #[garde(length(min = 1, max = 255))]
    pub name: String,
}

/// The body of `PATCH /api/v1/posts/{id}`: only the fields present change.
#[derive(Debug, Deserialize, Validate)]
pub struct UpdatePost {
    /// 1 to 255 characters.
    #[garde(length(min = 1, max = 255))]
    pub name: Option<String>,
}

impl UpdatePost {
    /// The fields this update changes, for field-level ability checks.
    pub fn changed_fields(&self) -> Vec<&'static str> {
        let mut fields = Vec::new();
        if self.name.is_some() {
            fields.push("name");
        }
        fields
    }
}

