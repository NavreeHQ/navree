# Copy to `.env` (never commit `.env`). Each entry overrides config/app.toml:
# APP_<SECTION>__<KEY> sets <section>.<key>, e.g. APP_DATABASE__URL -> database.url.

# Encrypts data and signs tokens. Generate one with `navis key:generate`.
APP_KEY=

APP_HTTP__ADDR=127.0.0.1:8080
APP_DATABASE__URL=sqlite://storage/{{ crate_name }}.db?mode=rwc
APP_LOG__LEVEL=info

# Mail: "log" writes messages to the log; use smtps://user:pass@host:465 to send.
APP_MAIL__TRANSPORT=log
APP_MAIL__FROM="{{ title }} <hello@example.com>"
