//! The {{ words }} mail of the {{ module_words }} module.

use navis::mail::{MailError, Mailable, Message};
use navis::view::Views;
use serde_json::json;

/// The templates (`{{ name }}.html` and `{{ name }}.txt` next to this file),
/// registered by the module's `wire`. A file of the same name in a template
/// directory (`resources/views/{{ module }}/mail/`) overrides them.
pub const TEMPLATES: &[(&str, &str)] = &[
    ("{{ module }}/mail/{{ name }}.html", include_str!("{{ name }}.html")),
    ("{{ module }}/mail/{{ name }}.txt", include_str!("{{ name }}.txt")),
];

/// {{ title }}. Send it with `Mailer::send(&mail)`, or `Mailer::queue(&mail)`
/// to deliver it from a queue worker.
#[derive(Debug, Clone)]
pub struct {{ pascal }} {
    /// The recipient's address.
    pub to: String,
    /// The recipient's name.
    pub name: String,
}

impl Mailable for {{ pascal }} {
    fn build(&self, views: &Views) -> Result<Message, MailError> {
        let context = json!({ "name": self.name });
        Ok(Message::new()
            .to(&self.to)
            .subject("{{ title }}")
            .html(views.render("{{ module }}/mail/{{ name }}.html", &context)?)
            .text(views.render("{{ module }}/mail/{{ name }}.txt", &context)?))
    }
}
