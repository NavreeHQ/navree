{
  "about": "The shell's routes say how an address is presented when the link does not: a sheet, a cover with no chrome, outside the app, the first screen of the destination. Here the system has no back that leads to the first destination (Apple's way).",
  "config": {"back_to_first":false},
  "steps": [
    {
      "note": "The app starts and asks for its shell.",
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell arrives: its destinations, and the first one's first screen is asked for.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/shell-routes.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The first page.",
      "send": {"t":"response","request":2,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/dashboard.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":3,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell, asked again at once since the session may have changed unseen, names the person again.",
      "send": {"t":"response","request":3,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/shell-routes.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"select","destination":1},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":4,"method":"get","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":4,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/orders.json",
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"stream_open","stream":1,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      }
    },
    {
      "note": "The route for /orders/new says `sheet`.",
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/orders/new"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"fetch","request":5,"method":"get","url":"https://shop.example/orders/new","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":1}
        ]
      },
      "check": [
        {"at":"/modals","is":[{"locked":false,"present":"sheet","stack":[3]}]}
      ]
    },
    {
      "send": {"t":"response","request":5,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/order-new.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/3/chrome","is":true}
      ]
    },
    {
      "note": "The form's Cancel button: with nothing open on the screen, `dismiss` takes the sheet away.",
      "send": {"t":"act","screen":3,"action":{"t":"dismiss"},"form":"order-new"},
      "expect": {
        "changed": [
          {"t":"nav"}
        ],
        "effects": [
          {"t":"stream_open","stream":2,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      },
      "check": [
        {"at":"/modals","is":[]},
        {"at":"/front","is":2}
      ]
    },
    {
      "note": "The route for /help says `external`.",
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/help"}},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"open_url","url":"https://shop.example/help"}
        ]
      }
    },
    {
      "note": "The route for /sign-in says `full` and no chrome.",
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/sign-in"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":4}
        ],
        "effects": [
          {"t":"fetch","request":6,"method":"get","url":"https://shop.example/sign-in","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":2}
        ]
      },
      "check": [
        {"at":"/modals/0/present","is":"full"},
        {"at":"/modals/0/locked","is":false},
        {"at":"/screens/4/chrome","is":false}
      ]
    },
    {
      "send": {"t":"response","request":6,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/sign-in.json",
      "expect": {
        "changed": [
          {"t":"screen","id":4}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"back"},
      "expect": {
        "changed": [
          {"t":"nav"}
        ],
        "effects": [
          {"t":"stream_open","stream":3,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      },
      "check": [
        {"at":"/modals","is":[]}
      ]
    },
    {
      "note": "The route for /reports says `root`.",
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/reports"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":5}
        ],
        "effects": [
          {"t":"fetch","request":7,"method":"get","url":"https://shop.example/reports","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":3}
        ]
      },
      "check": [
        {"at":"/destinations/1/stack","is":[5]}
      ]
    },
    {
      "note": "What the link says wins over the route.",
      "send": {"t":"act","screen":5,"action":{"t":"navigate","href":"/orders/7","present":"sheet"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":6}
        ],
        "effects": [
          {"t":"fetch","request":8,"method":"get","url":"https://shop.example/orders/7","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/modals/0/present","is":"sheet"}
      ]
    },
    {
      "send": {"t":"back"},
      "expect": {
        "changed": [
          {"t":"nav"}
        ],
        "effects": [
          {"t":"cancel","request":8}
        ]
      }
    },
    {
      "note": "At the first screen of a destination that is not the first, this system's back has nowhere to lead: the system takes it.",
      "send": {"t":"back"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"exit"}
        ]
      },
      "check": [
        {"at":"/selected","is":1},
        {"at":"/can_go_back","is":false}
      ]
    }
  ]
}
