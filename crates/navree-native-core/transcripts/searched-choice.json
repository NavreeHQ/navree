{
  "about": "A choice whose options are searched on the server. The search is asked when the typing pauses, never for fewer characters than the control asks for. The answer is the field's because the request that asked was for it: the field in the answer has no name. An answer to an older search is dropped. More options are loaded by cursor.",
  "steps": [
    {
      "note": "The app starts and asks for its shell.",
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell arrives: its destinations, and the first one's first screen is asked for.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The first page.",
      "send": {"t":"response","request":2,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/assign.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      }
    },
    {
      "note": "One character: too few to search with.",
      "send": {"t":"options","screen":1,"field":"courier","text":"k"},
      "expect": {
        "changed": [],
        "effects": []
      }
    },
    {
      "note": "Two: the search waits for the typing to pause.",
      "send": {"t":"options","screen":1,"form":"assign","field":"courier","text":"ka"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"timer","timer":1,"ms":100}
        ]
      }
    },
    {
      "note": "A third character starts the pause again.",
      "send": {"t":"options","screen":1,"field":"courier","text":"kau"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"cancel_timer","timer":1},
          {"t":"timer","timer":2,"ms":100}
        ]
      }
    },
    {
      "note": "The pause. The search is asked.",
      "send": {"t":"timer","timer":2},
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"assign"}
        ],
        "effects": [
          {"t":"fetch","request":3,"method":"get","url":"https://shop.example/couriers/options?q=kau","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":60000}
        ]
      },
      "check": [
        {"at":"/screens/1/forms/assign/fields/courier/searching","is":true}
      ]
    },
    {
      "note": "The person takes a character back while the search is on its way.",
      "send": {"t":"options","screen":1,"field":"courier","text":"ka"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"timer","timer":3,"ms":100}
        ]
      }
    },
    {
      "note": "The new search is asked, and the old one is no longer wanted.",
      "send": {"t":"timer","timer":3},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"cancel","request":3},
          {"t":"fetch","request":4,"method":"get","url":"https://shop.example/couriers/options?q=ka","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":60000}
        ]
      }
    },
    {
      "note": "The older search answers late: it is dropped.",
      "send": {"t":"response","request":3,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/couriers-kau.json",
      "expect": {
        "changed": [],
        "effects": []
      },
      "check": [
        {"at":"/screens/1/forms/assign/fields/courier/options","is":null}
      ]
    },
    {
      "note": "The search that is wanted answers. The options are beside the field's value, and there are more.",
      "send": {"t":"response","request":4,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/couriers-ka.json",
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"assign"}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/1/forms/assign/fields/courier/options/1/label","is":"Kalsi Couriers, Jalandhar"},
        {"at":"/screens/1/forms/assign/fields/courier/more","is":true},
        {"at":"/screens/1/forms/assign/fields/courier/searching","is":null}
      ]
    },
    {
      "note": "The end of the options is near: the next ones are asked for.",
      "send": {"t":"options","screen":1,"field":"courier","more":true},
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"assign"}
        ],
        "effects": [
          {"t":"fetch","request":5,"method":"get","url":"https://shop.example/couriers/options?q=ka&after=c-4","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":60000}
        ]
      }
    },
    {
      "note": "They join the ones found. An option is never there twice, and nothing is after these.",
      "send": {"t":"response","request":5,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/couriers-ka-2.json",
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"assign"}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/1/forms/assign/fields/courier/options/2/label","is":"Kang Express, Patiala"},
        {"at":"/screens/1/forms/assign/fields/courier/options/3","is":null},
        {"at":"/screens/1/forms/assign/fields/courier/more","is":null}
      ]
    },
    {
      "note": "The person picks one.",
      "send": {"t":"field","screen":1,"form":"assign","field":"courier","value":{"t":"text","text":"c-8"}},
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"assign"}
        ],
        "effects": []
      }
    },
    {
      "note": "And it is sent as any choice is.",
      "send": {"t":"act","screen":1,"action":{"t":"submit"},"form":"assign"},
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"assign"}
        ],
        "effects": [
          {"t":"fetch","request":6,"method":"post","url":"https://shop.example/orders/1/assign","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":"_csrf=tk-91c2&courier=c-8"},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "send": {"t":"response","request":6,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/gift-saved.json",
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"assign"},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"message","id":1,"tone":"neutral","text":"Saved"}
        ]
      }
    },
    {
      "note": "The search is cleared: the control shows its own options again.",
      "send": {"t":"options","screen":1,"field":"courier","text":""},
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"assign"}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/1/forms/assign/fields/courier/options","is":null}
      ]
    }
  ]
}
