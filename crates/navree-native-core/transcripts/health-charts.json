      "send": {"t":"act","screen":1,"action":{"t":"request","method":"post","href":"/readings/sync"}},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":4,"method":"post","url":"https://shop.example/readings/sync","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":""},"timeout_ms":60000,"xsrf":true}
        ]
      }
