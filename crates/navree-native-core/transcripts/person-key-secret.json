{
  "about": "A client that gives the secret of its install is given keys made with it: `k2:` and then a keyed hash of the app's origin and the id the server names the person by. The same person has the same key at every launch of the install, another account of the same name has another, and no plain key leaves the core.",
  "config": {"secret":"0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20"},
  "steps": [
    {
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "Ravneet is named by id: her key is made from the origin and the id, under the secret.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json","headers":[["x-navree-person","0193a4b2-0000-7000-8000-00000000ra01"]]},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/app/user/key","is":"k2:17d27bf8db683479c652471e31c96ac7d03e690c41c4f94f56ca99de886e389e"},
        {"at":"/app/user_was","is":null}
      ]
    },
    {
      "note": "Another launch of the same install: she has the same key.",
      "restart": true,
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json","headers":[["x-navree-person","0193a4b2-0000-7000-8000-00000000ra01"]]},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/app/user/key","is":"k2:17d27bf8db683479c652471e31c96ac7d03e690c41c4f94f56ca99de886e389e"}
      ]
    },
    {
      "note": "A third launch: another account of the same name and email is signed in.",
      "restart": true,
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "Its key is another, though the name and the email are the same.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json","headers":[["x-navree-person","7f1c2a90-0001-4000-8000-00000000a001"]]},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/app/user/key","is":"k2:6bd1a2cdf43aaf682ec4d5da88fc8ca12d82976ffebb660e10e75f894e0c82d7"},
        {"at":"/app/user/name","is":"Ravneet Kaur"}
