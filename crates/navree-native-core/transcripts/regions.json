{
  "about": "Regions: parts of a screen that fetch themselves. One fetch of a region counts at a time; an answer asked for before a write is not drawn; a region that fails says so and can be asked again; a region that can't be drawn sends the whole page to the web view.",
  "steps": [
    {
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The first page holds a region that came empty and asks to be fetched once the screen is here, and that listens to a stream. Both are asked for.",
      "send": {"t":"response","request":2,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/overview.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":3,"method":"get","url":"https://shop.example/fragments/figures","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":15000},
          {"t":"stream_open","stream":1,"url":"https://shop.example/broadcasting/stream?topics=stats","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      },
      "check": [
        {"at":"/screens/1/regions/figures/loading","is":true},
        {"at":"/screens/1/content/screen/body/children/0/children","is":null}
      ]
    },
    {
      "note": "The region's answer is a screen. No region of that id is in it, so its body becomes what the region holds.",
      "send": {"t":"response","request":3,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/figures.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/1/regions/figures/loading","is":false},
        {"at":"/screens/1/content/screen/body/children/0/children/0/t","is":"grid"},
        {"at":"/screens/1/content/screen/body/children/0/children/0/children/0/title","is":"Revenue today"}
      ]
    },
    {
      "send": {"t":"act","screen":1,"action":{"t":"request","method":"post","href":"/recount"}},
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":4,"method":"post","url":"https://shop.example/recount","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":""},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "The answer's `invalidate` op has the region fetch itself again.",
      "send": {"t":"response","request":4,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/recount-done.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"fetch","request":5,"method":"get","url":"https://shop.example/fragments/figures","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":15000},
          {"t":"message","id":1,"tone":"success","text":"Counted again"}
        ]
      },
      "check": [
        {"at":"/screens/1/regions/figures/loading","is":true},
        {"at":"/messages/0/text","is":"Counted again"}
      ]
    },
    {
      "note": "The person taps again before the region has landed.",
      "send": {"t":"act","screen":1,"action":{"t":"request","method":"post","href":"/recount"}},
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":6,"method":"post","url":"https://shop.example/recount","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":""},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "A second `invalidate`: a newer fetch of the region begins, and the older one is no longer wanted.",
      "send": {"t":"response","request":6,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/recount-done.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"cancel","request":5},
          {"t":"fetch","request":7,"method":"get","url":"https://shop.example/fragments/figures","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":15000},
          {"t":"message","id":2,"tone":"success","text":"Counted again"}
        ]
      }
    },
    {
      "note": "The older answer arrives anyway. It changes nothing.",
      "send": {"t":"response","request":5,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/figures.json",
      "expect": {
        "changed": [],
        "effects": []
      }
    },
    {
      "note": "The newer one is drawn.",
      "send": {"t":"response","request":7,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/figures.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/1/regions/figures/loading","is":false}
      ]
    },
    {
      "note": "The region is asked again, and while it is out…",
      "send": {"t":"region_retry","screen":1,"region":"figures"},
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":8,"method":"get","url":"https://shop.example/fragments/figures","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":15000}
        ]
      }
    },
    {
      "note": "…something is written.",
      "send": {"t":"act","screen":1,"action":{"t":"request","method":"post","href":"/orders/1/resend"}},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":9,"method":"post","url":"https://shop.example/orders/1/resend","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":""},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "send": {"t":"response","request":9,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/resend-done.json",
      "expect": {
        "changed": [
          {"t":"messages"}
        ],
        "effects": [
          {"t":"message","id":3,"tone":"success","text":"The confirmation is on its way to tanvi.sharma36760@example.com"}
        ]
      }
    },
    {
      "note": "The region's answer was asked for before the write, so it may be from before it: it is not drawn, and the region is asked again.",
      "send": {"t":"response","request":8,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/figures.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":10,"method":"get","url":"https://shop.example/fragments/figures","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":15000}
        ]
      },
      "check": [
        {"at":"/screens/1/regions/figures/loading","is":true}
      ]
    },
    {
      "send": {"t":"response","request":10,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/figures.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/1/regions/figures/loading","is":false}
      ]
    },
    {
      "send": {"t":"region_retry","screen":1,"region":"figures"},
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":11,"method":"get","url":"https://shop.example/fragments/figures","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":15000}
        ]
      }
    },
    {
      "note": "A fetch that fails leaves what the region held, and says why.",
      "send": {"t":"response","request":11,"error":"timeout"},
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/1/regions/figures/failure","is":"timeout"},
        {"at":"/screens/1/content/screen/body/children/0/children/0/t","is":"grid"}
      ]
    },
    {
      "note": "The person asks again.",
      "send": {"t":"region_retry","screen":1,"region":"figures"},
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":12,"method":"get","url":"https://shop.example/fragments/figures","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":15000}
        ]
      },
      "check": [
        {"at":"/screens/1/regions/figures/failure","is":null},
        {"at":"/screens/1/regions/figures/loading","is":true}
      ]
    },
    {
      "send": {"t":"response","request":12,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/figures.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"act","screen":1,"action":{"t":"navigate","href":"/chart"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":13,"method":"get","url":"https://shop.example/chart","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":1}
        ]
      }
    },
    {
      "note": "A page whose region is a chart.",
      "send": {"t":"response","request":13,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/overview-chart.json",
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":14,"method":"get","url":"https://shop.example/fragments/sales","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":15000}
        ]
      }
    },
    {
      "note": "The region's answer says it can't be drawn natively. A page is never drawn with a hole in it: the whole page goes to the web view, with why.",
      "send": {"t":"response","request":14,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/sales.json",
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/2/content/t","is":"web"},
        {"at":"/screens/2/content/url","is":"https://shop.example/chart"},
        {"at":"/screens/2/content/why","is":["slot:chart"]}
      ]
    }
  ]
}
