{
  "about": "A field that does something as it changes. A switch sends its form as it flips. A text field runs commands with what it holds: here a count of the characters typed. A text field that sends its form waits for the typing to pause.",
  "steps": [
    {
      "note": "The app starts and asks for its shell.",
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell arrives: its destinations, and the first one's first screen is asked for.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The first page.",
      "send": {"t":"response","request":2,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/gift.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      }
    },
    {
      "note": "Gift wrap is switched on: the form is sent at once.",
      "send": {"t":"field","screen":1,"form":"gift","field":"wrap","value":{"t":"flag","on":true}},
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"gift"}
        ],
        "effects": [
          {"t":"fetch","request":3,"method":"post","url":"https://shop.example/orders/1/gift","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":"_csrf=tk-91c2&wrap=on&message=&coupon="},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "send": {"t":"response","request":3,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/gift-saved.json",
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"gift"},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"message","id":1,"tone":"neutral","text":"Saved"}
        ]
      }
    },
    {
      "note": "The count beside the message follows the typing. Nothing is sent.",
      "send": {"t":"field","screen":1,"form":"gift","field":"message","value":{"t":"text","text":"Lohri di lakh lakh vadhai"}},
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/1/content/screen/body/children/2/value","is":"25/160"}
      ]
    },
    {
      "note": "A coupon is typed. The form goes when the typing pauses, to the address the field names.",
      "send": {"t":"field","screen":1,"form":"gift","field":"coupon","value":{"t":"text","text":"LOH"}},
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"gift"}
        ],
        "effects": [
          {"t":"timer","timer":1,"ms":100}
        ]
      }
    },
    {
      "note": "Typing on starts the pause again.",
      "send": {"t":"field","screen":1,"form":"gift","field":"coupon","value":{"t":"text","text":"LOHRI"}},
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"gift"}
        ],
        "effects": [
          {"t":"cancel_timer","timer":1},
          {"t":"timer","timer":2,"ms":100}
        ]
      }
    },
    {
      "note": "The pause: one send, with everything the form holds now.",
      "send": {"t":"timer","timer":2},
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"gift"}
        ],
        "effects": [
          {"t":"fetch","request":4,"method":"post","url":"https://shop.example/orders/1/coupon","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":"_csrf=tk-91c2&wrap=on&message=Lohri+di+lakh+lakh+vadhai&coupon=LOHRI"},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "The first pause was called off: its timer changes nothing.",
      "send": {"t":"timer","timer":1},
      "expect": {
        "changed": [],
        "effects": []
      }
    },
    {
      "send": {"t":"response","request":4,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/gift-saved.json",
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"gift"},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"message","id":2,"tone":"neutral","text":"Saved"}
        ]
      }
    }
  ]
}
