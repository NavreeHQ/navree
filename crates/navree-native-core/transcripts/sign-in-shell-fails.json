{
  "about": "A shell request that fails after a sign-in leaves the locked cover up with the failure set on it (so the client shows its words and a way to try again) and asks for the shell again after a pause, or at once when the person tries again.",
  "steps": [
    {
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/shell-routes.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":2,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/home.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"refresh","screen":1},
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":3,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":3,"status":401,"content_type":"application/vnd.navree.native+json"},
      "body": "made/session-ended.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1},
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":4,"method":"get","url":"https://shop.example/sign-in?next=%2Forders%2F1","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":4,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/sign-in.json",
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"field","screen":2,"form":"sign-in","field":"sign-in.email","value":{"t":"text","text":"ravneet.kaur@example.com"}},
      "expect": {
        "changed": [
          {"t":"form","screen":2,"form":"sign-in"}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"field","screen":2,"form":"sign-in","field":"sign-in.password","value":{"t":"text","text":"right"}},
      "expect": {
        "changed": [
          {"t":"form","screen":2,"form":"sign-in"}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"act","screen":2,"action":{"t":"submit"},"form":"sign-in"},
      "expect": {
        "changed": [
          {"t":"form","screen":2,"form":"sign-in"}
        ],
        "effects": [
          {"t":"fetch","request":5,"method":"post","url":"https://shop.example/sign-in","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":"_csrf=an0n&email=ravneet.kaur%40example.com&password=right"},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "send": {"t":"response","request":5,"status":303,"location":"/"},
      "expect": {
        "changed": [
          {"t":"screen","id":1},
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":6,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/modals","is":[{"locked":true,"present":"full","stack":[2]}]},
        {"at":"/screens/1/content/t","is":"blank"},
        {"at":"/screens/2/loading","is":true},
        {"at":"/screens/2/failure","is":null}
      ]
    },
    {
      "note": "The shell request fails offline: the cover stays locked, carries the failure for the client to show with Try again, and schedules a retry.",
      "send": {"t":"response","request":6,"error":"offline"},
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"timer","timer":1,"ms":2000}
        ]
      },
      "check": [
        {"at":"/app/user","is":null},
        {"at":"/modals","is":[{"locked":true,"present":"full","stack":[2]}]},
        {"at":"/screens/1/content/t","is":"blank"},
        {"at":"/screens/2/loading","is":false},
        {"at":"/screens/2/failure","is":"offline"}
      ]
    },
    {
      "note": "The pause ends: the shell is asked again.",
      "send": {"t":"timer","timer":1},
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":7,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/screens/2/loading","is":true},
        {"at":"/screens/2/failure","is":null}
      ]
    },
    {
      "note": "A 503 fails the cover again, with a longer pause.",
      "send": {"t":"response","request":7,"status":503},
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"timer","timer":2,"ms":4000}
        ]
      },
      "check": [
        {"at":"/screens/2/loading","is":false},
        {"at":"/screens/2/failure","is":"server"}
      ]
    },
    {
      "note": "The person taps Try again on the cover: the waiting timer is cancelled and the shell is asked at once.",
      "send": {"t":"refresh","screen":2},
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"cancel_timer","timer":2},
          {"t":"fetch","request":8,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/screens/2/loading","is":true},
        {"at":"/screens/2/failure","is":null}
      ]
    },
    {
      "note": "The shell answers: the cover goes, Ravneet's screen comes back, and it refreshes.",
      "send": {"t":"response","request":8,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/shell-routes.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":9,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/app/user/name","is":"Ravneet Kaur"},
        {"at":"/modals","is":[]},
        {"at":"/screens/1/content/screen/title","is":"Overview"},
        {"at":"/screens/2","is":null}
      ]
    }
  ]
}
