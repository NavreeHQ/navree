{
  "about": "The system's back, a step at a time: it closes what is open on the screen, then pops a screen, then leads to the first destination, then leaves the app to the system.",
  "steps": [
    {
      "note": "The app starts and asks for its shell.",
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell arrives: its destinations, and the first one's first screen is asked for.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The first page.",
      "send": {"t":"response","request":2,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/dashboard.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"select","destination":1},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":3,"method":"get","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":3,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/orders.json",
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"stream_open","stream":1,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      }
    },
    {
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/orders/1"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"fetch","request":4,"method":"get","url":"https://shop.example/orders/1","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":1}
        ]
      }
    },
    {
      "send": {"t":"response","request":4,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/order.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"act","screen":3,"action":{"t":"navigate","href":"/orders/999999"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":4}
        ],
        "effects": [
          {"t":"fetch","request":5,"method":"get","url":"https://shop.example/orders/999999","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":5,"status":404,"content_type":"application/vnd.navree.native+json"},
      "body": "store/order-missing.json",
      "expect": {
        "changed": [
          {"t":"screen","id":4}
        ],
        "effects": []
      }
    },
    {
      "note": "The person jumps back two screens at once (a long press on back, where the system has one).",
      "send": {"t":"pop_to","screen":2},
      "expect": {
        "changed": [
          {"t":"nav"}
        ],
        "effects": [
          {"t":"stream_open","stream":2,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      },
      "check": [
        {"at":"/destinations/1/stack","is":[2]},
        {"at":"/screens/3","is":null},
        {"at":"/screens/4","is":null}
      ]
    },
    {
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/orders/1"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":5}
        ],
        "effects": [
          {"t":"fetch","request":6,"method":"get","url":"https://shop.example/orders/1","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":2}
        ]
      }
    },
    {
      "send": {"t":"response","request":6,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/order.json",
      "expect": {
        "changed": [
          {"t":"screen","id":5}
        ],
        "effects": []
      }
    },
    {
      "note": "The Refund button opens the refund dialog, which is part of the tree.",
      "send": {"t":"act","screen":5,"action":{"t":"commands","list":[{"c":"open","id":"refund"}]}},
      "expect": {
        "changed": [
          {"t":"screen","id":5}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/5/overlays","is":["refund"]},
        {"at":"/can_go_back","is":true}
      ]
    },
    {
      "note": "The person taps outside the dialog: the client says it was closed.",
      "send": {"t":"overlay","screen":5,"id":"refund","open":false},
      "expect": {
        "changed": [
          {"t":"screen","id":5}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/5/overlays","is":[]},
        {"at":"/can_go_back","is":true}
      ]
    },
    {
      "send": {"t":"act","screen":5,"action":{"t":"commands","list":[{"c":"open","id":"refund"}]}},
      "expect": {
        "changed": [
          {"t":"screen","id":5}
        ],
        "effects": []
      }
    },
    {
      "note": "Opened again, back closes it first.",
      "send": {"t":"back"},
      "expect": {
        "changed": [
          {"t":"screen","id":5}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/5/overlays","is":[]},
        {"at":"/front","is":5}
      ]
    },
    {
      "note": "Back pops the order.",
      "send": {"t":"back"},
      "expect": {
        "changed": [
          {"t":"nav"}
        ],
        "effects": [
          {"t":"stream_open","stream":3,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      },
      "check": [
        {"at":"/destinations/1/stack","is":[2]},
        {"at":"/front","is":2},
        {"at":"/can_go_back","is":true}
      ]
    },
    {
      "note": "At the first screen of another destination, back leads to the first destination.",
      "send": {"t":"back"},
      "expect": {
        "changed": [
          {"t":"nav"}
        ],
        "effects": [
          {"t":"stream_close","stream":3}
        ]
      },
      "check": [
        {"at":"/selected","is":0},
        {"at":"/front","is":1},
        {"at":"/can_go_back","is":false}
      ]
    },
    {
      "note": "With nothing left to go back to, the system takes the back.",
      "send": {"t":"back"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"exit"}
        ]
      }
    },
    {
      "send": {"t":"select","destination":1},
      "expect": {
        "changed": [
          {"t":"nav"}
        ],
        "effects": [
          {"t":"stream_open","stream":4,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      },
      "check": [
        {"at":"/front","is":2}
      ]
    },
    {
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/orders/1"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":6}
        ],
        "effects": [
          {"t":"fetch","request":7,"method":"get","url":"https://shop.example/orders/1","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":4}
        ]
      }
    },
    {
      "send": {"t":"response","request":7,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/order.json",
      "expect": {
        "changed": [
          {"t":"screen","id":6}
        ],
        "effects": []
      }
    },
    {
      "note": "A button whose action is `back` does what the system's back does.",
      "send": {"t":"act","screen":6,"action":{"t":"back"}},
      "expect": {
        "changed": [
          {"t":"nav"}
        ],
        "effects": [
          {"t":"stream_open","stream":5,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      },
      "check": [
        {"at":"/front","is":2}
      ]
    },
    {
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/orders/1"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":7}
        ],
        "effects": [
          {"t":"fetch","request":8,"method":"get","url":"https://shop.example/orders/1","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":5}
        ]
      }
    },
    {
      "note": "Choosing the destination in front again goes back to its first screen. The order's page was still on its way: it is no longer wanted.",
      "send": {"t":"select","destination":1},
      "expect": {
        "changed": [
          {"t":"nav"}
        ],
        "effects": [
          {"t":"cancel","request":8},
          {"t":"stream_open","stream":6,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      },
      "check": [
        {"at":"/destinations/1/stack","is":[2]}
      ]
    }
  ]
}
