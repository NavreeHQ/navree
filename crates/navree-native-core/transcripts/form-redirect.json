{
  "about": "A form on a sheet. Refused, its messages are shown, and one for a field the form does not have is still said. Accepted with a redirect to the page it made, the sheet goes and the new screen is stacked on what was under it.",
  "steps": [
    {
      "note": "The app starts and asks for its shell.",
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell arrives: its destinations, and the first one's first screen is asked for.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/shell-routes.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The first page.",
      "send": {"t":"response","request":2,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/dashboard.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"select","destination":1},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":3,"method":"get","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":3,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/orders.json",
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"stream_open","stream":1,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      }
    },
    {
      "note": "The route says /orders/new is a sheet.",
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/orders/new"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"fetch","request":4,"method":"get","url":"https://shop.example/orders/new","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":1}
        ]
      }
    },
    {
      "send": {"t":"response","request":4,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/order-new.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/3/forms/order-new/fields/order-new.express=1/value","is":{"on":false,"t":"flag"}}
      ]
    },
    {
      "note": "Create order, with nothing filled in. The form's token and the button's own pair go with it; the switch is off and sends nothing.",
      "send": {"t":"act","screen":3,"action":{"t":"submit","with":{"name":"intent","value":"create"}},"form":"order-new"},
      "expect": {
        "changed": [
          {"t":"form","screen":3,"form":"order-new"}
        ],
        "effects": [
          {"t":"fetch","request":5,"method":"post","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":"_csrf=t0k3n&customer=&note=&intent=create"},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "send": {"t":"response","request":5,"status":422,"content_type":"application/vnd.navree.native+json"},
      "body": "made/order-new-refused.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"message","id":1,"tone":"danger","text":"Add at least one item."},
          {"t":"announce","notice":"fields_need_attention","count":2}
        ]
      },
      "check": [
        {"at":"/screens/3/forms/order-new/fields/order-new.customer/errors","is":["Enter the customer's name."]},
        {"at":"/messages/0/text","is":"Add at least one item."},
        {"at":"/messages/0/tone","is":"danger"},
        {"at":"/screens/3/focus/target","is":"order-new.customer"}
      ]
    },
    {
      "send": {"t":"field","screen":3,"form":"order-new","field":"order-new.customer","value":{"t":"text","text":"Jasleen Kaur"}},
      "expect": {
        "changed": [
          {"t":"form","screen":3,"form":"order-new"}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"field","screen":3,"form":"order-new","field":"order-new.city","value":{"t":"text","text":"amritsar"}},
      "expect": {
        "changed": [
          {"t":"form","screen":3,"form":"order-new"}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"field","screen":3,"form":"order-new","field":"order-new.express=1","value":{"t":"flag","on":true}},
      "expect": {
        "changed": [
          {"t":"form","screen":3,"form":"order-new"}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"field","screen":3,"form":"order-new","field":"order-new.note","value":{"t":"text","text":"Ring the bell twice.\nLeave it with the guard."}},
      "expect": {
        "changed": [
          {"t":"form","screen":3,"form":"order-new"}
        ],
        "effects": []
      }
    },
    {
      "note": "Save draft: the other button of the same form, with its own pair.",
      "send": {"t":"act","screen":3,"action":{"t":"submit","with":{"name":"intent","value":"draft"}},"form":"order-new"},
      "expect": {
        "changed": [
          {"t":"form","screen":3,"form":"order-new"}
        ],
        "effects": [
          {"t":"fetch","request":6,"method":"post","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":"_csrf=t0k3n&customer=Jasleen+Kaur&city=amritsar&express=1&note=Ring+the+bell+twice.%0D%0ALeave+it+with+the+guard.&intent=draft"},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "An `errors` op with no fields clears the messages.",
      "send": {"t":"response","request":6,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/order-saved.json",
      "expect": {
        "changed": [
          {"t":"form","screen":3,"form":"order-new"},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"message","id":2,"tone":"success","text":"Draft saved"}
        ]
      },
      "check": [
        {"at":"/screens/3/forms/order-new/fields/order-new.customer/errors","is":[]},
        {"at":"/modals/0/stack","is":[3]}
      ]
    },
    {
      "send": {"t":"act","screen":3,"action":{"t":"submit","with":{"name":"intent","value":"create"}},"form":"order-new"},
      "expect": {
        "changed": [
          {"t":"form","screen":3,"form":"order-new"}
        ],
        "effects": [
          {"t":"fetch","request":7,"method":"post","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":"_csrf=t0k3n&customer=Jasleen+Kaur&city=amritsar&express=1&note=Ring+the+bell+twice.%0D%0ALeave+it+with+the+guard.&intent=create"},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "The server answers the post with a redirect, as it answers a browser without scripts. The transport hands it over as it came; the core sees that it stays inside and asks for where it leads, as a plain get.",
      "send": {"t":"response","request":7,"status":303,"location":"/orders/1"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":8,"method":"get","url":"https://shop.example/orders/1","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":60000}
        ]
      }
    },
    {
      "note": "The new order's page, from another address than the post went to. The sheet has done its work and goes; the order is stacked on the orders.",
      "send": {"t":"response","request":8,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/order.json",
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":4}
        ],
        "effects": []
      },
      "check": [
        {"at":"/modals","is":[]},
        {"at":"/destinations/1/stack","is":[2,4]},
        {"at":"/screens/4/url","is":"/orders/1"},
        {"at":"/screens/4/content/screen/title","is":"Order CS-20481"},
        {"at":"/screens/3","is":null},
        {"at":"/front","is":4}
      ]
    }
  ]
}
