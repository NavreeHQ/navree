      "send": {"t":"act","screen":5,"action":{"t":"submit"},"form":"return"},
      "expect": {
        "changed": [
          {"t":"form","screen":5,"form":"return"}
        ],
        "effects": [
          {"t":"fetch","request":10,"method":"post","url":"https://shop.example/orders/1/returns","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":"_csrf=t0k3n&reason=The+zari+has+come+loose+at+one+corner."},"timeout_ms":60000,"xsrf":true}
        ]
      }
