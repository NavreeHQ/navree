      "send": {"t":"act","screen":4,"action":{"t":"request","method":"post","href":"/orders/1/copy"}},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":12,"method":"post","url":"https://shop.example/orders/1/copy","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":""},"timeout_ms":60000,"xsrf":true}
