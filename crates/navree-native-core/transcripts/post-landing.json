        "effects": [
          {"t":"fetch","request":17,"method":"get","url":"https://shop.example/orders/3","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
