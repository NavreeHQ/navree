      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":7,"method":"post","url":"https://shop.example/orders/1/shared","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00; caps=share+clipboard+open_url+confirm"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":"_call=tk_7f3a9c&outcome=cancelled"},"timeout_ms":60000,"xsrf":true}
        ]
