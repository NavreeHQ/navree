        ],
        "effects": [
          {"t":"fetch","request":3,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00; caps=share+clipboard+open_url+confirm"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
