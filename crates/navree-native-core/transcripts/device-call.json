  "steps": [
    {
      "note": "The app starts and asks for its shell.",
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00; caps=share+clipboard+open_url+confirm"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell arrives: its destinations, and the first one's first screen is asked for.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
