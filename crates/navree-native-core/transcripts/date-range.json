{
  "about": "A range of dates is one field with two ends. Each end is sent under its own name, and a message for either end is shown at the field.",
  "steps": [
    {
      "note": "The app starts and asks for its shell.",
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell arrives: its destinations, and the first one's first screen is asked for.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The first page.",
      "send": {"t":"response","request":2,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/report.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      }
    },
    {
      "note": "The person picks an end before the start.",
      "send": {"t":"field","screen":1,"form":"report","field":"period","value":{"t":"range","from":"2026-11-10","to":"2026-11-03"}},
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"report"}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/1/forms/report/fields/period/value","is":{"from":"2026-11-10","t":"range","to":"2026-11-03"}}
      ]
    },
    {
      "note": "A value of another kind is not taken for a range.",
      "send": {"t":"field","screen":1,"form":"report","field":"period","value":{"t":"text","text":"2026-11-10"}},
      "expect": {
        "changed": [],
        "effects": []
      },
      "check": [
        {"at":"/screens/1/forms/report/fields/period/value","is":{"from":"2026-11-10","t":"range","to":"2026-11-03"}}
      ]
    },
    {
      "send": {"t":"act","screen":1,"action":{"t":"submit"},"form":"report"},
      "expect": {
        "changed": [
          {"t":"form","screen":1,"form":"report"}
        ],
        "effects": [
          {"t":"fetch","request":3,"method":"post","url":"https://shop.example/reports/sales","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":"_csrf=tk-91c2&from=2026-11-10&to=2026-11-03"},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "The server refuses the end. The message is at the one field.",
      "send": {"t":"response","request":3,"status":422,"content_type":"application/vnd.navree.native+json"},
      "body": "made/report-refused.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"announce","notice":"fields_need_attention","count":1}
        ]
      },
      "check": [
        {"at":"/screens/1/forms/report/fields/period/errors","is":["The end can't be before the start."]},
        {"at":"/screens/1/focus/target","is":"period"}
      ]
    }
  ]
}
