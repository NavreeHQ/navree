{
  "about": "Answers nobody waits for any more. A response to a request the person has navigated away from changes nothing on screen: it is dropped, or, when it answers a write, it says what it has to say and takes the person nowhere.",
  "steps": [
    {
      "note": "The app starts and asks for its shell.",
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell arrives: its destinations, and the first one's first screen is asked for.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The first page.",
      "send": {"t":"response","request":2,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/dashboard.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":3,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell, asked again at once since the session may have changed unseen, names the person again.",
      "send": {"t":"response","request":3,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"select","destination":1},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":4,"method":"get","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":4,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/orders.json",
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"stream_open","stream":1,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      }
    },
    {
      "note": "The person taps an order…",
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/orders/1"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"fetch","request":5,"method":"get","url":"https://shop.example/orders/1","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":1}
        ]
      }
    },
    {
      "note": "…and goes back before it has loaded. The request is no longer wanted.",
      "send": {"t":"back"},
      "expect": {
        "changed": [
          {"t":"nav"}
        ],
        "effects": [
          {"t":"cancel","request":5},
          {"t":"stream_open","stream":2,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      },
      "check": [
        {"at":"/destinations/1/stack","is":[2]}
      ]
    },
    {
      "note": "Its answer arrives anyway. Nothing changes.",
      "send": {"t":"response","request":5,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/order.json",
      "expect": {
        "changed": [],
        "effects": []
      },
      "check": [
        {"at":"/destinations/1/stack","is":[2]},
        {"at":"/screens/3","is":null}
      ]
    },
    {
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/orders/1"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":4}
        ],
        "effects": [
          {"t":"fetch","request":6,"method":"get","url":"https://shop.example/orders/1","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":2}
        ]
      }
    },
    {
      "send": {"t":"response","request":6,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/order.json",
      "expect": {
        "changed": [
          {"t":"screen","id":4}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"refresh","screen":4},
      "expect": {
        "changed": [
          {"t":"screen","id":4}
        ],
        "effects": [
          {"t":"fetch","request":7,"method":"get","url":"https://shop.example/orders/1","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "A second refresh before the first has landed: the first is no longer wanted.",
      "send": {"t":"refresh","screen":4},
      "expect": {
        "changed": [
          {"t":"screen","id":4}
        ],
        "effects": [
          {"t":"cancel","request":7},
          {"t":"fetch","request":8,"method":"get","url":"https://shop.example/orders/1","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The first one's answer changes nothing.",
      "send": {"t":"response","request":7,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/order.json",
      "expect": {
        "changed": [],
        "effects": []
      },
      "check": [
        {"at":"/screens/4/loading","is":true}
      ]
    },
    {
      "send": {"t":"response","request":8,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/order.json",
      "expect": {
        "changed": [
          {"t":"screen","id":4}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/4/loading","is":false}
      ]
    },
    {
      "send": {"t":"act","screen":4,"action":{"t":"commands","list":[{"c":"open","id":"refund"}]}},
      "expect": {
        "changed": [
          {"t":"screen","id":4}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"field","screen":4,"form":"refund","field":"refund-amount","value":{"t":"text","text":"10"}},
      "expect": {
        "changed": [
          {"t":"form","screen":4,"form":"refund"}
        ],
        "effects": []
      }
    },
    {
      "note": "The person sends a refund…",
      "send": {"t":"act","screen":4,"action":{"t":"submit"},"form":"refund","overlay":"refund"},
      "expect": {
        "changed": [
          {"t":"form","screen":4,"form":"refund"}
        ],
        "effects": [
          {"t":"fetch","request":9,"method":"post","url":"https://shop.example/orders/1/refund","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":"amount=10&reason=returned"},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "send": {"t":"back"},
      "expect": {
        "changed": [
          {"t":"screen","id":4}
        ],
        "effects": []
      }
    },
    {
      "note": "…and leaves the order before the answer is here.",
      "send": {"t":"back"},
      "expect": {
        "changed": [
          {"t":"nav"}
        ],
        "effects": [
          {"t":"stream_open","stream":3,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      },
      "check": [
        {"at":"/front","is":2},
        {"at":"/screens/4","is":null}
      ]
    },
    {
      "note": "The answer to a write is still wanted, for what it says: the refund went through. Its screen is gone, so its ops change nothing; its toast is shown; and the orders, which may now be out of date, are fetched again.",
      "send": {"t":"response","request":9,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/refund-done.json",
      "expect": {
        "changed": [
          {"t":"screen","id":2},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"message","id":1,"tone":"success","text":"Refunded ₹10.00"},
          {"t":"fetch","request":10,"method":"get","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/messages/0/text","is":"Refunded ₹10.00"},
        {"at":"/front","is":2},
        {"at":"/screens/2/loading","is":true}
      ]
    },
    {
      "send": {"t":"response","request":10,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/orders.json",
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/board"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":5}
        ],
        "effects": [
          {"t":"fetch","request":11,"method":"get","url":"https://shop.example/board","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":3}
        ]
      }
    },
    {
      "send": {"t":"response","request":11,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/board.json",
      "expect": {
        "changed": [
          {"t":"screen","id":5}
        ],
        "effects": []
      }
    },
    {
      "note": "The person runs something on the board…",
      "send": {"t":"act","screen":5,"action":{"t":"request","method":"post","href":"/board/run"}},
      "expect": {
        "changed": [
          {"t":"screen","id":5}
        ],
        "effects": [
          {"t":"fetch","request":12,"method":"post","url":"https://shop.example/board/run","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":""},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "…and moves on to another screen.",
      "send": {"t":"act","screen":5,"action":{"t":"navigate","href":"/guide"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":6}
        ],
        "effects": [
          {"t":"fetch","request":13,"method":"get","url":"https://shop.example/guide","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The answer says to navigate. The person is no longer on the screen that asked: they are taken nowhere.",
      "send": {"t":"response","request":12,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/board-ops-4.json",
      "expect": {
        "changed": [
          {"t":"screen","id":5}
        ],
        "effects": []
      },
      "check": [
        {"at":"/front","is":6},
        {"at":"/destinations/1/stack","is":[2,5,6]}
      ]
    }
  ]
}
