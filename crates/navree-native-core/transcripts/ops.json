{
  "about": "Every op the server can send, applied in order to the screen that asked.",
  "steps": [
    {
      "note": "The app starts and asks for its shell.",
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell arrives: its destinations, and the first one's first screen is asked for.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The first page.",
      "send": {"t":"response","request":2,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/dashboard.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"select","destination":1},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":3,"method":"get","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":3,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/orders.json",
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"stream_open","stream":1,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      }
    },
    {
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/board"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"fetch","request":4,"method":"get","url":"https://shop.example/board","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":1}
        ]
      }
    },
    {
      "send": {"t":"response","request":4,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/board.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"act","screen":3,"action":{"t":"request","method":"post","href":"/board/run"}},
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"fetch","request":5,"method":"post","url":"https://shop.example/board/run","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":""},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "morph, replace, append (a row the list already has is passed over), prepend, remove, toast with a button, open, focus, url.",
      "send": {"t":"response","request":5,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/board-ops-1.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"message","id":1,"tone":"success","text":"Board updated","action":"Undo"}
        ]
      },
      "check": [
        {"at":"/screens/3/content/screen/body/children/0/value","is":"4 open"},
        {"at":"/screens/3/content/screen/body/children/1/children/0/id","is":"e0"},
        {"at":"/screens/3/content/screen/body/children/1/children/1/id","is":"e2"},
        {"at":"/screens/3/content/screen/body/children/1/children/2/id","is":"e3"},
        {"at":"/screens/3/content/screen/body/children/1/children/3","is":null},
        {"at":"/screens/3/forms/rename/fields/rename-name/value/text","is":"Diwali orders 2026"},
        {"at":"/messages/0/action","is":"Undo"},
        {"at":"/screens/3/overlays","is":["confirm"]},
        {"at":"/screens/3/focus/target","is":"rename-name"},
        {"at":"/screens/3/url","is":"/board?view=open"}
      ]
    },
    {
      "note": "The person taps the toast's button, which posts.",
      "send": {"t":"message_action","id":1},
      "expect": {
        "changed": [
          {"t":"messages"}
        ],
        "effects": [
          {"t":"fetch","request":6,"method":"post","url":"https://shop.example/board/undo","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":""},"timeout_ms":60000,"xsrf":true}
        ]
      },
      "check": [
        {"at":"/messages","is":[]}
      ]
    },
    {
      "note": "reload: the screen is fetched again, at the address the `url` op gave it.",
      "send": {"t":"response","request":6,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/board-ops-3.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"fetch","request":7,"method":"get","url":"https://shop.example/board?view=open","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/screens/3/loading","is":true}
      ]
    },
    {
      "note": "The same page again: what is open stays open.",
      "send": {"t":"response","request":7,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/board.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/3/overlays","is":["confirm"]},
        {"at":"/screens/3/content/screen/body/children/0/value","is":"3 open"}
      ]
    },
    {
      "send": {"t":"act","screen":3,"action":{"t":"request","method":"post","href":"/board/run"}},
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"fetch","request":8,"method":"post","url":"https://shop.example/board/run","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":""},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "close, open (a disclosure this time), invalidate (the region fetches itself again), toast, navigate_external.",
      "send": {"t":"response","request":8,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/board-ops-2.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"fetch","request":9,"method":"get","url":"https://shop.example/fragments/totals","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["x-navree-region","totals"]],"timeout_ms":15000},
          {"t":"message","id":2,"tone":"info","text":"Saved again"},
          {"t":"open_url","url":"https://pay.example/invoice/7"}
        ]
      },
      "check": [
        {"at":"/screens/3/overlays","is":[]},
        {"at":"/screens/3/content/screen/body/children/3/open","is":true},
        {"at":"/screens/3/regions/totals/loading","is":true},
        {"at":"/messages/0/text","is":"Saved again"}
      ]
    },
    {
      "note": "The region's answer is a screen whose body becomes what the region holds.",
      "send": {"t":"response","request":9,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/board-totals.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/3/regions/totals/loading","is":false},
        {"at":"/screens/3/content/screen/body/children/2/children/0/value","is":"₹33,10,004 today"}
      ]
    },
    {
      "send": {"t":"act","screen":3,"action":{"t":"request","method":"post","href":"/board/run"}},
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"fetch","request":10,"method":"post","url":"https://shop.example/board/run","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":""},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "navigate, after a send: the orders are already under this screen, so the stack goes back to them rather than stacking a copy, and they are fetched again.",
      "send": {"t":"response","request":10,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/board-ops-4.json",
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":11,"method":"get","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_open","stream":2,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      },
      "check": [
        {"at":"/destinations/1/stack","is":[2]},
        {"at":"/front","is":2},
        {"at":"/screens/2/loading","is":true},
        {"at":"/screens/3","is":null}
      ]
    }
  ]
}
