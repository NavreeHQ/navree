{
  "about": "Requests that fail. With nothing to show, the failure is the screen; with something on screen, it is a passing message and what was there stays. A write that fails is never sent again by itself, and nothing typed is lost.",
  "steps": [
    {
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell can't be fetched: the app could not start.",
      "send": {"t":"response","request":1,"error":"offline"},
      "expect": {
        "changed": [
          {"t":"nav"}
        ],
        "effects": []
      },
      "check": [
        {"at":"/stage","is":"failed"},
        {"at":"/failure","is":"offline"}
      ]
    },
    {
      "note": "The person taps Try again.",
      "send": {"t":"start"},
      "expect": {
        "changed": [
          {"t":"nav"}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/stage","is":"starting"},
        {"at":"/failure","is":null}
      ]
    },
    {
      "send": {"t":"response","request":2,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":3,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The first page times out. The screen has nothing to show, so the failure is what it shows.",
      "send": {"t":"response","request":3,"error":"timeout"},
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/1/failure","is":"timeout"},
        {"at":"/screens/1/content/t","is":"blank"},
        {"at":"/screens/1/loading","is":false},
        {"at":"/messages","is":[]}
      ]
    },
    {
      "note": "Try again.",
      "send": {"t":"refresh","screen":1},
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":4,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/screens/1/failure","is":null},
        {"at":"/screens/1/loading","is":true}
      ]
    },
    {
      "send": {"t":"response","request":4,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/dashboard.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"select","destination":1},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":5,"method":"get","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":5,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/orders.json",
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"stream_open","stream":1,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      }
    },
    {
      "send": {"t":"refresh","screen":2},
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":6,"method":"get","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "A refresh fails. The orders stay on screen, and a message says the server could not be reached.",
      "send": {"t":"response","request":6,"error":"offline"},
      "expect": {
        "changed": [
          {"t":"screen","id":2},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"message","id":1,"tone":"danger","notice":"offline"}
        ]
      },
      "check": [
        {"at":"/screens/2/content/t","is":"native"},
        {"at":"/screens/2/failure","is":"offline"},
        {"at":"/screens/2/refreshing","is":false},
        {"at":"/messages/0/notice","is":"offline"}
      ]
    },
    {
      "send": {"t":"message_shown","id":1},
      "expect": {
        "changed": [
          {"t":"messages"}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/orders/1"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"fetch","request":7,"method":"get","url":"https://shop.example/orders/1","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":1}
        ]
      }
    },
    {
      "send": {"t":"response","request":7,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/order.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"act","screen":3,"action":{"t":"commands","list":[{"c":"open","id":"refund"}]}},
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"field","screen":3,"form":"refund","field":"refund-amount","value":{"t":"text","text":"10"}},
      "expect": {
        "changed": [
          {"t":"form","screen":3,"form":"refund"}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"act","screen":3,"action":{"t":"submit"},"form":"refund","overlay":"refund"},
      "expect": {
        "changed": [
          {"t":"form","screen":3,"form":"refund"}
        ],
        "effects": [
          {"t":"fetch","request":8,"method":"post","url":"https://shop.example/orders/1/refund","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":"amount=10&reason=returned"},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "The post fails. The form stops waiting, keeps what was typed, and the person is told. Nothing is sent again until they say so.",
      "send": {"t":"response","request":8,"error":"offline"},
      "expect": {
        "changed": [
          {"t":"form","screen":3,"form":"refund"},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"message","id":2,"tone":"danger","notice":"offline"}
        ]
      },
      "check": [
        {"at":"/screens/3/forms/refund/pending","is":false},
        {"at":"/screens/3/forms/refund/fields/refund-amount/value/text","is":"10"},
        {"at":"/messages/0/notice","is":"offline"},
        {"at":"/screens/3/overlays","is":["refund"]}
      ]
    },
    {
      "note": "They tap Refund again.",
      "send": {"t":"act","screen":3,"action":{"t":"submit"},"form":"refund","overlay":"refund"},
      "expect": {
        "changed": [
          {"t":"form","screen":3,"form":"refund"}
        ],
        "effects": [
          {"t":"fetch","request":9,"method":"post","url":"https://shop.example/orders/1/refund","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":"amount=10&reason=returned"},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "The server answers 500 with a page of markup. That is a failure, not a page to show.",
      "send": {"t":"response","request":9,"status":500,"content_type":"text/html"},
      "body": "made/legacy.html",
      "expect": {
        "changed": [
          {"t":"form","screen":3,"form":"refund"},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"message","id":3,"tone":"danger","notice":"failed"}
        ]
      },
      "check": [
        {"at":"/messages/1/notice","is":"failed"},
        {"at":"/screens/3/forms/refund/pending","is":false}
      ]
    }
  ]
}
