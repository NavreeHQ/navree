{
  "about": "A client that kept a person's key before it gave a secret says so with `old_key`. The person signed in then has that key said beside them, as `app.user_was`: when the key the client kept is that one, what it kept is this person's, and it keeps `user.key` in its place. Another account has its own said, which is not the one kept.",
  "config": {"old_key":true,"secret":"0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20"},
  "steps": [
    {
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "Ravneet, whose key the release before made plain: `user_was` is that key, as `person-key-steady.json` records it.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json","headers":[["x-navree-person","0193a4b2-0000-7000-8000-00000000ra01"]]},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/app/user/key","is":"k2:17d27bf8db683479c652471e31c96ac7d03e690c41c4f94f56ca99de886e389e"},
        {"at":"/app/user_was","is":"1c54d473261f6f17cb6193202ce56588716e85757946078ac43d03b22f93a35e"}
      ]
    },
    {
      "note": "Another launch, and another account of the same name and email.",
      "restart": true,
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "Its `user_was` is its own plain key, as `keep-person.json` records it, and not hers.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json","headers":[["x-navree-person","7f1c2a90-0001-4000-8000-00000000a001"]]},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/app/user/key","is":"k2:6bd1a2cdf43aaf682ec4d5da88fc8ca12d82976ffebb660e10e75f894e0c82d7"},
        {"at":"/app/user_was","is":"1bc3dcdc8ebf5d231237007ccc4903b602f64185813b65bc5b6d1f5f798fcab7"}
      ]
    }
  ]
}
