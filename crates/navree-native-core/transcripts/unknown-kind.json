{
  "about": "An app older than its server meets things it has never heard of. A node of an unknown kind is drawn from its `alt`; without one, the page is the web view's. An op it does not know is dropped and the screen fetched again. Never a crash, never a hole.",
  "steps": [
    {
      "note": "The app starts and asks for its shell.",
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell arrives: its destinations, and the first one's first screen is asked for.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The first page.",
      "send": {"t":"response","request":2,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/dashboard.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"select","destination":1},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":3,"method":"get","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":3,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/orders.json",
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"stream_open","stream":1,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      }
    },
    {
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/stock"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"fetch","request":4,"method":"get","url":"https://shop.example/stock","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":1}
        ]
      }
    },
    {
      "note": "A gauge this build has never heard of, with an `alt`; a field it does not know on a badge; a plugin view it does not have, with an `alt`. All of it is drawn.",
      "send": {"t":"response","request":4,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/future.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": []
      },
      "check": [
        {"at":"/screens/3/content/t","is":"native"},
        {"at":"/screens/3/content/screen/body/children/0/t","is":"progress"},
        {"at":"/screens/3/content/screen/body/children/1/text","is":"Low"},
        {"at":"/screens/3/content/screen/body/children/2/value","is":"Shelf 4, aisle 2"}
      ]
    },
    {
      "send": {"t":"act","screen":3,"action":{"t":"navigate","href":"/shawl"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":4}
        ],
        "effects": [
          {"t":"fetch","request":5,"method":"get","url":"https://shop.example/shawl","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "A kind with nothing to draw in its place: the page goes to the web view, and the core reports what it met.",
      "send": {"t":"response","request":5,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/future-no-alt.json",
      "expect": {
        "changed": [
          {"t":"screen","id":4}
        ],
        "effects": [
          {"t":"report","what":"kind","detail":"kind:hologram"}
        ]
      },
      "check": [
        {"at":"/screens/4/content/t","is":"web"},
        {"at":"/screens/4/content/why","is":["kind:hologram"]},
        {"at":"/screens/4/content/url","is":"https://shop.example/shawl"}
      ]
    },
    {
      "send": {"t":"act","screen":4,"action":{"t":"navigate","href":"/share"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":5}
        ],
        "effects": [
          {"t":"fetch","request":6,"method":"get","url":"https://shop.example/share","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "A value this build can't read in a kind it knows: nothing of the answer is trusted.",
      "send": {"t":"response","request":6,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/future-role.json",
      "expect": {
        "changed": [
          {"t":"screen","id":5}
        ],
        "effects": [
          {"t":"report","what":"decode","detail":"client:decode"}
        ]
      },
      "check": [
        {"at":"/screens/5/content/t","is":"web"},
        {"at":"/screens/5/content/why","is":["client:decode"]}
      ]
    },
    {
      "send": {"t":"pop_to","screen":3},
      "expect": {
        "changed": [
          {"t":"nav"}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"act","screen":3,"action":{"t":"request","method":"post","href":"/stock/count"}},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":7,"method":"post","url":"https://shop.example/stock/count","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":""},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "An op this build does not know is dropped; the ones it knows apply; and the screen is fetched again, since what it shows may now be out of date.",
      "send": {"t":"response","request":7,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/future-ops.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"message","id":1,"tone":"neutral","text":"Saved"},
          {"t":"fetch","request":8,"method":"get","url":"https://shop.example/stock","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/messages/0/text","is":"Saved"},
        {"at":"/screens/3/loading","is":true}
      ]
    }
  ]
}
