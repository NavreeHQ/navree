{
  "about": "Signing in with another site. That can't run in a fetch or a web view: the core asks for the system's sign-in session at the address that starts it, and reads the address the session comes back with like a link from outside.",
  "config": {"sign_in":{"callback":"charkha","paths":["/auth/*"]}},
  "steps": [
    {
      "note": "The app starts and asks for its shell.",
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell arrives: its destinations, and the first one's first screen is asked for.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/shell-routes.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The first page.",
      "send": {"t":"response","request":2,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/dashboard.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"act","screen":1,"action":{"t":"navigate","href":"/sign-in"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":3,"method":"get","url":"https://shop.example/sign-in","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":3,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/sign-in.json",
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": []
      }
    },
    {
      "note": "\"Sign in with Google\" leads to an address the app's build named as the start of a sign-in. Nothing is fetched: the system's session is asked for.",
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/auth/google"}},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"sign_in","url":"https://shop.example/auth/google","callback":"charkha"}
        ]
      }
    },
    {
      "note": "The person closes the session without signing in. Nothing changes.",
      "send": {"t":"sign_in_done"},
      "expect": {
        "changed": [],
        "effects": []
      }
    },
    {
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/auth/google"}},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"sign_in","url":"https://shop.example/auth/google","callback":"charkha"}
        ]
      }
    },
    {
      "note": "The session comes back on the app's own scheme. Who is signed in has changed: the shell is asked for again and every screen is out of date. The address it came back with is a destination, which is selected.",
      "send": {"t":"sign_in_done","url":"charkha://orders"},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"fetch","request":4,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"fetch","request":5,"method":"get","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/modals","is":[]},
        {"at":"/selected","is":1},
        {"at":"/front","is":3}
      ]
    },
    {
      "send": {"t":"response","request":4,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/shell-routes.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"response","request":5,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/orders.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"stream_open","stream":1,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      }
    }
  ]
}
