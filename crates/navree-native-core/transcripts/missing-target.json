{
  "about": "An op or a command whose target is not on the screen is skipped, and the ones after it still apply. So is one whose target is of a kind it can't mean.",
  "steps": [
    {
      "note": "The app starts and asks for its shell.",
      "send": {"t":"start"},
      "expect": {
        "changed": [],
        "effects": [
          {"t":"fetch","request":1,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The shell arrives: its destinations, and the first one's first screen is asked for.",
      "send": {"t":"response","request":1,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/shell.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":1}
        ],
        "effects": [
          {"t":"fetch","request":2,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "note": "The first page.",
      "send": {"t":"response","request":2,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/dashboard.json",
      "expect": {
        "changed": [
          {"t":"screen","id":1}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"select","destination":1},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"fetch","request":3,"method":"get","url":"https://shop.example/orders","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      }
    },
    {
      "send": {"t":"response","request":3,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "store/orders.json",
      "expect": {
        "changed": [
          {"t":"screen","id":2}
        ],
        "effects": [
          {"t":"stream_open","stream":1,"url":"https://shop.example/broadcasting/stream?topics=orders,activity,stats,inventory","headers":[["accept","text/event-stream"],["x-navree-native","1"]]}
        ]
      }
    },
    {
      "send": {"t":"act","screen":2,"action":{"t":"navigate","href":"/board"}},
      "expect": {
        "changed": [
          {"t":"nav"},
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"fetch","request":4,"method":"get","url":"https://shop.example/board","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000},
          {"t":"stream_close","stream":1}
        ]
      }
    },
    {
      "send": {"t":"response","request":4,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/board.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": []
      }
    },
    {
      "send": {"t":"act","screen":3,"action":{"t":"request","method":"post","href":"/board/run"}},
      "expect": {
        "changed": [
          {"t":"screen","id":3}
        ],
        "effects": [
          {"t":"fetch","request":5,"method":"post","url":"https://shop.example/board/run","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=1; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":""},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "Twelve ops that find nothing to change, and a toast at the end.",
      "send": {"t":"response","request":5,"status":200,"content_type":"application/vnd.navree.native+json"},
      "body": "made/board-ops-missing.json",
      "expect": {
        "changed": [
          {"t":"screen","id":3},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"message","id":1,"tone":"neutral","text":"Still here"}
        ]
      },
      "check": [
        {"at":"/screens/3/content/screen/body/children/0/value","is":"3 open"},
        {"at":"/screens/3/overlays","is":[]},
        {"at":"/screens/3/focus","is":null},
        {"at":"/messages/0/text","is":"Still here"},
        {"at":"/screens/3/loading","is":false}
      ]
    },
    {
      "note": "Twelve commands that find nothing to change.",
      "send": {"t":"act","screen":3,"action":{"t":"commands","list":[{"c":"toggle","id":"ghost"},{"c":"show","id":"ghost"},{"c":"hide","id":"ghost"},{"c":"open","id":"ghost"},{"c":"close","id":"ghost"},{"c":"set","id":"ghost","state":"selected","on":true},{"c":"flip","id":"ghost","state":"active"},{"c":"focus","id":"ghost"},{"c":"submit","id":"ghost"},{"c":"text","id":"ghost","text":"never"},{"c":"count","id":"ghost"},{"c":"value","id":"ghost","value":"never"}]}},
      "expect": {
        "changed": [],
        "effects": []
      }
    }
  ]
}
