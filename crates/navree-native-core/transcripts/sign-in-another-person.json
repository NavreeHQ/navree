        "effects": [
          {"t":"fetch","request":6,"method":"post","url":"https://shop.example/sign-in","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"],["content-type","application/x-www-form-urlencoded"]],"body":{"t":"form","text":"_csrf=an0n&email=harpreet.singh%40example.com&password=right"},"timeout_ms":60000,"xsrf":true}
        ]
      }
    },
    {
      "note": "Harpreet signs in, and the server redirects to Ravneet's order. Nothing of `/orders/1` is fetched: the cover waits and only the shell is asked.",
      "send": {"t":"response","request":6,"status":303,"location":"/orders/1"},
      "expect": {
        "changed": [
          {"t":"screen","id":1},
          {"t":"screen","id":2},
          {"t":"screen","id":4}
        ],
        "effects": [
          {"t":"fetch","request":7,"method":"get","url":"https://shop.example/_navree/native/shell","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/app/user","is":null},
        {"at":"/modals","is":[{"locked":true,"present":"full","stack":[4]}]},
        {"at":"/screens/1/content/t","is":"blank"},
        {"at":"/screens/2/content/t","is":"blank"},
        {"at":"/screens/3/content/t","is":"blank"}
      ]
    },
    {
      "note": "The shell names Harpreet: Ravneet's screens go without ever being asked for, and Harpreet starts at the first destination.",
      "send": {"t":"response","request":7,"status":200,"content_type":"application/vnd.navree.native+json","headers":[["x-navree-person","0193a4b2-0000-7000-8000-00000000hs02"]]},
      "body": "made/shell-other.json",
      "expect": {
        "changed": [
          {"t":"app"},
          {"t":"nav"},
          {"t":"screen","id":5},
          {"t":"messages"}
        ],
        "effects": [
          {"t":"fetch","request":8,"method":"get","url":"https://shop.example/","headers":[["x-navree-native","1"],["x-navree-client","platform=android; form=phone; vocab=0; scheme=light; contrast=normal; text=1.00"],["accept","application/vnd.navree.native+json"]],"timeout_ms":30000}
        ]
      },
      "check": [
        {"at":"/app/user/name","is":"Harpreet Singh"},
        {"at":"/app/user/key","is":"38c9705141ffe6c8247000b823439d8248a231f176ef18db39fa1940e1e809cc"},
        {"at":"/modals","is":[]},
        {"at":"/selected","is":0},
        {"at":"/destinations/0/stack","is":[5]},
        {"at":"/destinations/1/stack","is":[]},
        {"at":"/screens/2","is":null},
        {"at":"/screens/3","is":null},
        {"at":"/front","is":5}
      ]
    }
  ]
