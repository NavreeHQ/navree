{
  "api": {
    "title": "Navree CRM API"
  },
  "app": {
    "url": "http://localhost:3000"
  },
  "auth": {
    "password_reset": {
      "url": "http://localhost:3000/reset-password"
    },
    "registration": "true"
  },
  "database": {
    "migrate_on_boot": true,
    "url": "postgres://crm:crm@db:5432/crm"
  },
  "http": {
    "addr": "0.0.0.0:8080",
    "api_prefix": "/api",
    "cors": {
      "allowed_origins": "https://crm.example.com"
    },
    "trusted_proxies": "10.0.0.5,10.0.0.6"
  },
  "key": "",
  "log": {
    "level": "info"
  },
  "mail": {
    "from": "Navree CRM <crm@navree.test>",
    "transport": "smtp://localhost:1025"
  },
  "mcp": {
    "auth": "bearer",
    "instructions": "Tools for the Navree CRM. Deals move through the stages lead, qualified, proposal, negotiation, won and lost. Amounts are in cents.",
    "name": "navree-crm",
    "title": "Navree CRM"
  },
  "queue": {
    "driver": "database"
  },
  "realtime": {
    "allowed_origins": [
      "http://localhost:3000"
    ],
    "key": "navree-crm-key",
    "relay_url": "http://127.0.0.1:8080"
  }
}
