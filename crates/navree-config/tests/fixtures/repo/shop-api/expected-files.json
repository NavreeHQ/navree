{
  "api": {
    "title": "Dukaan shop API"
  },
  "app": {
    "url": "http://localhost:3000"
  },
  "auth": {
    "password_reset": {
      "url": "http://localhost:3000/reset-password"
    },
    "registration": false
  },
  "database": {
    "migrate_on_boot": true,
    "url": "sqlite://storage/shop.db?mode=rwc"
  },
  "http": {
    "addr": "127.0.0.1:8080",
    "api_prefix": "/api",
    "cors": {
      "allowed_origins": [
        "http://localhost:3000"
      ]
    },
    "trusted_proxies": [
      "127.0.0.1",
      "::1"
    ]
  },
  "key": "",
  "log": {
    "level": "info"
  },
  "mail": {
    "from": "Dukaan shop <shop@navree.test>",
    "transport": "log"
  },
  "mcp": {
    "auth": "bearer",
    "instructions": "Tools for the Dukaan shop. Orders move through the stages placed, packed, shipped, delivered and returned. Amounts are in paise.",
    "name": "dukaan-shop",
    "title": "Dukaan shop"
  },
  "queue": {
    "driver": "database"
  },
  "realtime": {
    "allowed_origins": [
      "http://localhost:3000"
    ],
    "key": "dukaan-shop-key",
    "relay_url": "auto"
  }
}
