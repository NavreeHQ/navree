{
  "api": {
    "title": "Acme cloud API",
    "undocumented": [
      "/_lighthouse*",
      "/_logbook*"
    ]
  },
  "auth": {
    "registration": true
  },
  "database": {
    "migrate_on_boot": true,
    "url": "mysql://navree:navree@127.0.0.1:3306/acme_cloud"
  },
  "http": {
    "addr": "127.0.0.1:8080",
    "api_prefix": "/api"
  },
  "key": "",
  "log": {
    "level": "info"
  },
  "mail": {
    "from": "Acme cloud <hello@example.com>",
    "transport": "log"
  },
  "queue": {
    "driver": "database"
  },
  "workspace": {
    "resolvers": [
      "header"
    ]
  }
}
