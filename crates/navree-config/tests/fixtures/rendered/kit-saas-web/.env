# `navree new` copied this file to .env.local (git-ignored); change that copy.
# Read by the web app's server (the backend-for-frontend)
# and, for NEXT_PUBLIC_* values, by the browser.

# Where the Navree API listens (`navree dev` in the app root).
NAVREE_API_URL=http://127.0.0.1:8080

# Secure cookies are on in production builds; set to 0 to serve a production
# build over plain http on a host other than localhost.
# NAVREE_COOKIE_SECURE=0

# The public origin(s) when the app sits behind a proxy that rewrites Host.
# APP_ORIGINS=https://agra-cloud.example.com

# Client addresses. The browser's own X-Forwarded-For never reaches the API:
# the web app names the browser to the API only when it knows a proxy vouches
# for the address. `navree deploy` (Harbor) sets the hop count to 1 for its
# Caddy. Behind your own proxies, set the number of them, or the header the
# proxy overwrites with the bare client address. Reach the web app only through
# them, and list this server in the API's APP_HTTP__TRUSTED_PROXIES.
# NAVREE_TRUSTED_PROXY_HOPS=1
# NAVREE_CLIENT_IP_HEADER=x-real-ip

# Real-time updates: the API's WebSocket server (realtime.key in config/app.toml).
NEXT_PUBLIC_REALTIME_KEY=agra-cloud
NEXT_PUBLIC_REALTIME_HOST=127.0.0.1
NEXT_PUBLIC_REALTIME_PORT=8080
NEXT_PUBLIC_REALTIME_TLS=false
