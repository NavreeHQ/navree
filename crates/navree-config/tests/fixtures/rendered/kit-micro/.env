# Copy to `.env` (never commit `.env`). Each entry sets a key and wins over
# config/app.toml: APP_<SECTION>__<KEY> is <section>.<key>, e.g.
# APP_DATABASE__URL -> database.url. Real environment variables override both.

# Encrypts data and signs tokens. `navree new` put a key in .env; `navree key:generate`
# prints another, and `navree key:generate --write` fills an empty APP_KEY in .env.
APP_KEY=

# Verifies the bearer tokens other services forward: the same secret in
# every service (the one that signs them included).
# APP_AUTH__JWT__SECRET=

# The database and the broker come from Dock: `navree dock up` writes
# APP_DATABASE__URL and APP_MICRO__URL below, between the dock markers.
# config/app.toml names the transport; .env holds addresses and secrets.

# dock:start (written by navree dock up; edit dock.toml instead)
APP_DATABASE__URL=postgres://navree:navree@127.0.0.1:5432/agra_cloud
APP_MICRO__URL=nats://127.0.0.1:4222
# dock:end
