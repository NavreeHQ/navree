---
source: crates/navree-dock/tests/lifecycle.rs
expression: "transcript(&dock, &out)"
---
$ docker ps --all --filter label=dev.navree.dock.project=crm-api --format '{{.Names}}|{{.State}}|{{.Image}}|{{.Ports}}'
$ docker image inspect --format '{{.Id}}' timescale/timescaledb:2.31.0-pg17
$ docker image inspect --format '{{.Id}}' pgsty/minio:RELEASE.2026-08-04T00-00-00Z
$ docker compose --project-name crm-api --file .navree/dock/compose.yaml up --detach postgres minio
$ docker exec crm-api-postgres pg_isready -h 127.0.0.1 -p 5432 -U navree -d crm_api
$ docker exec crm-api-postgres psql -v ON_ERROR_STOP=1 -U navree -d crm_api -c 'CREATE EXTENSION IF NOT EXISTS "timescaledb"'
$ docker exec crm-api-postgres psql -v ON_ERROR_STOP=1 -U navree -d crm_api -c 'CREATE EXTENSION IF NOT EXISTS "vector"'
$ docker exec crm-api-postgres psql -v ON_ERROR_STOP=1 -U navree -d crm_api -c 'CREATE EXTENSION IF NOT EXISTS "pg_trgm"'
$ docker exec crm-api-postgres psql -v ON_ERROR_STOP=1 -U navree -d crm_api -c 'DO $do$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = $r$navree_reader$r$) THEN CREATE ROLE navree_reader; GRANT CONNECT ON DATABASE "crm_api" TO navree_reader; GRANT USAGE ON SCHEMA public TO navree_reader; GRANT SELECT ON ALL TABLES IN SCHEMA public TO navree_reader; ALTER DEFAULT PRIVILEGES FOR ROLE "navree" IN SCHEMA public GRANT SELECT ON TABLES TO navree_reader; END IF; END $do$; ALTER ROLE navree_reader WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS PASSWORD $v$SCRAM-SHA-256$4096:yS0Iqc48riceQGSHRBd1yA==$3AzjysAfrITjmqV9Fq5ywoHWQgDsMQR195OMHUUR5qU=:eMfa69XwzeLcinjwrqRMO8e3639le5BvUFFllZurO2g=$v$; ALTER ROLE navree_reader SET default_transaction_read_only = on; ALTER ROLE navree_reader SET statement_timeout = $t$5s$t$; ALTER ROLE navree_reader SET temp_file_limit = $t$64MB$t$'
$ docker exec -e MC_HOST_dock=http://navree:navree-secret@127.0.0.1:9000 crm-api-minio mcli mb --ignore-existing dock/crm-uploads
--- printed ---
Starting crm-api services with docker
