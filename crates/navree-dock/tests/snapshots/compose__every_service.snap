---
source: crates/navree-dock/tests/compose.rs
expression: "compose(\"[services.postgres]\\n[services.redis]\\n[services.meilisearch]\\n[services.mailpit]\\n[services.minio]\\n[services.nats]\\n\")"
---
# Generated by `navree dock` from dock.toml. Edit dock.toml instead.
name: "crm-api"
services:
  postgres:
    image: "postgres:17"
    container_name: "crm-api-postgres"
    labels:
      dev.navree.dock.project: "crm-api"
      dev.navree.dock.service: "postgres"
    environment:
      POSTGRES_USER: "navree"
      POSTGRES_PASSWORD: "navree"
      POSTGRES_DB: "crm_api"
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
      - "crm-api-postgres-data:/var/lib/postgresql/data"
  redis:
    image: "redis:7"
    container_name: "crm-api-redis"
    labels:
      dev.navree.dock.project: "crm-api"
      dev.navree.dock.service: "redis"
    command: ["--maxmemory", "256mb", "--appendonly", "yes"]
    ports:
      - "127.0.0.1:6379:6379"
    volumes:
      - "crm-api-redis-data:/data"
  meilisearch:
    image: "getmeili/meilisearch:v1.55"
    container_name: "crm-api-meilisearch"
    labels:
      dev.navree.dock.project: "crm-api"
      dev.navree.dock.service: "meilisearch"
    environment:
      MEILI_MASTER_KEY: "dock-meilisearch-master-key"
      MEILI_ENV: "development"
      MEILI_NO_ANALYTICS: "true"
    ports:
      - "127.0.0.1:7700:7700"
    volumes:
      - "crm-api-meilisearch-data:/meili_data"
  mailpit:
    image: "axllent/mailpit:v1.31"
    container_name: "crm-api-mailpit"
    labels:
      dev.navree.dock.project: "crm-api"
      dev.navree.dock.service: "mailpit"
    environment:
      MP_DATABASE: "/data/mailpit.db"
      MP_SMTP_AUTH_ACCEPT_ANY: "1"
      MP_SMTP_AUTH_ALLOW_INSECURE: "1"
    ports:
      - "127.0.0.1:1025:1025"
      - "127.0.0.1:8025:8025"
    volumes:
      - "crm-api-mailpit-data:/data"
  minio:
    image: "pgsty/minio:RELEASE.2026-08-04T00-00-00Z"
    container_name: "crm-api-minio"
    labels:
      dev.navree.dock.project: "crm-api"
      dev.navree.dock.service: "minio"
    environment:
      MINIO_ROOT_USER: "navree"
      MINIO_ROOT_PASSWORD: "navree-secret"
    command: ["server", "/data", "--console-address", ":9001"]
    ports:
      - "127.0.0.1:9000:9000"
      - "127.0.0.1:9001:9001"
    volumes:
      - "crm-api-minio-data:/data"
  nats:
    image: "nats:2.14"
    container_name: "crm-api-nats"
    labels:
      dev.navree.dock.project: "crm-api"
      dev.navree.dock.service: "nats"
    command: ["--jetstream", "--store_dir", "/data", "--http_port", "8222"]
    ports:
      - "127.0.0.1:4222:4222"
      - "127.0.0.1:8222:8222"
    volumes:
      - "crm-api-nats-data:/data"
volumes:
  crm-api-postgres-data:
    name: "crm-api-postgres-data"
    labels:
      dev.navree.dock.project: "crm-api"
  crm-api-redis-data:
    name: "crm-api-redis-data"
    labels:
      dev.navree.dock.project: "crm-api"
  crm-api-meilisearch-data:
    name: "crm-api-meilisearch-data"
    labels:
      dev.navree.dock.project: "crm-api"
  crm-api-mailpit-data:
    name: "crm-api-mailpit-data"
    labels:
      dev.navree.dock.project: "crm-api"
  crm-api-minio-data:
    name: "crm-api-minio-data"
    labels:
      dev.navree.dock.project: "crm-api"
  crm-api-nats-data:
    name: "crm-api-nats-data"
    labels:
      dev.navree.dock.project: "crm-api"
