---
source: crates/navree-dock/tests/compose.rs
expression: "compose(r#\"\nproject = \"crm\"\n\n[services.postgres]\nversion = \"16\"\ndatabase = \"crm_dev\"\nuser = \"crm\"\npassword = \"s3cret-pass\"\nport = 5433\nextensions = [\"vector\"]\n\n[services.redis]\nimage = \"valkey/valkey:8\"\nmaxmemory_mb = 64\nport = 6380\n\n[services.mailpit]\nport = 2525\nui_port = 8026\n\n[services.minio]\naccess_key = \"admin\"\nsecret_key = \"admin-secret\"\nport = 9100\nconsole_port = 9101\n\n[services.nats]\njetstream = false\nmonitor_port = 8223\n\"#)"
---
# Generated by `navree dock` from dock.toml. Edit dock.toml instead.
name: "crm"
services:
  postgres:
    image: "timescale/timescaledb:2.31.0-pg16"
    container_name: "crm-postgres"
    labels:
      dev.navree.dock.project: "crm"
      dev.navree.dock.service: "postgres"
    environment:
      POSTGRES_USER: "crm"
      POSTGRES_PASSWORD: "s3cret-pass"
      POSTGRES_DB: "crm_dev"
      TIMESCALEDB_TELEMETRY: "off"
    command: ["postgres", "-c", "shared_preload_libraries=timescaledb", "-c", "timescaledb.telemetry_level=off"]
    ports:
      - "127.0.0.1:5433:5432"
    volumes:
      - "crm-postgres-data:/var/lib/postgresql/data"
  redis:
    image: "valkey/valkey:8"
    container_name: "crm-redis"
    labels:
      dev.navree.dock.project: "crm"
      dev.navree.dock.service: "redis"
    command: ["--maxmemory", "64mb", "--appendonly", "yes"]
    ports:
      - "127.0.0.1:6380:6379"
    volumes:
      - "crm-redis-data:/data"
  mailpit:
    image: "axllent/mailpit:v1.31"
    container_name: "crm-mailpit"
    labels:
      dev.navree.dock.project: "crm"
      dev.navree.dock.service: "mailpit"
    environment:
      MP_DATABASE: "/data/mailpit.db"
      MP_SMTP_AUTH_ACCEPT_ANY: "1"
      MP_SMTP_AUTH_ALLOW_INSECURE: "1"
    ports:
      - "127.0.0.1:2525:1025"
      - "127.0.0.1:8026:8025"
    volumes:
      - "crm-mailpit-data:/data"
  minio:
    image: "pgsty/minio:RELEASE.2026-08-04T00-00-00Z"
    container_name: "crm-minio"
    labels:
      dev.navree.dock.project: "crm"
      dev.navree.dock.service: "minio"
    environment:
      MINIO_ROOT_USER: "admin"
      MINIO_ROOT_PASSWORD: "admin-secret"
    command: ["server", "/data", "--console-address", ":9001"]
    ports:
      - "127.0.0.1:9100:9000"
      - "127.0.0.1:9101:9001"
    volumes:
      - "crm-minio-data:/data"
  nats:
    image: "nats:2.14"
    container_name: "crm-nats"
    labels:
      dev.navree.dock.project: "crm"
      dev.navree.dock.service: "nats"
    command: ["--http_port", "8222"]
    ports:
      - "127.0.0.1:4222:4222"
      - "127.0.0.1:8223:8222"
    volumes:
      - "crm-nats-data:/data"
volumes:
  crm-postgres-data:
    name: "crm-postgres-data"
    labels:
      dev.navree.dock.project: "crm"
  crm-redis-data:
    name: "crm-redis-data"
    labels:
      dev.navree.dock.project: "crm"
  crm-mailpit-data:
    name: "crm-mailpit-data"
    labels:
      dev.navree.dock.project: "crm"
  crm-minio-data:
    name: "crm-minio-data"
    labels:
      dev.navree.dock.project: "crm"
  crm-nats-data:
    name: "crm-nats-data"
    labels:
      dev.navree.dock.project: "crm"
