---
source: crates/navree-ui/tests/components.rs
expression: "render(r#\"{{ ui.form_errors(errors) }}\n{{ ui.field(\"email\", \"Email\", type=\"email\", value=\"ada@\", errors=errors, hint=\"Work address.\", required=true) }}\n{{ ui.field(\"site\", \"Website\", icon=\"globe\", optional=true, attrs={\"data-x\": \"1\"}) }}\n{{ ui.textarea_field(\"bio\", \"Bio\", value=\"Hi <there>\", rows=2) }}\n{{ ui.select_field(\"role\", \"Role\", [[\"admin\", \"Admin\"], [\"rep\", \"Sales rep\"]], value=\"rep\") }}\n{{ ui.select_field(\"tz\", \"Time zone\", [\"UTC\", {\"value\": \"Asia/Kolkata\", \"label\": \"India\"}], placeholder=\"Select\") }}\n{{ ui.checkbox_field(\"terms\", \"I agree\", errors={\"terms\": [\"Confirm to continue\"]}) }}\n{{ ui.switch_field(\"mail\", \"Email\", checked=true, hint=\"Mentions.\") }}\n{{ ui.search_input(value=\"ada\") }}\"#,\njson!({ \"errors\": errors }),)"
---
<div class="ui-alert ui-alert--danger" role="alert">
<svg class="ui-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
<circle cx="12" cy="12" r="10"/>
<line x1="12" x2="12" y1="8" y2="12"/>
<line x1="12" x2="12.01" y1="16" y2="16"/>
</svg>
<div>
<p class="ui-alert__title">Please correct the highlighted fields.</p>
<div class="ui-alert__body">
<ul>
<li>email must be a valid email address</li>
</ul>
</div>
</div>
</div>
<div class="ui-field">
<label class="ui-label" for="field-email">Email</label>
<input class="ui-input" id="field-email" name="email" type="email" value="ada@" required aria-invalid="true" aria-describedby="field-email-hint field-email-error">
<p class="ui-field__hint" id="field-email-hint">Work address.</p>
<p class="ui-field__error" id="field-email-error">email must be a valid email address</p>
</div>
<div class="ui-field">
<label class="ui-label" for="field-site">Website<span class="ui-label__optional">(optional)</span>
</label>
<span class="ui-input-wrap">
<svg class="ui-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
<circle cx="12" cy="12" r="10"/>
<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
<path d="M2 12h20"/>
</svg>
<input class="ui-input" id="field-site" name="site" type="text" data-x="1">
</span>
</div>
<div class="ui-field">
<label class="ui-label" for="field-bio">Bio</label>
<textarea class="ui-textarea" id="field-bio" name="bio" rows="2">Hi &lt;there&gt;</textarea>
</div>
<div class="ui-field">
<label class="ui-label" for="field-role">Role</label>
<span class="ui-select-wrap">
<select class="ui-select" id="field-role" name="role">
<option value="admin">Admin</option>
<option value="rep" selected>Sales rep</option>
</select>
<svg class="ui-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
<path d="m6 9 6 6 6-6"/>
</svg>
</span>
</div>
<div class="ui-field">
<label class="ui-label" for="field-tz">Time zone</label>
<span class="ui-select-wrap">
<select class="ui-select" id="field-tz" name="tz">
<option value="" selected disabled>Select</option>
<option value="UTC">UTC</option>
<option value="Asia&#x2f;Kolkata">India</option>
</select>
<svg class="ui-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
<path d="m6 9 6 6 6-6"/>
</svg>
</span>
</div>
<div class="ui-field">
<label class="ui-check" for="field-terms">
<input type="checkbox" class="ui-checkbox" id="field-terms" name="terms" value="1" aria-invalid="true" aria-describedby="field-terms-error">
<span class="ui-check__text">
<span class="ui-check__label">I agree</span>
</span>
</label>
<p class="ui-field__error" id="field-terms-error">Confirm to continue</p>
</div>
<label class="ui-switch-row" for="field-mail">
<span class="ui-check__text">
<span class="ui-check__label">Email</span>
<span class="ui-check__hint">Mentions.</span>
</span>
<input type="checkbox" role="switch" class="ui-switch" id="field-mail" name="mail" value="1" checked>
</label>
<span class="ui-input-wrap">
<svg class="ui-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
<path d="m21 21-4.34-4.34"/>
<circle cx="11" cy="11" r="8"/>
</svg>
<input class="ui-input" type="search" name="search" placeholder="Search…" aria-label="Search" value="ada">
</span>
