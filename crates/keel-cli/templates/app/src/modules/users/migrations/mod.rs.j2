//! The migrations of the users module. `keel migrate` runs every module's set
//! in dependency order and each set in name order;
//! `keel make:migration users <name>` adds one here.

use keel::db::MigrationSet;

mod {{ users_migration }};

/// The module's migration set, run after keel-auth's (`auth`), which
/// creates the `users` table.
pub fn migrations() -> MigrationSet {
