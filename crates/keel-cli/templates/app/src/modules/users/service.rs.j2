//! Reads and writes profiles.

use chrono::Utc;
use keel::db::{Repo, Uow};
use keel::injectable;
use sea_orm::{ActiveValue::Set, DbErr};
use uuid::Uuid;

use super::dto::{DEFAULT_TIMEZONE, UpdateProfile};
use super::entity::{ActiveModel, Entity, Model};

/// Profiles, read and written in the caller's unit of work.
#[injectable]
pub struct ProfileService;

impl ProfileService {
    /// The saved profile of `user_id`, if any.
    pub async fn find(&self, uow: &Uow, user_id: Uuid) -> Result<Option<Model>, DbErr> {
        Repo::<Entity>::find(uow, user_id).await
    }

    /// Saves the fields present in `input`, creating the profile on first use.
    pub async fn update(
        &self,
        uow: &Uow,
        user_id: Uuid,
        input: UpdateProfile,
    ) -> Result<Model, DbErr> {
        let now = Utc::now();
        match Repo::<Entity>::find(uow, user_id).await? {
            Some(profile) => {
                let mut active: ActiveModel = profile.into();
                if let Some(bio) = input.bio {
                    active.bio = Set(Some(bio));
                }
                if let Some(timezone) = input.timezone {
                    active.timezone = Set(timezone);
                }
                active.updated_at = Set(now);
                Repo::<Entity>::update(uow, active).await
            }
            None => {
                let profile = ActiveModel {
                    user_id: Set(user_id),
                    bio: Set(input.bio),
                    timezone: Set(input
                        .timezone
                        .unwrap_or_else(|| DEFAULT_TIMEZONE.to_owned())),
                    created_at: Set(now),
                    updated_at: Set(now),
                };
                Repo::<Entity>::insert(uow, profile).await
            }
        }
    }
}
