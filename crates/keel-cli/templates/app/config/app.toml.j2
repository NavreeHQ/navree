# Settings for every environment. `.env` and APP_* environment variables
# override them: APP_HTTP__ADDR=0.0.0.0:8080 sets http.addr.

[http]
addr = "127.0.0.1:8080"
api_prefix = "/api"

[database]
url = "sqlite://storage/{{ crate_name }}.db?mode=rwc"
# Run pending migrations at boot (handy in development; use `keel migrate`
# in deployments).
migrate_on_boot = true

[log]
level = "info"

[mail]
transport = "log"

[queue]
driver = "database"

[auth]
# Public sign-up at POST /api/auth/register.
registration = true

[api]
title = "{{ title }} API"
