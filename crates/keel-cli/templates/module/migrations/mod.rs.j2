//! The migrations of the {{ module_words }} module. `keel migrate` runs every
//! module's set in dependency order and each set in name order;
//! `keel make:migration {{ module }} <name>` adds one here.

use keel::db::MigrationSet;

mod {{ migration }};

/// The module's migration set, recorded under `{{ module }}` in `keel_migrations`.
pub fn migrations() -> MigrationSet {
    MigrationSet::new("{{ module }}")
        .migration({{ migration }}::Migration)
}
