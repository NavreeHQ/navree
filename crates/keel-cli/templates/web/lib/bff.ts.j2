/**
 * Backend-for-frontend for the Keel API.
 *
 * The browser never sees a token: the access token and the rotating refresh
 * token live in httpOnly cookies set by this server, which forwards requests
 * to Keel with `Authorization: Bearer`. On a 401 it refreshes once and
 * retries. Requests that change data must come from this app's own origin,
 * which is the CSRF defence for the cookies.
 */

export const ACCESS_COOKIE = "keel_at";
export const REFRESH_COOKIE = "keel_rt";

const API_URL = (process.env.KEEL_API_URL ?? "http://127.0.0.1:8080").replace(/\/+$/, "");
const SECURE = process.env.NODE_ENV === "production";
const REFRESH_MAX_AGE = 60 * 60 * 24 * 30;
const SAFE_METHODS = new Set(["GET", "HEAD", "OPTIONS"]);
const FORWARD_REQUEST_HEADERS = ["accept", "content-type", "if-none-match", "x-request-id"];
const FORWARD_RESPONSE_HEADERS = ["content-type", "content-disposition", "etag", "location", "retry-after", "x-request-id"];

/** Keel's answer to `POST /api/auth/login` and `/api/auth/refresh`. */
export interface TokenPair {
  access_token: string;
  refresh_token: string;
  expires_in?: number;
}

export function readCookie(request: Request, name: string): string | undefined {
  for (const part of (request.headers.get("cookie") ?? "").split(";")) {
    const eq = part.indexOf("=");
    if (eq !== -1 && part.slice(0, eq).trim() === name) {
      return decodeURIComponent(part.slice(eq + 1).trim());
    }
  }
  return undefined;
}

function cookie(name: string, value: string, maxAge: number): string {
  const parts = [`${name}=${encodeURIComponent(value)}`, "Path=/", "HttpOnly", "SameSite=Lax", `Max-Age=${maxAge}`];
  if (SECURE) parts.push("Secure");
  return parts.join("; ");
}

export function setTokenCookies(headers: Headers, tokens: TokenPair): void {
  headers.append("set-cookie", cookie(ACCESS_COOKIE, tokens.access_token, Math.max(1, tokens.expires_in ?? 900)));
  headers.append("set-cookie", cookie(REFRESH_COOKIE, tokens.refresh_token, REFRESH_MAX_AGE));
}

export function clearTokenCookies(headers: Headers): void {
  headers.append("set-cookie", cookie(ACCESS_COOKIE, "", 0));
  headers.append("set-cookie", cookie(REFRESH_COOKIE, "", 0));
}

/** Whether a request may change data: safe methods always, others only from this origin. */
export function originAllowed(request: Request): boolean {
  if (SAFE_METHODS.has(request.method.toUpperCase())) return true;
  const origin = request.headers.get("origin");
  if (!origin) return false;
  try {
    return new URL(origin).host === (request.headers.get("host") ?? new URL(request.url).host);
  } catch {
    return false;
  }
}

/** A JSON error in Keel's (NestJS) format. */
export function error(statusCode: number, message: string, reason: string): Response {
  return Response.json({ statusCode, message, error: reason }, { status: statusCode });
}

/** Calls Keel at `path` (`/api/...`). */
export function keel(path: string, init: RequestInit = {}): Promise<Response> {
  return fetch(`${API_URL}${path}`, { ...init, cache: "no-store" });
}

/**
 * Refresh tokens rotate and a reused one revokes the whole session, so
 * concurrent requests carrying the same refresh token share one refresh.
 */
const refreshes = new Map<string, Promise<TokenPair | null>>();

function refresh(refreshToken: string): Promise<TokenPair | null> {
  let pending = refreshes.get(refreshToken);
  if (!pending) {
    pending = keel("/api/auth/refresh", {
      method: "POST",
      headers: { "content-type": "application/json", accept: "application/json" },
      body: JSON.stringify({ refresh_token: refreshToken }),
    })
      .then(async (response) => (response.ok ? ((await response.json()) as TokenPair) : null))
      .catch(() => null);
    refreshes.set(refreshToken, pending);
    setTimeout(() => refreshes.delete(refreshToken), 30_000);
  }
  return pending;
}

/** Forwards `request` to the same path at Keel, refreshing the tokens once on a 401. */
export async function proxy(request: Request): Promise<Response> {
  if (!originAllowed(request)) return error(403, "Cross-origin request refused", "Forbidden");
  const url = new URL(request.url);
  const body = SAFE_METHODS.has(request.method) ? undefined : await request.arrayBuffer();
  const send = (accessToken?: string) => {
    const headers = new Headers();
    for (const name of FORWARD_REQUEST_HEADERS) {
      const value = request.headers.get(name);
      if (value) headers.set(name, value);
    }
    if (accessToken) headers.set("authorization", `Bearer ${accessToken}`);
    return keel(`${url.pathname}${url.search}`, { method: request.method, headers, body });
  };

  let upstream = await send(readCookie(request, ACCESS_COOKIE));
  const outgoing = new Headers();
  const refreshToken = readCookie(request, REFRESH_COOKIE);
  if (upstream.status === 401 && refreshToken) {
    const tokens = await refresh(refreshToken);
    if (tokens) {
      setTokenCookies(outgoing, tokens);
      upstream = await send(tokens.access_token);
    } else {
      clearTokenCookies(outgoing);
    }
  }
  for (const name of FORWARD_RESPONSE_HEADERS) {
    const value = upstream.headers.get(name);
    if (value) outgoing.set(name, value);
  }
  return new Response(upstream.body, { status: upstream.status, headers: outgoing });
}
