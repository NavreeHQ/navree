import { error, keel, originAllowed, setTokenCookies, type TokenPair } from "@/lib/bff";

/** Signs in at Keel, keeps the tokens in httpOnly cookies and returns only `{user}`. */
export async function POST(request: Request): Promise<Response> {
  if (!originAllowed(request)) return error(403, "Cross-origin request refused", "Forbidden");
  const upstream = await keel("/api/auth/login", {
    method: "POST",
    headers: { "content-type": "application/json", accept: "application/json" },
    body: await request.text(),
  });
  if (!upstream.ok) {
    return new Response(upstream.body, { status: upstream.status, headers: { "content-type": "application/json" } });
  }
  const { user, ...tokens } = (await upstream.json()) as TokenPair & { user: unknown };
  const headers = new Headers();
  setTokenCookies(headers, tokens);
  return Response.json({ user }, { headers });
}
