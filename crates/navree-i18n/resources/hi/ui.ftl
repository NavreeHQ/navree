## The form's own checks (the rule keys of FORM_MESSAGES)
validation-form-amount = { $attribute }: राशि लिखें, जैसे 12,500.50।
validation-form-choice = { $attribute }: विकल्पों में से एक चुनें।
validation-form-date = { $attribute }: तारीख़ लिखें।
validation-form-decimal_places = { $attribute }: अधिकतम 28 दशमलव स्थान लिखें।
validation-form-file = { $attribute }: फ़ाइल फिर से चुनें।
validation-form-invalid = { $attribute } सही नहीं है।
validation-form-max_choices = अधिकतम { $max } चुनें।
validation-form-moment = { $attribute }: तारीख़ और समय लिखें।
validation-form-number = { $attribute }: संख्या लिखें।
validation-form-phone = { $attribute }: देश के साथ फ़ोन नंबर लिखें।
validation-form-phone_extension = { $attribute }: एक्सटेंशन के बिना नंबर लिखें।
validation-form-time = { $attribute }: समय लिखें।
validation-form-unreadable = यह फ़ॉर्म पढ़ा नहीं जा सका।
