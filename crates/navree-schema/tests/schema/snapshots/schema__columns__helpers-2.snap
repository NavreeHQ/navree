-- postgres
CREATE TABLE "counters" ("id" SMALLINT NOT NULL GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY);
CREATE TABLE "codes" ("id" CHAR(26) NOT NULL, "created_at" TIMESTAMP WITHOUT TIME ZONE NULL, "updated_at" TIMESTAMP WITHOUT TIME ZONE NULL, "deleted_at" TIMESTAMP WITHOUT TIME ZONE NULL, PRIMARY KEY ("id"));

-- mysql
CREATE TABLE `counters` (`id` SMALLINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY) DEFAULT CHARACTER SET utf8mb4;
CREATE TABLE `codes` (`id` CHAR(26) NOT NULL, `created_at` DATETIME(6) NULL, `updated_at` DATETIME(6) NULL, `deleted_at` TIMESTAMP(6) NULL, PRIMARY KEY (`id`)) DEFAULT CHARACTER SET utf8mb4;

-- mariadb
CREATE TABLE `counters` (`id` SMALLINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY) DEFAULT CHARACTER SET utf8mb4;
CREATE TABLE `codes` (`id` CHAR(26) NOT NULL, `created_at` DATETIME(6) NULL, `updated_at` DATETIME(6) NULL, `deleted_at` TIMESTAMP(6) NULL, PRIMARY KEY (`id`)) DEFAULT CHARACTER SET utf8mb4;

-- sqlite
CREATE TABLE "counters" ("id" INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL);
CREATE TABLE "codes" ("id" VARCHAR NOT NULL, "created_at" DATETIME, "updated_at" DATETIME, "deleted_at" DATETIME, PRIMARY KEY ("id"));
