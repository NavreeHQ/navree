-- postgres 16
-- error: PostgreSQL does not support changing a generated column's expression before version 17 (column `gross`): drop the column and add it again

-- postgres 17
ALTER TABLE "totals" ALTER COLUMN "sequence" TYPE BIGINT, ALTER COLUMN "sequence" SET NOT NULL, ALTER COLUMN "sequence" ADD GENERATED BY DEFAULT AS IDENTITY;
ALTER TABLE "totals" ALTER COLUMN "gross" TYPE INTEGER, ALTER COLUMN "gross" SET NOT NULL, ALTER COLUMN "gross" DROP DEFAULT, ALTER COLUMN "gross" DROP IDENTITY IF EXISTS, ALTER COLUMN "gross" SET EXPRESSION AS (price + tax * 2);
COMMENT ON COLUMN "totals"."sequence" IS NULL;
COMMENT ON COLUMN "totals"."gross" IS NULL;
