-- timescaledb
CREATE MATERIALIZED VIEW "readings_hourly" WITH (timescaledb.continuous) AS SELECT time_bucket(INTERVAL '1 hour', taken_at) AS hour, avg(value) AS mean FROM readings GROUP BY hour WITH NO DATA;
SELECT add_continuous_aggregate_policy('readings_hourly', start_offset => NULL, end_offset => INTERVAL '1 hour', schedule_interval => INTERVAL '30 minutes');

