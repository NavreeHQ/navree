-- timescaledb
ALTER TABLE "readings" SET (timescaledb.compress, timescaledb.compress_segmentby = 'device_id');
SELECT add_compression_policy('readings', INTERVAL '14 days');
SELECT remove_compression_policy('readings', if_exists => TRUE);
SELECT add_compression_policy('readings', INTERVAL '30 days');
SELECT add_continuous_aggregate_policy('readings_hourly', start_offset => INTERVAL '1 day', end_offset => NULL, schedule_interval => INTERVAL '1 hour');
SELECT remove_continuous_aggregate_policy('readings_hourly', if_exists => TRUE);
SELECT add_retention_policy('readings', INTERVAL '1 year');
SELECT remove_retention_policy('readings', if_exists => TRUE);
SELECT add_reorder_policy('readings', 'readings_device_id_taken_at_index');
SELECT remove_reorder_policy('readings', if_exists => TRUE);
SELECT set_chunk_time_interval('readings', INTERVAL '2 days');
CALL refresh_continuous_aggregate('readings_hourly', now() - INTERVAL '2 days', NULL);

