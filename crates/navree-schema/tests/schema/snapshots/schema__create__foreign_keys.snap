-- sqlite
CREATE TABLE "line_items" ("id" VARCHAR NOT NULL, "order_id" VARCHAR NOT NULL, "product_id" VARCHAR, "currency" VARCHAR NOT NULL, FOREIGN KEY ("order_id") REFERENCES "orders" ("id") ON DELETE CASCADE ON UPDATE CASCADE, FOREIGN KEY ("product_id") REFERENCES "catalog"."products" ("id") ON DELETE SET NULL, FOREIGN KEY ("currency") REFERENCES "currencies" ("code") ON DELETE RESTRICT, PRIMARY KEY ("id"));
