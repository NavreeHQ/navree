-- postgres
ALTER TABLE "deals" ALTER COLUMN "title" TYPE VARCHAR(500), ALTER COLUMN "title" SET NOT NULL, ALTER COLUMN "title" DROP DEFAULT, ALTER COLUMN "title" DROP IDENTITY IF EXISTS;
ALTER TABLE "deals" ALTER COLUMN "amount" TYPE DECIMAL(14, 4) USING amount::numeric(14, 4), ALTER COLUMN "amount" DROP NOT NULL, ALTER COLUMN "amount" SET DEFAULT 0, ALTER COLUMN "amount" DROP IDENTITY IF EXISTS;
ALTER TABLE "deals" ALTER COLUMN "notes" TYPE TEXT, ALTER COLUMN "notes" SET NOT NULL, ALTER COLUMN "notes" DROP DEFAULT, ALTER COLUMN "notes" DROP IDENTITY IF EXISTS;
ALTER TABLE "deals" ALTER COLUMN "email" TYPE VARCHAR(255), ALTER COLUMN "email" SET NOT NULL, ALTER COLUMN "email" DROP DEFAULT, ALTER COLUMN "email" DROP IDENTITY IF EXISTS;
ALTER TABLE "deals" ALTER COLUMN "code" TYPE VARCHAR(255), ALTER COLUMN "code" SET NOT NULL, ALTER COLUMN "code" DROP DEFAULT, ALTER COLUMN "code" DROP IDENTITY IF EXISTS;
ALTER TABLE "deals" ALTER COLUMN "id" TYPE BIGINT, ALTER COLUMN "id" SET NOT NULL;
ALTER TABLE "deals" ADD CONSTRAINT "deals_email_unique" UNIQUE ("email");
ALTER TABLE "deals" DROP CONSTRAINT "deals_code_unique";
COMMENT ON COLUMN "deals"."title" IS NULL;
COMMENT ON COLUMN "deals"."amount" IS NULL;
COMMENT ON COLUMN "deals"."notes" IS 'internal';
COMMENT ON COLUMN "deals"."email" IS NULL;
COMMENT ON COLUMN "deals"."code" IS NULL;
COMMENT ON COLUMN "deals"."id" IS NULL;

