-- postgres
CREATE TABLE "deals" ("id" BIGINT NOT NULL GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, "company_id" BIGINT NOT NULL, "title" VARCHAR(255) NOT NULL, "amount" DECIMAL(12, 2) NOT NULL, "created_at" TIMESTAMP WITHOUT TIME ZONE NULL, "updated_at" TIMESTAMP WITHOUT TIME ZONE NULL, "deleted_at" TIMESTAMP WITHOUT TIME ZONE NULL);
ALTER TABLE "deals" ADD CONSTRAINT "deals_company_id_foreign" FOREIGN KEY ("company_id") REFERENCES "companies" ("id") ON DELETE CASCADE;

-- mysql
CREATE TABLE `deals` (`id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY, `company_id` BIGINT UNSIGNED NOT NULL, `title` VARCHAR(255) NOT NULL, `amount` DECIMAL(12, 2) NOT NULL, `created_at` TIMESTAMP(6) NULL, `updated_at` TIMESTAMP(6) NULL, `deleted_at` TIMESTAMP(6) NULL) DEFAULT CHARACTER SET utf8mb4;
ALTER TABLE `deals` ADD CONSTRAINT `deals_company_id_foreign` FOREIGN KEY (`company_id`) REFERENCES `companies` (`id`) ON DELETE CASCADE;

-- mariadb
CREATE TABLE `deals` (`id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY, `company_id` BIGINT UNSIGNED NOT NULL, `title` VARCHAR(255) NOT NULL, `amount` DECIMAL(12, 2) NOT NULL, `created_at` TIMESTAMP(6) NULL, `updated_at` TIMESTAMP(6) NULL, `deleted_at` TIMESTAMP(6) NULL) DEFAULT CHARACTER SET utf8mb4;
ALTER TABLE `deals` ADD CONSTRAINT `deals_company_id_foreign` FOREIGN KEY (`company_id`) REFERENCES `companies` (`id`) ON DELETE CASCADE;

-- sqlite
CREATE TABLE "deals" ("id" INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, "company_id" INTEGER NOT NULL, "title" VARCHAR NOT NULL, "amount" NUMERIC NOT NULL, "created_at" DATETIME, "updated_at" DATETIME, "deleted_at" DATETIME, FOREIGN KEY ("company_id") REFERENCES "companies" ("id") ON DELETE CASCADE);
