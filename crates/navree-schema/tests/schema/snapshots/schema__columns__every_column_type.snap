CREATE TABLE `samples` (`country` CHAR(2) NOT NULL, `name` VARCHAR(255) NOT NULL, `code` VARCHAR(16) NOT NULL, `note` TINYTEXT NOT NULL, `body` TEXT NOT NULL, `summary` MEDIUMTEXT NOT NULL, `archive` LONGTEXT NOT NULL, `rank` TINYINT NOT NULL, `score` SMALLINT NOT NULL, `views` MEDIUMINT NOT NULL, `count` INT NOT NULL, `total` BIGINT NOT NULL, `hits` INT UNSIGNED NOT NULL, `ratio` FLOAT(53) NOT NULL, `rough` FLOAT(24) NOT NULL, `weight` DOUBLE NOT NULL, `amount` DECIMAL(12, 2) NOT NULL, `active` TINYINT(1) NOT NULL, `stage` ENUM('lead', 'won', 'lost') NOT NULL, `settings` JSON NOT NULL, `payload` JSON NOT NULL, `born_on` DATE NOT NULL, `starts_at` DATETIME(6) NOT NULL, `ends_at` DATETIME(6) NOT NULL, `opens_at` TIME(6) NOT NULL, `closes_at` TIME(6) NOT NULL, `seen_at` TIMESTAMP(6) NOT NULL, `synced_at` TIMESTAMP(6) NOT NULL, `legacy_at` TIMESTAMP NOT NULL, `database_default_at` TIMESTAMP NOT NULL, `vintage` YEAR NOT NULL, `avatar` BLOB NOT NULL, `digest` BINARY(32) NOT NULL, `token` VARBINARY(64) NOT NULL, `external_id` BINARY(16) NOT NULL, `public_id` CHAR(26) NOT NULL, `ip` VARCHAR(45) NOT NULL, `mac` VARCHAR(17) NOT NULL, `rank_check` SMALLINT CHECK (rank_check > 0) NOT NULL) DEFAULT CHARACTER SET utf8mb4;

-- sqlite
CREATE TABLE "samples" ("country" VARCHAR NOT NULL, "name" VARCHAR NOT NULL, "code" VARCHAR NOT NULL, "note" TEXT NOT NULL, "body" TEXT NOT NULL, "summary" TEXT NOT NULL, "archive" TEXT NOT NULL, "rank" INTEGER NOT NULL, "score" INTEGER NOT NULL, "views" INTEGER NOT NULL, "count" INTEGER NOT NULL, "total" INTEGER NOT NULL, "hits" INTEGER NOT NULL, "ratio" FLOAT NOT NULL, "rough" FLOAT NOT NULL, "weight" DOUBLE NOT NULL, "amount" NUMERIC NOT NULL, "active" TINYINT(1) NOT NULL, "stage" VARCHAR CHECK ("stage" IN ('lead', 'won', 'lost')) NOT NULL, "settings" TEXT NOT NULL, "payload" TEXT NOT NULL, "born_on" DATE NOT NULL, "starts_at" DATETIME NOT NULL, "ends_at" DATETIME NOT NULL, "opens_at" TIME NOT NULL, "closes_at" TIME NOT NULL, "seen_at" DATETIME NOT NULL, "synced_at" DATETIME NOT NULL, "legacy_at" DATETIME NOT NULL, "database_default_at" DATETIME NOT NULL, "vintage" INTEGER NOT NULL, "avatar" BLOB NOT NULL, "digest" BLOB NOT NULL, "token" BLOB NOT NULL, "external_id" VARCHAR NOT NULL, "public_id" VARCHAR NOT NULL, "ip" VARCHAR NOT NULL, "mac" VARCHAR NOT NULL, "rank_check" SMALLINT CHECK (rank_check > 0) NOT NULL);
