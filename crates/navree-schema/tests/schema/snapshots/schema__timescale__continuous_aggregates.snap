-- timescaledb
CREATE MATERIALIZED VIEW "events_daily" WITH (timescaledb.continuous) AS SELECT time_bucket(INTERVAL '1 day', "occurred_at") AS "bucket", "workspace_id", count(*) AS "total", sum(amount) AS "amount" FROM "events" WHERE kind <> 'noise' GROUP BY time_bucket(INTERVAL '1 day', "occurred_at"), "workspace_id" WITH NO DATA;
SELECT add_continuous_aggregate_policy('events_daily', start_offset => INTERVAL '3 days', end_offset => INTERVAL '1 hour', schedule_interval => INTERVAL '1 hour');
CREATE MATERIALIZED VIEW "events_monthly" WITH (timescaledb.continuous, timescaledb.materialized_only = FALSE) AS SELECT time_bucket(INTERVAL '1 month', "occurred_at") AS "month", count(*) AS "total" FROM "events" GROUP BY time_bucket(INTERVAL '1 month', "occurred_at") WITH NO DATA;
CREATE MATERIALIZED VIEW "events_hourly" WITH (timescaledb.continuous) AS SELECT time_bucket(INTERVAL '15 minutes', "occurred_at") AS "slot", max(amount) AS "peak" FROM "events" GROUP BY time_bucket(INTERVAL '15 minutes', "occurred_at") WITH NO DATA;
DROP MATERIALIZED VIEW IF EXISTS "events_hourly";

-- postgres
CREATE VIEW "events_daily" AS SELECT date_bin(INTERVAL '1 day', "occurred_at", '2000-01-03 00:00:00+00') AS "bucket", "workspace_id", count(*) AS "total", sum(amount) AS "amount" FROM "events" WHERE kind <> 'noise' GROUP BY date_bin(INTERVAL '1 day', "occurred_at", '2000-01-03 00:00:00+00'), "workspace_id";
CREATE VIEW "events_monthly" AS SELECT date_trunc('month', "occurred_at") AS "month", count(*) AS "total" FROM "events" GROUP BY date_trunc('month', "occurred_at");
CREATE VIEW "events_hourly" AS SELECT date_bin(INTERVAL '15 minutes', "occurred_at", '2000-01-03 00:00:00+00') AS "slot", max(amount) AS "peak" FROM "events" GROUP BY date_bin(INTERVAL '15 minutes', "occurred_at", '2000-01-03 00:00:00+00');
DROP VIEW IF EXISTS "events_hourly";
