-- mysql
CREATE VIEW `events_daily` AS SELECT FROM_UNIXTIME(FLOOR((UNIX_TIMESTAMP(`occurred_at`) - 946857600) / 86400) * 86400 + 946857600) AS `bucket`, `workspace_id`, count(*) AS `total`, sum(amount) AS `amount` FROM `events` WHERE kind <> 'noise' GROUP BY FROM_UNIXTIME(FLOOR((UNIX_TIMESTAMP(`occurred_at`) - 946857600) / 86400) * 86400 + 946857600), `workspace_id`;
CREATE VIEW `events_monthly` AS SELECT CAST(DATE_FORMAT(`occurred_at`, '%Y-%m-01') AS DATETIME) AS `month`, count(*) AS `total` FROM `events` GROUP BY CAST(DATE_FORMAT(`occurred_at`, '%Y-%m-01') AS DATETIME);
CREATE VIEW `events_hourly` AS SELECT FROM_UNIXTIME(FLOOR((UNIX_TIMESTAMP(`occurred_at`) - 946857600) / 900) * 900 + 946857600) AS `slot`, max(amount) AS `peak` FROM `events` GROUP BY FROM_UNIXTIME(FLOOR((UNIX_TIMESTAMP(`occurred_at`) - 946857600) / 900) * 900 + 946857600);
DROP VIEW IF EXISTS `events_hourly`;
-- notice: MySQL does not support TimescaleDB: continuous aggregate `events_daily` is a plain view, computed when read
-- notice: MySQL does not support TimescaleDB: continuous aggregate `events_monthly` is a plain view, computed when read
-- notice: MySQL does not support TimescaleDB: continuous aggregate `events_hourly` is a plain view, computed when read

