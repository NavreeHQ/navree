-- postgres
CREATE TABLE "memberships" ("workspace_id" UUID NOT NULL, "user_id" UUID NOT NULL, "email" VARCHAR(255) NOT NULL, "role" VARCHAR(255) NOT NULL, "nickname" VARCHAR(255) NULL, "bio" TEXT NULL, "deleted_at" TIMESTAMP WITH TIME ZONE NULL, PRIMARY KEY ("workspace_id", "user_id"));
ALTER TABLE "memberships" ADD CONSTRAINT "memberships_workspace_email" UNIQUE ("workspace_id", "email");
CREATE INDEX "memberships_workspace_id_role_index" ON "memberships" USING BTREE ("workspace_id", "role");
CREATE INDEX "memberships_deleted_at_index" ON "memberships" ("deleted_at") WHERE deleted_at IS NULL;
CREATE INDEX "memberships_email_lower_index" ON "memberships" (lower(email));
ALTER TABLE "memberships" ADD CONSTRAINT "memberships_email_unique" UNIQUE ("email");
CREATE INDEX "memberships_role_index" ON "memberships" ("role");
ALTER TABLE "memberships" ADD CONSTRAINT "memberships_nick" UNIQUE ("nickname");

