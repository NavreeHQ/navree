---
source: crates/navree-schema/tests/schema/create.rs
expression: sql
---
-- postgres
CREATE TABLE "articles" ("id" BIGINT NOT NULL GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, "slug" VARCHAR(255) NOT NULL, "code" VARCHAR(255) NULL, "title" TEXT NOT NULL, "body" TEXT NOT NULL, "location" GEOMETRY NOT NULL);
ALTER TABLE "articles" ADD CONSTRAINT "articles_slug_unique" UNIQUE ("slug") DEFERRABLE INITIALLY DEFERRED;
ALTER TABLE "articles" ADD CONSTRAINT "articles_code_unique" UNIQUE NULLS NOT DISTINCT ("code");
CREATE INDEX CONCURRENTLY "articles_title_index" ON "articles" ("title");
CREATE UNIQUE INDEX CONCURRENTLY "articles_title_unique" ON "articles" ("title");
ALTER TABLE "articles" ADD CONSTRAINT "articles_title_unique" UNIQUE USING INDEX "articles_title_unique";
CREATE INDEX "articles_title_body_fulltext" ON "articles" USING GIN ((to_tsvector('simple', "title") || to_tsvector('simple', "body")));
CREATE INDEX "articles_location_spatialindex" ON "articles" USING GIST ("location");
CREATE INDEX "articles_slug_index" ON "articles" ("slug" text_pattern_ops);
