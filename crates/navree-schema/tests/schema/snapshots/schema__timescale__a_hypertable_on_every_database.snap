-- timescaledb
CREATE TABLE "events" ("id" UUID NOT NULL, "workspace_id" UUID NOT NULL, "kind" VARCHAR(255) NOT NULL, "occurred_at" TIMESTAMP WITH TIME ZONE NOT NULL, "payload" JSONB NOT NULL, PRIMARY KEY ("id", "occurred_at"));
SELECT create_hypertable('events', by_range('occurred_at'));
-- notice: the primary key of `events` is (id, occurred_at), not (id): a hypertable's unique keys must include its time column

