-- postgres
CREATE TABLE "posts" ("id" BIGINT NOT NULL GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, "title" TEXT NOT NULL, "body" TEXT NOT NULL);
CREATE INDEX "posts_title_body_fulltext" ON "posts" USING GIN ((to_tsvector('english', "title") || to_tsvector('english', "body")));

-- mysql
CREATE TABLE `posts` (`id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY, `title` TEXT NOT NULL, `body` TEXT NOT NULL) DEFAULT CHARACTER SET utf8mb4;
ALTER TABLE `posts` ADD FULLTEXT `posts_title_body_fulltext`(`title`, `body`);

