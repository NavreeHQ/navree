-- timescaledb
CREATE TABLE "job_runs" ("id" BIGINT NOT NULL GENERATED BY DEFAULT AS IDENTITY, "job" VARCHAR(255) NOT NULL, "started_at" TIMESTAMP WITH TIME ZONE NOT NULL, PRIMARY KEY ("id", "started_at"));
SELECT create_hypertable('job_runs', by_range('started_at'));
-- notice: the primary key of `job_runs` is (id, started_at), not (id): a hypertable's unique keys must include its time column

-- postgres
CREATE TABLE "job_runs" ("id" BIGINT NOT NULL GENERATED BY DEFAULT AS IDENTITY, "job" VARCHAR(255) NOT NULL, "started_at" TIMESTAMP WITH TIME ZONE NOT NULL, PRIMARY KEY ("id", "started_at"));
CREATE INDEX "job_runs_started_at_index" ON "job_runs" ("started_at" DESC);
-- notice: the primary key of `job_runs` is (id, started_at), not (id): a hypertable's unique keys must include its time column
-- notice: TimescaleDB is not installed in this PostgreSQL database: `job_runs` is a regular table with an index on `started_at`

-- mysql
