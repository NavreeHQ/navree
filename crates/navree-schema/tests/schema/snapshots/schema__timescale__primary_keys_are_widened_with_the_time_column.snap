-- sqlite
CREATE TABLE "job_runs" ("id" INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, "job" VARCHAR NOT NULL, "started_at" DATETIME NOT NULL);
CREATE INDEX "job_runs_started_at_index" ON "job_runs" ("started_at" DESC);
-- notice: SQLite keeps `id` as the primary key of `job_runs` (AUTOINCREMENT needs it alone); TimescaleDB widens it to (id, started_at)
