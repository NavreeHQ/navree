ALTER TABLE `job_runs` ADD INDEX `job_runs_started_at_index`(`started_at` DESC);
-- notice: the primary key of `job_runs` is (id, started_at), not (id): a hypertable's unique keys must include its time column
-- notice: MySQL does not support TimescaleDB: `job_runs` is a regular table with an index on `started_at`

