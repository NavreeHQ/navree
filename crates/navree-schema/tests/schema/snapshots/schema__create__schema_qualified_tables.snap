-- postgres
CREATE TABLE "analytics"."events" ("id" BIGINT NOT NULL GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, "name" VARCHAR(255) NOT NULL);
CREATE INDEX "analytics_events_name_index" ON "analytics"."events" ("name");
DROP INDEX "analytics"."analytics_events_name_index";
ALTER INDEX "analytics"."analytics_events_id_index" RENAME TO "events_id";
ALTER TABLE "analytics"."events" RENAME TO "happenings";
