-- postgres
-- error: PostgreSQL does not support virtual generated columns before version 18 (column `net`, server 17.0.0): use `stored_as`, which PostgreSQL 12 and later support

-- mysql
CREATE TABLE `modifiers` (`id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY, `nickname` VARCHAR(255) NULL, `stage` VARCHAR(255) NOT NULL DEFAULT 'lead', `quote` VARCHAR(255) NOT NULL DEFAULT 'it''s \\ fine', `attempts` INT NOT NULL DEFAULT 0, `budget` BIGINT UNSIGNED NOT NULL DEFAULT 5000000000, `ratio` DOUBLE NOT NULL DEFAULT 1.5, `whole` DOUBLE NOT NULL DEFAULT 2.0, `active` TINYINT(1) NOT NULL DEFAULT 1, `archived` TINYINT(1) NOT NULL DEFAULT 0, `settings` JSON NOT NULL DEFAULT ('{"theme":"dark"}'), `optional` VARCHAR(255) NULL DEFAULT NULL, `created_at` TIMESTAMP(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6), `touched_at` TIMESTAMP(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6), `on` DATE NOT NULL DEFAULT (CURDATE()), `checked_at` DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP, `title` VARCHAR(255) COLLATE 'utf8mb4_bin' NOT NULL COMMENT 'shown in lists', `legacy` VARCHAR(255) CHARACTER SET latin1 NOT NULL, `price` INT NOT NULL, `tax` INT NOT NULL, `gross` INT AS (price + tax) STORED, `net` INT AS (price - tax), `secret` VARCHAR(255) NULL INVISIBLE) DEFAULT CHARACTER SET utf8mb4;
ALTER TABLE `modifiers` AUTO_INCREMENT = 1000;

