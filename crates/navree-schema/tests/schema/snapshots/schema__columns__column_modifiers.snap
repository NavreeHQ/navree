-- sqlite
CREATE TABLE "modifiers" ("id" INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, "nickname" VARCHAR, "stage" VARCHAR NOT NULL DEFAULT 'lead', "quote" VARCHAR NOT NULL DEFAULT 'it''s \ fine', "attempts" INTEGER NOT NULL DEFAULT 0, "budget" INTEGER NOT NULL DEFAULT 5000000000, "ratio" DOUBLE NOT NULL DEFAULT 1.5, "whole" DOUBLE NOT NULL DEFAULT 2.0, "active" TINYINT(1) NOT NULL DEFAULT 1, "archived" TINYINT(1) NOT NULL DEFAULT 0, "settings" TEXT NOT NULL DEFAULT '{"theme":"dark"}', "optional" VARCHAR DEFAULT NULL, "created_at" DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP, "touched_at" DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP, "on" DATE NOT NULL DEFAULT CURRENT_DATE, "checked_at" DATETIME NOT NULL DEFAULT (CURRENT_TIMESTAMP), "title" VARCHAR NOT NULL COLLATE 'utf8mb4_bin', "legacy" VARCHAR NOT NULL, "price" INTEGER NOT NULL, "tax" INTEGER NOT NULL, "gross" INTEGER AS (price + tax) STORED, "net" INTEGER AS (price - tax), "secret" VARCHAR);
