# harbor: node on {{ server.name }}
{% include "provision/prelude.sh" %}
if ! node --version 2> /dev/null | grep -q '^v{{ frontend.node_version }}\.'; then
	harbor_apt install ca-certificates curl gnupg
	install -d -m 0755 /etc/apt/keyrings
	curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --batch --yes --dearmor -o /etc/apt/keyrings/nodesource.gpg
	echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_{{ frontend.node_version }}.x nodistro main" > /etc/apt/sources.list.d/nodesource.list
	apt-get update -q
	harbor_apt install nodejs
fi
{% if frontend.manager != "npm" %}
if ! command -v {{ frontend.manager }} > /dev/null; then
	if command -v corepack > /dev/null; then
		corepack enable
	else
		npm install --global {{ frontend.manager }} > /dev/null
	fi
fi
{% endif %}
