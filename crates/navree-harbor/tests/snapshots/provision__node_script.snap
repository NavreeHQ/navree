---
source: crates/navree-harbor/tests/provision.rs
expression: "step(&steps, \"node\").script"
---
# harbor: node on app-1
export DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1
HARBOR_CHANGED=0
# harbor_file PATH MODE OWNER:GROUP [CHECK]: writes standard input to PATH
# only when it differs; HARBOR_CHANGED says whether it did. CHECK (such as
# `visudo -cqf`) must accept the new file first.
harbor_file() {
	local path="$1" mode="$2" owner="$3" check="${4:-}" tmp
	tmp="$(mktemp)"
	cat > "$tmp"
	if [ -n "$check" ] && ! $check "$tmp" > /dev/null; then
		rm -f "$tmp"
		echo "harbor: the new $path is invalid" >&2
		return 1
	fi
	if [ -f "$path" ] && cmp -s "$tmp" "$path"; then
		rm -f "$tmp"
		HARBOR_CHANGED=0
	else
		install -D -m "$mode" -o "${owner%%:*}" -g "${owner##*:}" "$tmp" "$path"
		rm -f "$tmp"
		HARBOR_CHANGED=1
	fi
	chmod "$mode" "$path"
	chown "$owner" "$path"
}
# harbor_remove PATH: removes PATH; HARBOR_CHANGED says whether it existed.
harbor_remove() {
	if [ -e "$1" ]; then
		rm -f "$1"
		HARBOR_CHANGED=1
	else
		HARBOR_CHANGED=0
	fi
}
harbor_installed() {
	dpkg-query -W -f='${Status}' "$1" 2> /dev/null | grep -q "install ok installed"
}
harbor_apt() {
	apt-get -y -q -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@"
}
if ! node --version 2> /dev/null | grep -q '^v24\.'; then
	harbor_apt install ca-certificates curl gnupg
	install -d -m 0755 /etc/apt/keyrings
	curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --batch --yes --dearmor -o /etc/apt/keyrings/nodesource.gpg
	echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" > /etc/apt/sources.list.d/nodesource.list
	apt-get update -q
	harbor_apt install nodejs
fi
if ! command -v pnpm > /dev/null; then
	if command -v corepack > /dev/null; then
		corepack enable
	else
		npm install --global pnpm > /dev/null
	fi
fi
