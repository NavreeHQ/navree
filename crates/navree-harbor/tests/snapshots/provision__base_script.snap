---
source: crates/navree-harbor/tests/provision.rs
expression: "step(&steps(SINGLE, \"app-1\", &plain(), 1987), \"base\").script"
---
# harbor: base on app-1
export DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1
HARBOR_CHANGED=0
# harbor_file PATH MODE OWNER:GROUP [CHECK]: writes standard input to PATH
# only when it differs; HARBOR_CHANGED says whether it did. CHECK (such as
# `visudo -cqf`) must accept the new file first.
harbor_file() {
	local path="$1" mode="$2" owner="$3" check="${4:-}" tmp
	tmp="$(mktemp)"
	cat > "$tmp"
	if [ -n "$check" ] && ! $check "$tmp" > /dev/null; then
		rm -f "$tmp"
		echo "harbor: the new $path is invalid" >&2
		return 1
	fi
	if [ -f "$path" ] && cmp -s "$tmp" "$path"; then
		rm -f "$tmp"
		HARBOR_CHANGED=0
	else
		install -D -m "$mode" -o "${owner%%:*}" -g "${owner##*:}" "$tmp" "$path"
		rm -f "$tmp"
		HARBOR_CHANGED=1
	fi
	chmod "$mode" "$path"
	chown "$owner" "$path"
}
# harbor_remove PATH: removes PATH; HARBOR_CHANGED says whether it existed.
harbor_remove() {
	if [ -e "$1" ]; then
		rm -f "$1"
		HARBOR_CHANGED=1
	else
		HARBOR_CHANGED=0
	fi
}
harbor_installed() {
	dpkg-query -W -f='${Status}' "$1" 2> /dev/null | grep -q "install ok installed"
}
harbor_apt() {
	apt-get -y -q -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@"
}
apt-get update -q
harbor_apt upgrade
harbor_apt install unattended-upgrades chrony curl ca-certificates gnupg lsb-release
harbor_file /etc/apt/apt.conf.d/20auto-upgrades 0644 root:root <<'HARBOR_EOF'
// Written by navree harbor:provision: security updates install every day.
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
HARBOR_EOF
systemctl enable --now chrony > /dev/null 2>&1 || true
if [ "$(timedatectl show --property=Timezone --value 2> /dev/null || echo unknown)" != UTC ]; then
	timedatectl set-timezone UTC
fi
harbor_file /etc/systemd/journald.conf.d/harbor.conf 0644 root:root <<'HARBOR_EOF'
# Written by navree harbor:provision.
[Journal]
SystemMaxUse=1G
HARBOR_EOF
if [ "$HARBOR_CHANGED" = 1 ]; then
	systemctl restart systemd-journald
fi
if [ ! -f /swapfile ]; then
	fallocate -l 2048M /swapfile
	chmod 600 /swapfile
	mkswap /swapfile > /dev/null
fi
swapon --show=NAME --noheadings | grep -qx /swapfile || swapon /swapfile
grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
if [ -f /var/run/reboot-required ]; then
	echo "reboot_required=yes"
fi
