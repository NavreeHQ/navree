---
source: crates/navree-harbor/tests/cli.rs
expression: "ssh[10].stdin_text()"
---
set -euo pipefail
# harbor: prune on app-1
cd /srv/crm-api
protected=""
for link in current blue green; do
	if [ -L "$link" ]; then
		protected="$protected $(basename "$(readlink "$link")")"
	fi
done
count=0
for id in $(ls -1 releases | grep -v -e '\.partial$' -e '\.tar\.gz$' | sort -r || true); do
	count=$((count + 1))
	if [ "$count" -le 5 ]; then
		continue
	fi
	case " $protected " in *" $id "*) continue ;; esac
	rm -rf "releases/$id"
	echo "removed=$id"
done
