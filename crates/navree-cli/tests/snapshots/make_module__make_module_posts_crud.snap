//! Creates the `posts` table.

use navree::schema::prelude::*;

pub struct Migration;

impl navree::schema::Migration for Migration {
    async fn up(&self, schema: &Schema<'_>) -> SchemaResult {
        schema
            .create("posts", |t| {
                t.uuid_primary();
                t.uuid("owner_id").nullable().index();
                t.string("name");
                t.timestamp_tz("created_at");
                t.timestamp_tz("updated_at");
            })
            .await
    }

    async fn down(&self, schema: &Schema<'_>) -> SchemaResult {
        schema.drop_if_exists("posts").await
    }
}

==> posts/tests/mod.rs <==
//! Tests of the posts module: each one boots the module with a fresh
//! SQLite database and calls its routes in-process.

use navree::access::{
    AbilityCtx, AccessModule, AccessOptions, CREATE, DELETE, READ, Rules, UPDATE, field,
};
use navree::db::DatabaseModule;
use navree::testing::{TestApp, principal};
use serde_json::{Value, json};
use uuid::Uuid;

use super::PostsModule;

/// Test abilities: signed-in users read and create posts, and
/// update or delete their own.
fn abilities(ctx: &AbilityCtx, rules: &mut Rules) {
    ctx.grant_permissions(rules);
    let Some(user) = &ctx.user else {
        return;
    };
    rules.can(READ, "Post");
    rules.can(CREATE, "Post");
    rules
        .can(UPDATE, "Post")
        .when(field("owner_id").eq(user.id));
    rules
        .can(DELETE, "Post")
        .when(field("owner_id").eq(user.id));
}

async fn app() -> TestApp {
    TestApp::builder()
        .temp_database()
        .config("http.per_ip_rate_limit", Value::Null)
        .module(DatabaseModule)
        .module(AccessModule::for_root(AccessOptions {
            abilities,
            super_admin_role: None,
        }))
        .module(PostsModule)
        .build()
        .await
}

#[tokio::test]
async fn guests_must_sign_in() {
    let app = app().await;
    app.client()
        .get("/api/v1/posts")
        .send()
        .await
        .assert_status(401);
}

#[tokio::test]
async fn create_show_update_list_and_delete() {
    let app = app().await;
    let user = app.acting_as(principal(Uuid::now_v7()));

    let created = user
        .post("/api/v1/posts")
        .json(&json!({ "name": "First" }))
        .send()
        .await
        .assert_status(201)
        .json_value();
    let path = format!("/api/v1/posts/{}", created["id"].as_str().unwrap());

    user.get(&path)
        .send()
        .await
        .assert_status(200)
        .assert_json_path("name", json!("First"));
    user.patch(&path)
        .json(&json!({ "name": "Renamed" }))
        .send()
        .await
        .assert_status(200)
        .assert_json_path("name", json!("Renamed"));
    user.get("/api/v1/posts")
        .send()
        .await
        .assert_status(200)
        .assert_json_path("meta.total", json!(1))
        .assert_json_path("data.0.name", json!("Renamed"));
    user.delete(&path).send().await.assert_status(204);
    user.get(&path).send().await.assert_status(404);
}

#[tokio::test]
async fn only_the_owner_may_update_or_delete() {
    let app = app().await;
    let owner = app.acting_as(principal(Uuid::now_v7()));
    let created = owner
        .post("/api/v1/posts")
        .json(&json!({ "name": "Mine" }))
        .send()
        .await
        .assert_status(201)
        .json_value();
    let path = format!("/api/v1/posts/{}", created["id"].as_str().unwrap());

    let other = app.acting_as(principal(Uuid::now_v7()));
    other.get(&path).send().await.assert_status(200);
    other
        .patch(&path)
        .json(&json!({ "name": "Taken" }))
        .send()
        .await
        .assert_status(403);
    other.delete(&path).send().await.assert_status(403);
}

#[tokio::test]
async fn invalid_input_is_rejected() {
    let app = app().await;
    // A 400 JSON error, with the messages under `errors.name`.
    app.acting_as(principal(Uuid::now_v7()))
        .post("/api/v1/posts")
        .json(&json!({ "name": "" }))
        .send()
        .await
        .assert_validation_error("name");
}
