//! Deals in the admin panel (Helm), at `/admin/resources/deals`.

use navree::helm::{Field, Resource};
use navree::injectable;

use super::super::entity as deal;

/// Deals in the panel. What a user sees and changes follows their
/// abilities on `Deal`: grant `deals.read` (and `.create`,
/// `.update`, `.delete`) to the roles that manage them, and `helm.view` to
/// let them into the panel.
#[injectable]
pub struct DealResource;

impl Resource for DealResource {
    type Entity = deal::Entity;

    const LABEL: &'static str = "Deals";
    const SINGULAR: &'static str = "Deal";
    const TITLE: &'static str = "name";
    const SEARCH: &'static [&'static str] = &["name"];

    fn fields(&self) -> Vec<Field> {
        vec![
            Field::id(),
            // Shows the related title with a picker: Field::belongs_to::<OwnerResource>("owner_id")
            Field::text("owner_id").hide_on_index(),
            Field::text("name").required().sortable(),
            Field::datetime("created_at").readonly().sortable(),
            Field::datetime("updated_at").readonly().sortable(),
        ]
    }
}
