==> pages/dashboard.rs <==
//! `GET /dashboard`: the dashboard page of the users module.

use navree::ui::{AppPage, AppShell, Card, Text};
use navree::{controller, injectable};

/// The dashboard page, drawn in the app's shell. Signed-in users only:
/// `#[authenticated]` marks every route of the block below `.authenticated()`.
/// Use `#[public]` (`.public()`) for a page anyone may open.
#[injectable]
pub struct DashboardPage;

#[controller]
#[authenticated]
impl DashboardPage {
    /// `GET /dashboard`. A path that starts with `!` sits at the site's root,
    /// not under `/api`.
    #[get("!/dashboard")]
    async fn show(&self, shell: AppShell) -> AppPage {
        shell
            .page("Dashboard")
            .crumb("Home", "/")
            .body(Card::new().body(Text::new("Replace this card with the page.")))
    }
}

