//! The migrations of the posts module. `navree migrate` runs every
//! module's set in dependency order and each set in name order;
//! `navree make:migration posts <name>` adds one here.

use navree::db::MigrationSet;
use navree::schema::migration;

mod m20261025_143005_create_posts_table;

/// The module's migration set, recorded under `posts` in `navree_migrations`.
pub fn migrations() -> MigrationSet {
    MigrationSet::new("posts")
        .migration(migration!(m20261025_143005_create_posts_table))
}

==> posts/migrations/m20261025_143005_create_posts_table.rs <==
//! Creates the `posts` table.

use navree::schema::prelude::*;

pub struct Migration;

impl navree::schema::Migration for Migration {
    async fn up(&self, schema: &Schema<'_>) -> SchemaResult {
        schema
            .create("posts", |t| {
                t.uuid_primary();
                t.string("name");
                t.timestamp_tz("created_at");
                t.timestamp_tz("updated_at");
            })
            .await
    }

    async fn down(&self, schema: &Schema<'_>) -> SchemaResult {
        schema.drop_if_exists("posts").await
    }
}

==> posts/tests/mod.rs <==
//! Tests of the posts module: each one boots the module with a fresh
//! SQLite database and calls its routes in-process.

use navree::db::DatabaseModule;
use navree::testing::{TestApp, principal};
use serde_json::json;
use uuid::Uuid;

use super::PostsModule;

async fn app() -> TestApp {
    TestApp::builder()
        .temp_database()
        .module(DatabaseModule)
        .module(PostsModule)
        .build()
        .await
}

#[tokio::test]
async fn guests_must_sign_in() {
    let app = app().await;
    app.client()
        .get("/api/v1/posts")
        .send()
        .await
        .assert_status(401);
}

#[tokio::test]
async fn signed_in_users_list_posts() {
    let app = app().await;
    let list = app
        .acting_as(principal(Uuid::now_v7()))
        .get("/api/v1/posts")
        .send()
        .await
        .assert_status(200)
        .json_value();
    assert_eq!(list, json!([]));
}
