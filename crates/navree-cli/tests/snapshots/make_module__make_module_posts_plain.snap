==> posts/mod.rs <==
//! The posts module: the `posts` table, its service and its JSON
//! API under `/api/v1/posts`.
//!
//! ```text
//! posts/
//! ├── mod.rs           # PostsModule: what the module provides and imports
//! ├── controller.rs    # PostController: the HTTP routes
//! ├── service.rs       # PostService: the business logic
//! ├── entity.rs        # the `posts` table (SeaORM entity)
//! ├── dto.rs           # request bodies and their validation rules
//! ├── migrations/      # migrations owned by this module
//! └── tests/           # tests on a fresh database
//! ```

mod controller;
pub mod dto;
pub mod entity;
mod migrations;
mod service;
#[cfg(test)]
mod tests;

use navree::db::ModuleBuilderDbExt;
use navree::kernel::ModuleBuilder;
use navree::module;

pub use controller::PostController;
pub use service::PostService;

/// Posts: the `posts` table, and `/api/v1/posts` for
/// signed-in users.
#[module(
    providers = [PostService],
    controllers = [PostController],
    exports = [PostService],
    register = Self::wire,
)]
pub struct PostsModule;

impl PostsModule {
    /// Registrations `#[module]` has no key for (migrations, jobs,
    /// listeners, commands, templates). `navree make:*` adds its lines above
    /// the `navree:wire` marker.
    fn wire(&self, m: &mut ModuleBuilder) {
        m.migrations(migrations::migrations());
        // navree:wire
    }
}

==> posts/controller.rs <==
//! The posts JSON API: `/api/v1/posts`.

use std::sync::Arc;

use navree::db::Uow;
use navree::http::{Json, Result};
use navree::{controller, injectable};

use super::entity::Model;
use super::service::PostService;

/// The routes of the posts module, for signed-in users.
#[injectable]
pub struct PostController {
    posts: Arc<PostService>,
}

#[controller("/posts", version = "1")]
#[authenticated]
impl PostController {
    /// Lists every post, newest first.
    #[get("/")]
    async fn index(&self, uow: Uow) -> Result<Json<Vec<Model>>> {
        Ok(Json(self.posts.all(&uow).await?))
    }
}

==> posts/service.rs <==
//! The business logic of the posts module.

use navree::db::Uow;
use navree::injectable;
use sea_orm::{DbErr, EntityTrait, QueryOrder};

use super::entity::{Column, Entity, Model};

/// Reads and writes posts. Take the caller's `Uow` so the work
/// joins its transaction.
#[injectable]
pub struct PostService;

impl PostService {
    /// Every post, newest first.
    pub async fn all(&self, uow: &Uow) -> Result<Vec<Model>, DbErr> {
        Entity::find()
            .order_by_desc(Column::CreatedAt)
            .all(&*uow.tx().await?)
            .await
    }
}

==> posts/entity.rs <==
//! The `posts` table.

use sea_orm::entity::prelude::*;
use serde::Serialize;

/// A post. Serialized as is in API responses: keep secrets out
/// of it (or skip them with `#[serde(skip)]`).
#[derive(Clone, Debug, PartialEq, Eq, DeriveEntityModel, Serialize)]
#[sea_orm(table_name = "posts")]
pub struct Model {
    /// A UUID v7, so ids sort by creation time.
    #[sea_orm(primary_key, auto_increment = false)]
    pub id: Uuid,
    pub name: String,
    pub created_at: DateTimeUtc,
    pub updated_at: DateTimeUtc,
}

#[derive(Copy, Clone, Debug, EnumIter, DeriveRelation)]
pub enum Relation {}

impl ActiveModelBehavior for ActiveModel {}

