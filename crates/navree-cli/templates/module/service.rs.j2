use chrono::Utc;
use navree::access::{Accessible, Read};
use navree::db::{Page, PageQuery, Repo, Uow, paginate};
use navree::injectable;
use sea_orm::{ActiveValue::Set, DbErr, EntityTrait, QueryOrder};
use uuid::Uuid;

use super::dto::{Create{{ entity_pascal }}, Update{{ entity_pascal }}};
use super::entity::{ActiveModel, Column, Entity, Model};

/// Lists, creates, updates and deletes {{ module_words }}.
///
/// Writes go through `Repo` inside the caller's unit of work: they commit
/// with the request (or roll back with it) and record change events for the
/// audit log and change observers.
#[injectable]
pub struct {{ entity_pascal }}Service;

impl {{ entity_pascal }}Service {
    /// One page of the {{ module_words }} `scope` lets the user read, newest first.
    pub async fn list(
        &self,
        uow: &Uow,
        scope: Accessible<Entity, Read>,
        page: PageQuery,
    ) -> Result<Page<Model>, DbErr> {
        let select = scope.apply(Entity::find().order_by_desc(Column::CreatedAt));
        paginate(select, &*uow.tx().await?, page).await
    }

    /// Creates {{ a_entity }} owned by the acting user.
    pub async fn create(&self, uow: &Uow, input: Create{{ entity_pascal }}) -> Result<Model, DbErr> {
        let now = Utc::now();
        let {{ entity_var }} = ActiveModel {
            id: Set(Uuid::now_v7()),
            owner_id: Set(uow.actor()),
            name: Set(input.name),
            created_at: Set(now),
            updated_at: Set(now),
        };
        Repo::<Entity>::insert(uow, {{ entity_var }}).await
    }

    /// Applies the fields present in `input`.
    pub async fn update(&self, uow: &Uow, {{ entity_var }}: Model, input: Update{{ entity_pascal }}) -> Result<Model, DbErr> {
        let mut active: ActiveModel = {{ entity_var }}.into();
        if let Some(name) = input.name {
            active.name = Set(name);
        }
        active.updated_at = Set(Utc::now());
        Repo::<Entity>::update(uow, active).await
    }

    /// Deletes `{{ entity_var }}`.
    pub async fn delete(&self, uow: &Uow, {{ entity_var }}: Model) -> Result<(), DbErr> {
        Repo::<Entity>::delete(uow, {{ entity_var }}).await
    }
}
