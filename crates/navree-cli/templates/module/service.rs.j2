#[injectable]
pub struct {{ entity_pascal }}Service;

impl {{ entity_pascal }}Service {
    /// Every {{ entity_words }}, newest first.
    pub async fn all(&self, uow: &Uow) -> Result<Vec<Model>, DbErr> {
        Entity::find()
            .order_by_desc(Column::CreatedAt)
            .all(&*uow.tx().await?)
            .await
    }
