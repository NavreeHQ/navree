/// The routes of the {{ module_words }} resource. Each one checks the
/// caller's abilities on `{{ entity_pascal }}` before the handler runs; routes with
/// `from = "id"` load the record first (404 when it does not exist).
#[injectable]
pub struct {{ entity_pascal }}Controller {
    {{ module }}: Arc<{{ entity_pascal }}Service>,
}

#[controller("/{{ route }}", version = "1")]
impl {{ entity_pascal }}Controller {
    /// Lists the {{ module_words }} the user may read, newest first
    /// (`?page=2&per_page=50`).
    #[get("/")]
    #[can(Read, {{ entity_pascal }})]
    async fn index(
        &self,
        uow: Uow,
        scope: Accessible<{{ entity_pascal }}, Read>,
        page: PageQuery,
    ) -> Result<Page<Model>> {
        Ok(self.{{ module }}.list(&uow, scope, page).await?)
    }

    /// Shows one {{ entity_words }}.
    #[get("/{id}")]
    #[can(Read, {{ entity_pascal }}, from = "id")]
    async fn show(&self, {{ entity_var }}: Authorized<{{ entity_pascal }}, Read>) -> Json<Model> {
        Json({{ entity_var }}.into_inner())
    }

    /// Creates {{ a_entity }} owned by the caller.
    #[post("/")]
    #[can(Create, {{ entity_pascal }})]
    async fn store(
        &self,
        uow: Uow,
        Valid(Json(input)): Valid<Json<Create{{ entity_pascal }}>>,
    ) -> Result<Created<Model>> {
        let {{ entity_var }} = self.{{ module }}.create(&uow, input).await?;
        Ok(Created(format!("/api/v1/{{ route }}/{}", {{ entity_var }}.id), {{ entity_var }}))
    }

    /// Updates the fields present in the body.
    #[patch("/{id}")]
    #[can(Update, {{ entity_pascal }}, from = "id")]
    async fn update(
        &self,
        uow: Uow,
        {{ entity_var }}: Authorized<{{ entity_pascal }}, Update>,
        Valid(Json(input)): Valid<Json<Update{{ entity_pascal }}>>,
    ) -> Result<Json<Model>> {
        {{ entity_var }}.check_fields(&input.changed_fields())?;
        let {{ entity_var }} = self.{{ module }}.update(&uow, {{ entity_var }}.into_inner(), input).await?;
        Ok(Json({{ entity_var }}))
    }

    /// Deletes {{ a_entity }}.
    #[delete("/{id}")]
    #[can(Delete, {{ entity_pascal }}, from = "id")]
    async fn destroy(&self, uow: Uow, {{ entity_var }}: Authorized<{{ entity_pascal }}, Delete>) -> Result<NoContent> {
        self.{{ module }}.delete(&uow, {{ entity_var }}.into_inner()).await?;
        Ok(NoContent)
    }
}
