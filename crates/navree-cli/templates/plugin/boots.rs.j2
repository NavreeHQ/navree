//! Boots `{{ package }}` in [`TestApp`] and checks that `plugins` lists it.

use navree::testing::TestApp;
use {{ crate_name }}::{{ pascal }}Module;

#[tokio::test]
async fn the_plugin_boots_and_is_listed() {
    let app = TestApp::builder()
        .module({{ pascal }}Module::from_config())
        .build()
        .await;
    let report = app.ctx().plugins();
    let plugin = report
        .plugins
        .iter()
        .find(|plugin| plugin.info.name == "{{ package }}")
        .expect("{{ package }} is listed in plugins");
    assert_eq!(plugin.info.namespace, "{{ name }}");
    app.shutdown().await.expect("clean shutdown");
}
