//! The `{{ module_kebab }}:{{ kebab }}` command: `navree {{ module_kebab }}:{{ kebab }} [args...]`.

use navree::kernel::{AppContext, BoxError, CommandSpec};

/// The command, registered by the module's `wire`.
pub fn command() -> CommandSpec {
    CommandSpec::new("{{ module_kebab }}:{{ kebab }}", "{{ title }}", run)
}

/// Runs with the app booted; `args` are the words after the command name.
async fn run(ctx: AppContext, args: Vec<String>) -> Result<(), BoxError> {
    // Resolve services with `ctx.get::<T>().await?`.
    let _ = ctx;
    println!("{{ module_kebab }}:{{ kebab }} {}", args.join(" "));
    Ok(())
}
