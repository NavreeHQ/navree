/// {{ title }}. Inject services as `Arc<T>` fields and call them from the
/// tools. Every tool, resource and prompt needs an access attribute
/// (`#[public]`, `#[authenticated]`, `#[roles]`, `#[permissions]` or
/// `#[can]`), and its doc comment is what the model reads.
#[injectable]
pub struct {{ pascal }}Mcp;

#[mcp_server]
impl {{ pascal }}Mcp {
    /// Sends the text back with the id of the user who called (replace with
    /// a real tool).
    #[mcp_tool(read_only, idempotent)]
    #[authenticated]
    async fn {{ name }}_echo(&self, cx: &McpContext, args: {{ pascal }}EchoArgs) -> Result<Value> {
        Ok(json!({ "text": args.text, "user_id": cx.user_id() }))
