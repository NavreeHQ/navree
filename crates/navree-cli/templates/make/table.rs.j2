/// The table, drawn from `page`. Add `.export(url)`, `.bulk(url, actions)` or
/// `.row_actions(fn)` here.
pub fn {{ table }}_table<'a>(
    query: &'a TableQuery<{{ type_name }}>,
    page: &'a TablePage<{{ type_name }}>,
) -> DataTable<'a, {{ type_name }}> {
    DataTable::new("{{ table }}", query, page)
        .caption("{{ plural_title }}")
        .sticky_header()
        .empty(
            Empty::new("No {{ plural_words }} yet")
                .icon(icons::INBOX)
                .description("{{ plural_title }} you add show here."),
        )
}
