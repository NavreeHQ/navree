/// A row of the table. Each column says what a reader can do with it; the
/// server runs the search, the filters, the sort and the pages.
#[derive(Clone, TableRow)]
#[table(sort = "-created_at", per = 25, per_pages(25, 50, 100))]
pub struct {{ type_name }} {
    /// Not a column: it keys the row and fills the links.
    #[col(skip)]
    pub id: Uuid,
    /// Name
    #[col(sortable, search, sticky, filter = text, link = "/{{ route }}/{id}")]
    pub name: String,
    /// Created
    #[col(sortable, filter = date)]
    pub created_at: DateTime<Utc>,
    // More columns to copy:
    //
    // A badge in a tone chosen by `fn stage_tone(stage: &String) -> BadgeVariant`,
    // with a filter that offers the choices in `STAGES`, a list of
    // `(value, label)` pairs:
    // #[col(filter = multi, options = STAGES, badge = stage_tone)]
    // pub stage: String,
    //
    // An amount in its smallest unit, right-aligned, with a range filter:
    // #[col(sortable, numeric, filter = range, label = "Value (₹)")]
    // pub amount: navree::ui::form::Money,
}
{% if model_path %}

impl From<{{ entity_pascal }}> for {{ type_name }} {
    fn from(model: {{ entity_pascal }}) -> Self {
        Self {
            id: model.id,
            name: model.name,
            created_at: model.created_at,
        }
    }
}

/// `GET /{{ route }}`: one page of rows, with the search, filters, sort and
/// page read from the URL.
pub async fn index(shell: AppShell, uow: Uow, query: TableQuery<{{ type_name }}>) -> Result<AppPage> {
    let page = query
        .load_as({{ entity_pascal }}::query(), &uow, |record| {
            {{ type_name }}::from(record.into_inner())
        })
        .await?;
    Ok(shell
        .page("{{ plural_title }}")
        .crumb("Home", "/")
        .body({{ table }}_table(&query, &page)))
}
