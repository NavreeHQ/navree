{
  "name": "{{ package }}-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
{% if navree_js_dir %}
    "@navree/client": "link:{{ navree_js_dir }}/client",
