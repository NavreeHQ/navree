# Copy to .env.local. Read by this app's server (the backend-for-frontend).

# Where the Navree API listens (`navree dev` in the app root).
NAVREE_API_URL=http://127.0.0.1:8080

# Secure cookies are on in production builds; set to 0 to serve a production
# build over plain http on a host other than localhost.
# NAVREE_COOKIE_SECURE=0

# The public origin(s) when the app sits behind a proxy that rewrites Host.
# APP_ORIGINS=https://{{ package }}.example.com
