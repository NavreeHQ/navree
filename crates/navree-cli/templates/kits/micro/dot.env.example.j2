# Copy to `.env` (never commit `.env`). Each entry fills a key that
# config/app.toml leaves out: APP_<SECTION>__<KEY> is <section>.<key>, e.g.
# APP_DATABASE__URL -> database.url. Real environment variables override both.

# Encrypts data and signs tokens. Generate one with `navree key:generate`.
APP_KEY=

# Verifies the bearer tokens other services forward: the same secret in
# every service (the one that signs them included).
# APP_AUTH__JWT__SECRET=

# The database and the broker come from Dock: `navree dock up` writes
# APP_DATABASE__URL, APP_MICRO__TRANSPORT and APP_MICRO__URL below, between
# the dock markers.
