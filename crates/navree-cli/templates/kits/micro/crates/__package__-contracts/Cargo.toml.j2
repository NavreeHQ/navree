[package]
name = "{{ contracts_package }}"
description = "The messages and events of the {{ package }} service, shared with the services that call it."
version.workspace = true
edition.workspace = true
rust-version.workspace = true
publish.workspace = true

[dependencies]
chrono.workspace = true
# The `Event` trait and `#[derive(Validate)]` for the payloads: a client
# that depends on this crate gets no more of navree than those features
# (and the `http` and `db` features `validation` builds on).
navree = { workspace = true, features = ["events", "validation"] }
serde.workspace = true
uuid.workspace = true
