{% if navree_js_dir %}
import path from "node:path";
{% endif %}
import type { NextConfig } from "next";
{% if navree_js_dir %}

/** The deepest directory that contains both `a` and `b`. */
function commonDirectory(a: string, b: string): string {
  const same = (x: string, y: string) => (process.platform === "win32" ? x.toLowerCase() === y.toLowerCase() : x === y);
  const left = path.resolve(a).split(path.sep);
  const right = path.resolve(b).split(path.sep);
  let length = 0;
  while (length < left.length && length < right.length && same(left[length], right[length])) length++;
  return path.resolve(left.slice(0, length).join(path.sep) + path.sep);
}

/**
 * The Navree packages (`@navree/next`, `@navree/client`, `@navree/bff`) are linked from the checkout
 * this app was made from, which is outside this directory. Next reads files outside the app only
 * below its root, so the root is the directory that holds both the app and the checkout's
 * `packages/js`, and the packages are compiled with the app. See README.md, "The Navree packages".
 */
const root = commonDirectory(process.cwd(), "{{ navree_js_dir }}");
{% endif %}

/**
 * The browser never talks to the Navree API directly. Route handlers under
 * `app/api`, `app/admin`, `app/auth` and `app/broadcasting` are a
 * backend-for-frontend (`@navree/next`, created in `lib/navree.ts`): they keep the JWTs
 * in httpOnly cookies and forward requests to `NAVREE_API_URL` with `Authorization: Bearer`.
 */
const nextConfig: NextConfig = {
  // Every screen loads its data in the browser through TanStack Query.
  cacheComponents: false,
  // Allow the dev server to be opened on 127.0.0.1 as well as localhost.
  allowedDevOrigins: ["127.0.0.1", "localhost"],
{% if navree_js_dir %}
  turbopack: { root },
  outputFileTracingRoot: root,
  transpilePackages: ["@navree/next", "@navree/client", "@navree/bff"],
{% endif %}
};

export default nextConfig;
