            "description": "When the account was created.",
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "description": "The email address.",
            "type": "string"
          },
          "email_verified_at": {
            "description": "When the email address was verified, if it was.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "The id.",
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "description": "The display name.",
            "type": "string"
          }
        },
        "required": [
          "__type",
          "id",
          "name",
          "email",
          "created_at"
        ],
        "type": "object"
      },
      "UserSummary": {
        "description": "A user as member lists show them.",
        "properties": {
          "email": {
            "description": "The email address.",
            "type": "string"
          },
          "id": {
            "description": "The user id.",
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "description": "The display name.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ],
        "type": "object"
      },
      "Vec": {
        "items": {
          "description": "A linked provider account, as `GET /api/auth/social/accounts` lists it.",
          "properties": {
