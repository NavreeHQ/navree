{
  "components": {
    "schemas": {
      "AcceptInvitationInput": {
        "description": "The body of `POST /invitations/accept`.",
        "properties": {
          "token": {
            "description": "The token from the invitation mail.",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "AcceptedInvitationResource": {
        "description": "What `POST /invitations/accept` returns.",
        "properties": {
          "member": {
            "$ref": "#/components/schemas/MemberResource",
            "description": "The new membership."
          },
          "workspace": {
            "$ref": "#/components/schemas/WorkspaceResource",
            "description": "The workspace joined."
          }
        },
        "required": [
          "workspace",
          "member"
        ],
        "type": "object"
      },
      "AccountSession": {
        "description": "A signed-in device or browser: one sign-in, kept alive by its rotating\nrefresh token.",
        "properties": {
          "expires_at": {
            "description": "When it ends unless it is refreshed again.",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The session's id (the refresh-token family).",
            "format": "uuid",
            "type": "string"
          },
          "ip": {
            "description": "The client address it signed in from.",
            "type": [
              "string",
              "null"
            ]
          },
          "last_active_at": {
            "description": "When its tokens were last refreshed.",
            "format": "date-time",
            "type": "string"
          },
          "user_agent": {
            "description": "The client's user agent.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "last_active_at",
          "expires_at"
        ],
        "type": "object"
      },
      "AccountSessionList": {
        "description": "`{data: [AccountSession]}`.",
        "properties": {
          "data": {
            "description": "The sessions, most recently active first.",
            "items": {
              "$ref": "#/components/schemas/AccountSession"
            },
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "AddMemberInput": {
        "description": "The body of `POST /workspaces/{workspace}/members`.",
        "properties": {
          "role": {
            "description": "Their role (default `member`).",
            "type": [
              "string",
              "null"
            ]
          },
          "user_id": {
            "description": "The user to add.",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "type": "object"
      },
      "AuditEntry": {
        "description": "One audit trail entry.",
        "properties": {
          "action": {
            "examples": [
              "deal.updated"
            ],
            "type": "string"
          },
          "actor_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "impersonator_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "data",
              "auth",
              "access",
              "security",
              "custom"
            ],
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object"
          },
          "new_values": {
            "additionalProperties": true,
            "type": [
              "object",
              "null"
            ]
          },
          "old_values": {
            "additionalProperties": true,
            "type": [
              "object",
              "null"
            ]
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "user_agent": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "action",
          "actor_id",
          "impersonator_id",
          "subject_type",
          "subject_id",
          "old_values",
          "new_values",
          "request_id",
          "ip",
          "user_agent",
          "metadata",
          "created_at"
        ],
        "type": "object"
      },
      "AuditPage": {
        "description": "A page of audit entries, newest first.",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            },
            "type": "array"
          },
          "meta": {
            "properties": {
              "current_page": {
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              },
              "last_page": {
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              },
              "per_page": {
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              },
              "total": {
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "current_page",
              "per_page",
              "total",
              "last_page"
            ],
            "type": "object"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "type": "object"
      },
      "AuthMessage": {
        "description": "A response carrying a human-readable message.",
        "properties": {
          "message": {
            "description": "What happened.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "BillingOverview": {
        "description": "`GET /billing`: everything a billing settings page shows.",
        "properties": {
          "plans": {
            "description": "The configured plans.",
            "items": {
              "$ref": "#/components/schemas/PlanResource"
            },
            "type": "array"
          },
          "subscription": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SubscriptionResource",
                "description": "The billable's subscription (see `Billing::subscription`)."
              },
              {
                "type": "null"
              }
            ]
          },
          "trial": {
            "$ref": "#/components/schemas/TrialResource",
            "description": "The trial."
          },
          "usage": {
            "additionalProperties": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            },
            "description": "This period's usage per meter of the current plan.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": [
          "trial",
          "usage",
          "plans"
        ],
        "type": "object"
      },
      "ChangePasswordInput": {
        "description": "`PATCH /auth/me/password`.",
        "properties": {
          "current_password": {
            "description": "The password in use.",
            "format": "password",
            "type": "string"
          },
          "password": {
            "description": "The new password (at least `auth.password_min_length` characters).",
            "format": "password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "password"
        ],
        "type": "object"
      },
      "ChangeRoleInput": {
        "description": "The body of `PATCH /workspaces/{workspace}/members/{user}`.",
        "properties": {
          "role": {
            "description": "The new role.",
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "CheckoutInput": {
        "description": "The body of `POST /billing/checkout`.",
        "properties": {
          "interval": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Interval",
                "description": "`monthly` (default) or `yearly`."
              },
              {
                "type": "null"
              }
            ]
          },
          "plan": {
            "description": "The plan key.",
            "type": "string"
          }
        },
        "required": [
          "plan"
        ],
        "type": "object"
      },
      "CheckoutUrl": {
        "description": "`{ \"url\": \"...\" }`: what a checkout or portal route returns.",
        "properties": {
          "url": {
            "description": "The hosted page to redirect the browser to.",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "ConfirmInput": {
        "description": "`POST /auth/confirm`: the password or a code from the authenticator\napp (exactly one).",
        "properties": {
          "code": {
            "description": "A current code from the authenticator app.",
            "type": [
              "string",
              "null"
            ]
          },
          "password": {
            "description": "The account password.",
            "format": "password",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ConfirmTwoFactorInput": {
        "description": "`POST /auth/2fa/confirm`.",
        "properties": {
          "code": {
            "description": "A current code from the authenticator app.",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "ConfirmedToken": {
        "description": "What `POST /auth/confirm` returns: a new access token for the same\nsession with `auth_time` set to now.",
        "properties": {
          "access_token": {
            "description": "The new access token.",
            "type": "string"
          },
          "auth_time": {
            "description": "When the user confirmed (Unix seconds; the token's `auth_time`).",
            "format": "int64",
            "type": "integer"
          },
          "expires_in": {
            "description": "Its lifetime in seconds.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "token_type": {
            "description": "Always `\"Bearer\"`.",
            "example": "Bearer",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "auth_time"
        ],
        "type": "object"
      },
      "CreateProject": {
        "description": "The body of `POST /api/v1/projects`.",
        "properties": {
          "description": {
            "description": "At most 2000 characters.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "1 to 120 characters.",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus",
            "description": "`active` (the default) or `archived`."
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreateWorkspaceInput": {
        "description": "The body of `POST /workspaces`.",
        "properties": {
          "country": {
            "description": "The ISO 3166-1 alpha-2 country (`IN`).",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The display name.",
            "type": "string"
          },
          "slug": {
            "description": "The slug; derived from the name when absent.",
            "type": [
              "string",
              "null"
            ]
          },
          "timezone": {
            "description": "The IANA time zone (`Asia/Kolkata`); legacy names are stored under\ntheir current names.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "DisableTwoFactorInput": {
        "description": "`POST /auth/2fa/disable`.",
        "properties": {
          "password": {
            "description": "The account password.",
            "format": "password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "ForgotPasswordInput": {
        "description": "`POST /auth/forgot-password`.",
        "properties": {
          "email": {
            "description": "The email address of the account.",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "HttpError": {
        "description": "The JSON error shape every error response carries (`application/json`).",
        "properties": {
          "code": {
            "description": "The machine-readable error code (`not_found`, `validation_failed`, `invalid_credentials`), stable across releases, for front ends to map to a translation key. Left out when `http.errors.code` is false.",
            "examples": [
              "not_found"
            ],
            "type": "string"
          },
          "error": {
            "description": "The reason phrase of the status (`Not Found`, `Bad Request`).",
            "type": "string"
          },
          "errors": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "Validation messages per field (400 validation errors only).",
            "propertyNames": {
              "type": "string"
            },
            "type": [
              "object",
              "null"
            ]
          },
          "message": {
            "description": "What went wrong: one message, or every validation message.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "statusCode": {
            "description": "The HTTP status code.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ],
        "type": "object"
      },
      "Interval": {
        "description": "How often a subscription renews.",
        "enum": [
          "monthly",
          "yearly"
        ],
        "type": "string"
      },
      "InvitationResource": {
        "description": "An invitation as the API returns it (never with its token).",
        "properties": {
          "__type": {
            "description": "Always `WorkspaceInvitation`.",
            "example": "WorkspaceInvitation",
            "type": "string"
          },
          "created_at": {
            "description": "When it was sent.",
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "description": "The invited address.",
            "type": "string"
          },
          "expires_at": {
            "description": "When it expires.",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The id.",
            "format": "uuid",
            "type": "string"
          },
          "invited_by": {
            "description": "Who sent it.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "description": "The role offered.",
            "example": "member",
            "type": "string"
          },
          "workspace_id": {
            "description": "The workspace.",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "__type",
          "id",
          "workspace_id",
          "email",
          "role",
          "expires_at",
          "created_at"
        ],
        "type": "object"
      },
      "InviteInput": {
        "description": "The body of `POST /workspaces/{workspace}/invitations`.",
        "properties": {
          "email": {
            "description": "The address to invite.",
            "type": "string"
          },
          "role": {
            "description": "The role offered (default `member`; never `owner`).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "LinkedAccount": {
        "description": "A linked provider account, as `GET /api/auth/social/accounts` lists it.",
        "properties": {
          "avatar_url": {
            "description": "The avatar URL the provider reported.",
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "description": "The email address the provider reported.",
            "type": [
              "string",
              "null"
            ]
          },
          "linked_at": {
            "description": "When the account was linked.",
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "description": "The name the provider reported.",
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "description": "The provider key (`github`).",
            "type": "string"
          },
          "provider_name": {
            "description": "The provider's display name (`GitHub`, or the configured `name`).",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "provider_name",
          "linked_at"
        ],
        "type": "object"
      },
      "LoginInput": {
        "description": "`POST /auth/login`.",
        "properties": {
          "email": {
            "description": "The email address.",
            "type": "string"
          },
          "password": {
            "description": "The password.",
            "format": "password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "LoginResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TokenPair",
            "description": "The tokens."
          },
          {
            "properties": {
              "user": {
                "$ref": "#/components/schemas/UserResource",
                "description": "The signed-in user."
              }
            },
            "required": [
              "user"
            ],
            "type": "object"
          }
        ],
        "description": "The login and register response: the user and a token pair."
      },
      "LoginResult": {
        "description": "The documented `POST /auth/login` response (OpenAPI `oneOf`): the user\nand tokens, or a [`TwoFactorChallenge`] for accounts with two-factor\nauthentication, so generated clients see both shapes.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/LoginResponse",
            "description": "Signed in. (The handler renders this through [`signed_in`], which\nadds the user resource's extension fields.)"
          },
          {
            "$ref": "#/components/schemas/TwoFactorChallenge",
            "description": "A second factor is needed."
          }
        ]
      },
      "LogoutInput": {
        "description": "`POST /auth/logout` (an optional body).",
        "properties": {
          "all": {
            "description": "End every session of the user.",
            "type": "boolean"
          },
          "refresh_token": {
            "description": "The session to end (its refresh token).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "MemberResource": {
        "description": "A member as the API returns it.",
        "properties": {
          "__type": {
            "description": "Always `WorkspaceMember`.",
            "example": "WorkspaceMember",
            "type": "string"
          },
          "created_at": {
            "description": "When the user joined.",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The membership id.",
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "description": "The role.",
            "example": "member",
            "type": "string"
          },
          "updated_at": {
            "description": "When the membership last changed.",
            "format": "date-time",
            "type": "string"
          },
          "user": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UserSummary",
                "description": "The user's name and email, when the user directory knows them."
              },
              {
                "type": "null"
              }
            ]
          },
          "user_id": {
            "description": "The user.",
            "format": "uuid",
            "type": "string"
          },
          "workspace_id": {
            "description": "The workspace.",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "__type",
          "id",
          "workspace_id",
          "user_id",
          "role",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "Notification": {
        "description": "A notification stored by the database channel.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "data": {
            "additionalProperties": true,
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "read_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "examples": [
              "deal_assigned"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "data",
          "read_at",
          "created_at"
        ],
        "type": "object"
      },
      "NotificationPage": {
        "description": "A page of notifications, newest first.",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Notification"
            },
            "type": "array"
          },
          "meta": {
            "properties": {
              "current_page": {
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              },
              "last_page": {
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              },
              "per_page": {
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              },
              "total": {
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "current_page",
              "per_page",
              "total",
              "last_page"
            ],
            "type": "object"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "type": "object"
      },
      "NotificationSettings": {
        "description": "A member's notification preferences in the current workspace.",
        "properties": {
          "product_updates": {
            "description": "News about the product (default off).",
            "type": "boolean"
          },
          "project_activity": {
            "description": "Mail when a project is created or archived (default on).",
            "type": "boolean"
          },
          "weekly_summary": {
            "description": "A weekly summary of the workspace (default on).",
            "type": "boolean"
          }
        },
        "required": [
          "project_activity",
          "weekly_summary",
          "product_updates"
        ],
        "type": "object"
      },
      "OperationProgress": {
        "description": "How far an operation got.",
        "properties": {
          "done": {
            "description": "Units done.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "note": {
            "description": "What the operation is doing, for people.",
            "type": "string"
          },
          "percent": {
            "description": "`done` as a whole percentage of `total` (0 when `total` is 0).",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "total": {
            "description": "Units in all (0 when unknown).",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "done",
          "total",
          "percent",
          "note"
        ],
        "type": "object"
      },
      "OperationRecord": {
        "description": "A stored operation: what [`Operations`] returns, `GET\n/api/operations/{id}` answers, the SSE stream sends and\n`operation.updated` broadcasts.",
        "properties": {
          "batch_id": {
            "description": "The batch doing its work.",
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "description": "When it was started.",
            "format": "date-time",
            "type": "string"
          },
