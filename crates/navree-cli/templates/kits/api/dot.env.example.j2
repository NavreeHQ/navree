# Copy to `.env` (never commit `.env`). Each entry fills a key that
# config/app.toml leaves out: APP_<SECTION>__<KEY> is <section>.<key>, e.g.
# APP_DATABASE__URL -> database.url. Real environment variables override both.

# Encrypts data and signs tokens. Generate one with `navree key:generate`.
APP_KEY=

# The database and the mail server come from Dock: `navree dock up` writes
# APP_DATABASE__URL and APP_MAIL__TRANSPORT below, between the dock markers.

{% if web %}
# The address the web app (its backend-for-frontend) calls the API from: the
# only peer whose X-Forwarded-For the API believes. config/app.toml trusts
# loopback; set the web app's address (or CIDR block) when it runs elsewhere.
# `navree deploy` sets this to loopback plus deploy.trusted_proxies.
# APP_HTTP__TRUSTED_PROXIES=127.0.0.1,::1

{% endif %}
# Stripe, once billing.provider = "stripe" (config/app.toml):
# APP_BILLING__STRIPE__SECRET_KEY=sk_test_...
# APP_BILLING__STRIPE__WEBHOOK_SECRET=whsec_...

# Social sign-in: each configured provider's secret, e.g.
# APP_SOCIAL__PROVIDERS__GITHUB__CLIENT_SECRET=...
