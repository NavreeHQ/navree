[package]
name = "{{ package }}"
version = "0.1.0"
edition = "2024"
rust-version = "1.95"
publish = false

# The starter kit this app began from (`navree new {{ package }} --kit {{ kit }}`).
# Nothing reads it at run time: it tells you which kit to compare with.
[package.metadata.navree]
kit = "{{ kit }}"
kit_version = "{{ kit_version }}"

[dependencies]
chrono = { version = "0.4", features = ["serde"] }
# The default features (every core module, Helm, workspaces) plus billing,
# social sign-in and the PostgreSQL driver.
navree = {{ navree_dependency }}
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tracing = "0.1"
# `#[derive(ToSchema)]` on the DTOs, for the OpenAPI document.
uuid = { version = "1", features = ["serde", "v7"] }

[dev-dependencies]
# The tests boot the app on a fresh SQLite file each, so they turn the SQLite
# driver on; the app itself compiles only the driver of its own database.
navree = {{ navree_test_dependency }}
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }

# Small debug info: faster links, so `navree dev` restarts sooner.
[profile.dev]
debug = "line-tables-only"

[profile.dev.package."*"]
debug = false

# Password hashing (Argon2id) is unbearably slow unoptimised.
[profile.dev.package.argon2]
opt-level = 3

[profile.dev.package.blake2]
opt-level = 3

# The app is its own workspace; remove this table to make it a member of an
# enclosing one.
[workspace]
