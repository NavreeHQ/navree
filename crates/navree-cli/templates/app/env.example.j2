# Copy to `.env` (never commit `.env`). APP_<SECTION>__<KEY> sets
# <section>.<key>, e.g. APP_MAIL__FROM -> mail.from.
#
# This file holds secrets and values for this machine. It ranks above
# config/app.toml, so a key set here wins over the same key there, and real
# environment variables override both. Set each key in one place:
# config/app.toml sets http.addr, database.url, log.level and mail.transport.

# Encrypts data and signs tokens. Generate one with `navree key:generate`.
APP_KEY=

# The sender of mail. config/app.toml writes messages to the log
# (mail.transport = "log"); see the comment there to send them.
APP_MAIL__FROM="{{ title }} <hello@example.com>"
