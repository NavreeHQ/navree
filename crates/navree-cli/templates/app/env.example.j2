# Copy to `.env` (never commit `.env`). APP_<SECTION>__<KEY> sets
# <section>.<key>, e.g. APP_DATABASE__URL -> database.url. `.env` is read
# before config/app.toml, so a key that file also sets (http.addr, database.url,
# log.level, mail.transport) keeps its config/app.toml value: change it there,
# or with a real environment variable, which overrides both.

# Encrypts data and signs tokens. Generate one with `navree key:generate`.
APP_KEY=

APP_HTTP__ADDR=127.0.0.1:8080
{% if database == "timescaledb" %}
# TimescaleDB, run by `navree dock up` (see dock.toml).
{% elif database == "postgres" %}
# PostgreSQL, run by `navree dock up` (see dock.toml).
{% elif database == "mysql" %}
# MySQL or MariaDB (mariadb://... works too).
{% endif %}
APP_DATABASE__URL={{ database_url }}
APP_LOG__LEVEL=info

# Mail: "log" writes messages to the log; use smtps://user:pass@host:465 to send.
APP_MAIL__TRANSPORT=log
APP_MAIL__FROM="{{ title }} <hello@example.com>"
