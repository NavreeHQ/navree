// How {{ display_name }} is signed, for both apps. As it stands: {% if team %}with the team {{ team }}{% else %}with no team, to run in the simulator and on this Mac{% endif %},
// and with no entitlements, so it offers nothing that needs Apple's
// Developer Program: Sign in with Apple, passkeys and a confirmation with
// one, push, and a sign-in that comes back on a link of the site.
//
// A team turns them on with one file: copy Signing.local.xcconfig.example
// to Signing.local.xcconfig beside this one (it is never committed), fill
// it in, and run `xcodegen generate` again.

NAVREE_BUNDLE_ID = {{ bundle_id }}
DEVELOPMENT_TEAM ={% if team %} {{ team }}{% endif %}

CODE_SIGN_STYLE = Automatic
{% if not team %}
// With no team, the Mac app is signed to run on this Mac only, and keeps no
// session between launches (the Keychain it keeps one in needs a team).
CODE_SIGN_IDENTITY[sdk=macosx*] = -
{% endif %}
CODE_SIGN_ENTITLEMENTS =
// The site the build is associated with (`shop.example`, no scheme).
NAVREE_ASSOCIATED_DOMAIN =
// What the build is signed with, as the app reads it from its Info.plist:
// `associated-domains`, `sign-in-with-apple`, `push`, words apart.
NAVREE_SIGNED_WITH =

#include? "Signing.local.xcconfig"
