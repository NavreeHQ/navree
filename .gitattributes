# Text files are checked out with LF on every platform, so a template renders,
# a generated file compares and a hash of a file holds the same on Windows as
# on Linux (a Windows checkout would otherwise write CRLF). The rules below
# turn that off for the files that are compared byte for byte.
* text=auto eol=lf

# Vendored third-party builds are served byte for byte.
crates/navree-api/assets/* -text
crates/navree-graphql/assets/* -text

# Fuzzing seeds are fed to the parsers byte for byte.
fuzz/seeds/** -text

# PDF fixtures and the text recorded from them are compared byte for byte.
crates/navree-pdf/tests/fixtures/** -text

# Workbook fixtures, and the cells read from them, byte for byte.
crates/navree-sheets/tests/fixtures/workbooks/* -text

# Bodies written by real clients are compared byte for byte.
crates/navree-http/tests/multipart/clients/** -text

# Mail the inbound suites receive as sent, and the certificate the SMTP suites
# trust, are compared byte for byte.
crates/navree-mail/tests/fixtures/inbound/*.eml -text
crates/navree-mail/tests/fixtures/smtp-test-ca.pem -text

# navree-ui's built assets are served byte for byte.
crates/navree-ui/dist/* -text

# Generated by crates/navree-ui/runtime/icons.mjs from pinned releases.
crates/navree-ui/src/icons/lucide.rs linguist-generated=true
crates/navree-ui/src/flags/data.rs linguist-generated=true
apps/ui-docs/data/lucide-tags.json linguist-generated=true
